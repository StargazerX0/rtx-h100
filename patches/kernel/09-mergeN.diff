+ccl_gpu_kernel_postfix
+
+ccl_gpu_kernel_threads(256) ccl_gpu_kernel_signature(nrc_stub_train,
+                                                     const ccl_global unsigned short *in,
+                                                     const ccl_global float *target,
+                                                     const int num)
+{
+  const int i = ccl_gpu_global_id_x();
+  if (i < num) {
+    ccl_gpu_kernel_call(nrc_stub_train(in, target, i));
+  }
+}
+ccl_gpu_kernel_postfix
+
+ccl_gpu_kernel_threads(256) ccl_gpu_kernel_signature(nrc_stub_infer,
+                                                     const ccl_global unsigned short *in,
+                                                     ccl_global float *out,
+                                                     const int num)
+{
+  const int i = ccl_gpu_global_id_x();
+  if (i < num) {
+    ccl_gpu_kernel_call(nrc_stub_infer(in, out, i));
+  }
+}
+ccl_gpu_kernel_postfix
+#endif /* CYCLES_NRC */
