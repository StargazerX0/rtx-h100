+/* -DCYCLES_PERMAT2_STATS: count program runs and failed word checks per shader (pm2_stats[sid * 2 + failed]),
+ * printed by the first thread that finds a failed check. Diagnostic cubins only. */
+#  ifdef CYCLES_PERMAT2_STATS
+__device__ unsigned long long pm2_stats[256 * 2];
+__device__ int pm2_fail_printed;
+#    define PM2_STAT(failed) \
+      do { \
+        const int pm2_sid = sd->shader & SHADER_MASK; \
+        const unsigned long long pm2_old = atomicAdd(&pm2_stats[pm2_sid * 2 + (failed)], 1ull); \
+        if ((failed) && atomicCAS(&pm2_fail_printed, 0, 1) == 0) { \
+          printf("PERMAT2 word check failed: shader %d\n", pm2_sid); \
+        } \
+        if (!(failed) && pm2_old == 0ull) { \
+          printf("PERMAT2 program ran: shader %d\n", pm2_sid); \
+        } \
+      } while (0)
+#  else
+#    define PM2_STAT(failed)
+#  endif
+/* The scene's programs and closure signatures (jobs/gen_permat2.py), one scene per cubin:
+ * -DCYCLES_PERMAT2 -DCYCLES_PERMAT2_SCENE=<monster|junkshop|classroom>. */
+#  define PM2_SCENE_ID_monster 1
+#  define PM2_SCENE_ID_junkshop 2
+#  define PM2_SCENE_ID_classroom 3
+#  define PM2_SCENE_ID2(s) PM2_SCENE_ID_##s
+#  define PM2_SCENE_ID(s) PM2_SCENE_ID2(s)
+#  if PM2_SCENE_ID(CYCLES_PERMAT2_SCENE) == 1
+#    include "kernel/svm/permat2_monster.h"
+#  elif PM2_SCENE_ID(CYCLES_PERMAT2_SCENE) == 2
+#    include "kernel/svm/permat2_junkshop.h"
+#  elif PM2_SCENE_ID(CYCLES_PERMAT2_SCENE) == 3
+#    include "kernel/svm/permat2_classroom.h"
+#  else
+#    error "CYCLES_PERMAT2 needs -DCYCLES_PERMAT2_SCENE=monster|junkshop|classroom"
+#  endif
+/* -DCYCLES_PERMAT2_NO_SIG: the SVM programs only, no closure-loop code. */
+#  ifdef CYCLES_PERMAT2_NO_SIG
+#    undef PM2_SIG_DISPATCH
+#    define PM2_SIG_DISPATCH(sig, CALL)
+#  endif
+
+template<uint64_t node_feature_mask, ShaderType type, typename ConstIntegratorGenericState>
+ccl_device void svm_eval_nodes(KernelGlobals kg,
+                               ConstIntegratorGenericState state,
+                               ccl_private ShaderData *sd,
+                               ccl_global float *render_buffer,
+                               const PathRayVisibility path_visibility,
+                               const uint32_t path_flag)
+{
+  /* Only in the main shade_surface kernel: the programs would also be built into the shadow, raytrace, AO and bake
+   * kernels, which seldom run them. */
+  if constexpr (type == SHADER_TYPE_SURFACE &&
+                node_feature_mask == (KERNEL_FEATURE_NODE_MASK_SURFACE & ~KERNEL_FEATURE_NODE_RAYTRACE))
+  {
+#  ifndef CYCLES_PERMAT2_NO_SVM /* diagnostic: closure loops only */
+    if (pm2_svm_try<node_feature_mask, type>(
+            kg, state, sd, render_buffer, path_visibility, path_flag))
+    {
+      return;
+    }
+#  endif
+  }
+  float stack[SVM_STACK_SIZE];
+  Spectrum closure_weight = zero_spectrum();
+  svm_eval_nodes_loop<node_feature_mask, type>(
+      kg,
+      state,
+      sd,
+      render_buffer,
+      path_visibility,
+      path_flag,
+      stack,
+      closure_weight,
+      (sd->shader & SHADER_MASK) * (1 + sizeof(SVMNodeShaderJump) / sizeof(uint)));
+}
+#endif /* CYCLES_PERMAT2 */
