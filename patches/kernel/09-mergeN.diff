@@ -0,0 +1,695 @@
+/* SPDX-FileCopyrightText: 2011-2022 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* Ours (SVM specialization port, generated by jobs/gen_svm53_dispatch.py from the stock switch in
+ * kernel/svm/svm.h): one entry per node type, SVM_CASE_BEGIN(id) body SVM_CASE_END. `return true` stops the
+ * shader. Only included when CYCLES_SVM_SPECIALIZED is defined; the stock interpreter keeps its own switch. */
+
+SVM_CASE_BEGIN(NODE_END)
+return true;
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_SHADER_JUMP)
+{
+  const SVMNodeShaderJump jump = svm_node_get<SVMNodeShaderJump>(kg, &offset);
+  if (type == SHADER_TYPE_SURFACE) {
+    offset = jump.offset_surface;
+  }
+  else if (type == SHADER_TYPE_VOLUME) {
+    offset = jump.offset_volume;
+  }
+  else if (type == SHADER_TYPE_DISPLACEMENT) {
+    offset = jump.offset_displacement;
+  }
+  else {
+    return true;
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_CLOSURE_BSDF)
+{
+  const ccl_global SVMNodeClosureBsdf &bsdf_node = svm_node_get<SVMNodeClosureBsdf>(kg,
+                                                                                    &offset);
+  offset = svm_node_closure_bsdf<node_feature_mask, type>(
+      kg, sd, stack, closure_weight, bsdf_node, path_visibility, path_flag, offset);
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_CLOSURE_EMISSION)
+{
+  const ccl_global SVMNodeClosureEmission &bsdf_node = svm_node_get<SVMNodeClosureEmission>(
+      kg, &offset);
+  IF_KERNEL_NODES_FEATURE (EMISSION) {
+    svm_node_closure_emission(
+        kg, sd, stack, closure_weight, bsdf_node, path_visibility, path_flag);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_CLOSURE_BACKGROUND)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeClosureBackground>(kg, &offset);
+  IF_KERNEL_NODES_FEATURE (EMISSION) {
+    svm_node_closure_background(sd, stack, closure_weight, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_CLOSURE_SET_WEIGHT)
+svm_node_closure_set_weight(&closure_weight,
+                            svm_node_get<SVMNodeClosureSetWeight>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_CLOSURE_WEIGHT)
+svm_node_closure_weight(
+    stack, &closure_weight, svm_node_get<SVMNodeClosureWeight>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_EMISSION_WEIGHT)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeEmissionWeight>(kg, &offset);
+  IF_KERNEL_NODES_FEATURE (EMISSION) {
+    svm_node_emission_weight(stack, &closure_weight, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_MIX_CLOSURE)
+svm_node_mix_closure(stack, svm_node_get<SVMNodeMixClosure>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_JUMP_IF_ZERO)
+{
+  const SVMNodeJumpIfZero jump = svm_node_get<SVMNodeJumpIfZero>(kg, &offset);
+  if (stack_load_float(stack, jump.stack_offset) <= 0.0f) {
+    offset += jump.jump_offset;
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_JUMP_IF_ONE)
+{
+  const SVMNodeJumpIfOne jump = svm_node_get<SVMNodeJumpIfOne>(kg, &offset);
+  if (stack_load_float(stack, jump.stack_offset) >= 1.0f) {
+    offset += jump.jump_offset;
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_GEOMETRY)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeGeometry>(kg, &offset);
+  APPROX_BUMP_SKIP(node)
+  svm_node_geometry<float3>(kg, sd, stack, node);
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_GEOMETRY_DERIVATIVE)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeGeometry>(kg, &offset);
+  APPROX_BUMP_SKIP(node)
+  IF_NOT_KERNEL_NODES_FEATURE (VOLUME) {
+    svm_node_geometry<dual3>(kg, sd, stack, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_CONVERT)
+svm_node_convert<float, float3>(kg, stack, svm_node_get<SVMNodeConvert>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_CONVERT_DERIVATIVE)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeConvert>(kg, &offset);
+  IF_NOT_KERNEL_NODES_FEATURE (VOLUME) {
+    svm_node_convert<dual1, dual3>(kg, stack, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_TEX_COORD)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeTexCoord>(kg, &offset);
+  APPROX_BUMP_SKIP(node)
+  offset = svm_node_tex_coord(kg, sd, path_visibility, stack, node, offset);
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_TEX_COORD_DERIVATIVE)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeTexCoord>(kg, &offset);
+  APPROX_BUMP_SKIP(node)
+  IF_NOT_KERNEL_NODES_FEATURE (VOLUME) {
+    offset = svm_node_tex_coord_derivative(kg, sd, path_visibility, stack, node, offset);
+  }
+  else {
+    offset = svm_node_tex_coord_skip(node, offset);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_VALUE_F)
+svm_node_value_f<float>(stack, svm_node_get<SVMNodeValueF>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_VALUE_F_DERIVATIVE)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeValueF>(kg, &offset);
+  IF_NOT_KERNEL_NODES_FEATURE (VOLUME) {
+    svm_node_value_f<dual1>(stack, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_VALUE_V)
+svm_node_value_v<float3>(stack, svm_node_get<SVMNodeValueV>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_VALUE_V_DERIVATIVE)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeValueV>(kg, &offset);
+  IF_NOT_KERNEL_NODES_FEATURE (VOLUME) {
+    svm_node_value_v<dual3>(stack, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_ATTR)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeAttr>(kg, &offset);
+  APPROX_BUMP_SKIP(node)
+  IF_KERNEL_NODES_FEATURE (VOLUME) {
+#ifdef __VOLUME__
+    svm_node_attr_volume(kg, sd, stack, node);
+#endif
+  }
+  else {
+    svm_node_attr_surface(kg, sd, stack, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_ATTR_DERIVATIVE)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeAttr>(kg, &offset);
+  APPROX_BUMP_SKIP(node)
+  IF_NOT_KERNEL_NODES_FEATURE (VOLUME) {
+    svm_node_attr_derivative(kg, sd, stack, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_SET_DISPLACEMENT)
+svm_node_set_displacement<node_feature_mask>(
+    sd, stack, svm_node_get<SVMNodeSetDisplacement>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_DISPLACEMENT)
+svm_node_displacement<node_feature_mask>(
+    kg, sd, stack, svm_node_get<SVMNodeDisplacement>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_VECTOR_DISPLACEMENT)
+svm_node_vector_displacement<node_feature_mask>(
+    kg, sd, stack, svm_node_get<SVMNodeVectorDisplacement>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_TEX_IMAGE)
+svm_node_tex_image<float3>(kg, sd, stack, svm_node_get<SVMNodeTexImage>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_TEX_IMAGE_DERIVATIVE)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeTexImage>(kg, &offset);
+  IF_NOT_KERNEL_NODES_FEATURE (VOLUME) {
+    svm_node_tex_image<dual3>(kg, sd, stack, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_TEX_IMAGE_BOX)
+#ifdef CYCLES_APPROX_TEX_INDIRECT
+svm_node_tex_image_box<float3>(
+    kg, sd, stack, svm_node_get<SVMNodeTexImageBox>(kg, &offset), approx_indirect);
+#else
+svm_node_tex_image_box<float3>(kg, sd, stack, svm_node_get<SVMNodeTexImageBox>(kg, &offset));
+#endif
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_TEX_IMAGE_BOX_DERIVATIVE)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeTexImageBox>(kg, &offset);
+  IF_NOT_KERNEL_NODES_FEATURE (VOLUME) {
+#ifdef CYCLES_APPROX_TEX_INDIRECT
+    svm_node_tex_image_box<dual3>(kg, sd, stack, node, approx_indirect);
+#else
+    svm_node_tex_image_box<dual3>(kg, sd, stack, node);
+#endif
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_TEX_NOISE)
+svm_node_tex_noise(stack, svm_node_get<SVMNodeTexNoise>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_SET_BUMP)
+#ifdef CYCLES_APPROX_BUMP_INDIRECT
+if (approx_indirect) {
+  /* Unperturbed input normal, as svm_node_set_bump() with zero height differences. */
+  const ccl_global auto &node = svm_node_get<SVMNodeSetBump>(kg, &offset);
+  IF_KERNEL_NODES_FEATURE (BUMP) {
+    stack_store_float3(
+        stack, node.out_offset, stack_load_float3_default(stack, node.normal_offset, sd->N));
+  }
+  else {
+    stack_store_float3(stack, node.out_offset, zero_float3());
+  }
+  break;
+}
+#endif
+svm_node_set_bump<node_feature_mask>(
+    kg, sd, stack, svm_node_get<SVMNodeSetBump>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_CLOSURE_SET_NORMAL)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeClosureSetNormal>(kg, &offset);
+  IF_KERNEL_NODES_FEATURE (BUMP) {
+    svm_node_set_normal(sd, stack, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_ENTER_BUMP_EVAL)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeEnterBumpEval>(kg, &offset);
+  IF_KERNEL_NODES_FEATURE (BUMP_STATE) {
+    svm_node_enter_bump_eval(kg, sd, stack, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_LEAVE_BUMP_EVAL)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeLeaveBumpEval>(kg, &offset);
+  IF_KERNEL_NODES_FEATURE (BUMP_STATE) {
+    svm_node_leave_bump_eval(sd, stack, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_HSV)
+svm_node_hsv(stack, svm_node_get<SVMNodeHSV>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_CLOSURE_HOLDOUT)
+svm_node_closure_holdout(
+    sd, stack, closure_weight, svm_node_get<SVMNodeClosureHoldout>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_FRESNEL)
+svm_node_fresnel(sd, stack, svm_node_get<SVMNodeFresnel>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_LAYER_WEIGHT)
+svm_node_layer_weight(sd, stack, svm_node_get<SVMNodeLayerWeight>(kg, &offset));
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_CLOSURE_VOLUME)
+{
+  const ccl_global auto &node = svm_node_get<SVMNodeClosureVolume>(kg, &offset);
+  IF_KERNEL_NODES_FEATURE (VOLUME) {
+    svm_node_closure_volume<type>(kg, sd, stack, closure_weight, node);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_VOLUME_COEFFICIENTS)
+{
+  const ccl_global SVMNodeVolumeCoefficients &bsdf_node =
+      svm_node_get<SVMNodeVolumeCoefficients>(kg, &offset);
+  IF_KERNEL_NODES_FEATURE (VOLUME) {
+    svm_node_volume_coefficients<type>(
+        kg, sd, stack, closure_weight, bsdf_node, path_visibility, path_flag);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_PRINCIPLED_VOLUME)
+{
+  const ccl_global SVMNodePrincipledVolume &bsdf_node =
+      svm_node_get<SVMNodePrincipledVolume>(kg, &offset);
+  IF_KERNEL_NODES_FEATURE (VOLUME) {
+    svm_node_principled_volume<type>(
+        kg, sd, stack, closure_weight, bsdf_node, path_visibility, path_flag);
+  }
+}
+SVM_CASE_END
+
+SVM_CASE_BEGIN(NODE_MATH)
+svm_node_math(stack, svm_node_get<SVMNodeMath>(kg, &offset));
+SVM_CASE_END
+
