+/* The fallback of a generated program whose node left an offset other than the next one's (none in practice: the
+ * offsets fold), and the interpreter entry of every shader without a program. */
+template<uint64_t node_feature_mask, ShaderType type, typename ConstIntegratorGenericState>
+ccl_device_noinline void svm_eval_nodes_generic(KernelGlobals kg,
+                                                ConstIntegratorGenericState state,
+                                                ccl_private ShaderData *sd,
+                                                ccl_global float *render_buffer,
+                                                const PathRayVisibility path_visibility,
+                                                const uint32_t path_flag,
+                                                ccl_private float *stack,
+                                                ccl_private Spectrum &closure_weight,
+                                                int offset)
+{
+  svm_eval_nodes_loop<node_feature_mask, type>(
+      kg, state, sd, render_buffer, path_visibility, path_flag, stack, closure_weight, offset);
+}
+
+/* One node of a generated program: the body of that opcode only (dispatch.h, generated from the stock switch by
+ * jobs/gen_svm53_dispatch.py), with the node's words read through SVMStaticReader<PC> as constants. */
+template<uint64_t node_feature_mask,
+         ShaderType type,
+         uint opcode,
+         typename ConstIntegratorGenericState,
+         typename NodeReader>
+ccl_device_forceinline bool svm_eval_node(NodeReader kg,
+                                          ConstIntegratorGenericState state,
+                                          ccl_private ShaderData *sd,
+                                          ccl_global float *render_buffer,
+                                          const PathRayVisibility path_visibility,
+                                          const uint32_t path_flag,
+                                          ccl_private float *stack,
+                                          ccl_private Spectrum &closure_weight,
+                                          const uint node_type,
+                                          ccl_private int &offset,
+                                          const bool approx_indirect)
+{
+  /* Ours (pm2fold, analysis/v53_pm2fold.md): approxH's indirect-bounce options inside a program. approx_indirect is
+   * computed once per program (pm2_approx_indirect). The bump dx/dy skip is decided when the program is generated
+   * (jobs/gen_pm2fold.py), so APPROX_BUMP_SKIP is empty here; a body may `break` (do { } while (false)). */
+  (void)approx_indirect;
+#  pragma push_macro("APPROX_BUMP_SKIP")
+#  undef APPROX_BUMP_SKIP
+#  define APPROX_BUMP_SKIP(node)
+#  define SVM_CASE_BEGIN(id) if constexpr (opcode == id) { do {
+#  define SVM_CASE_END } while (false); }
+#  include "kernel/svm/dispatch.h"
+#  undef SVM_CASE_BEGIN
+#  undef SVM_CASE_END
+#  pragma pop_macro("APPROX_BUMP_SKIP")
+  return false;
+}
+
+/* The approxH indirect flag of svm_eval_nodes (bounce >= 1 in the main surface kernel); false without approxH. */
+template<uint64_t node_feature_mask, ShaderType type, typename ConstIntegratorGenericState>
+ccl_device_forceinline bool pm2_approx_indirect(ConstIntegratorGenericState state)
+{
+#  if defined(CYCLES_APPROX_BUMP_INDIRECT) || defined(CYCLES_APPROX_TEX_INDIRECT)
+  if constexpr (type == SHADER_TYPE_SURFACE && (node_feature_mask & KERNEL_FEATURE_NODE_BSDF) &&
+                (node_feature_mask & KERNEL_FEATURE_NODE_AOV))
+  {
+    return INTEGRATOR_STATE(state, path, bounce) >= 1;
+  }
+#  endif
+  return false;
+}
+
+/* The uploaded svm_nodes hold every word a program folded: one coalesced pass over the table per warp. */
+ccl_device_forceinline bool pm2_verify(KernelGlobals kg,
+                                       const ccl_global uint *idx,
+                                       const ccl_global uint *val,
+                                       const int n)
+{
+  const uint active = __activemask();
+  const uint lane = threadIdx.x & 31;
+  const int rank = __popc(active & ((1u << lane) - 1u));
+  const int count = __popc(active);
+  bool ok = true;
+  for (int i = rank; i < n; i += count) {
+    ok &= (kernel_data_fetch(svm_nodes, __ldg(&idx[i])) == __ldg(&val[i]));
+  }
+  return __all_sync(active, ok);
+}
+
+/* Closure signature: K closures, each of one of the types Ts. */
+template<int K_, ClosureType... Ts> struct PM2Sig {
+  static constexpr int K = K_;
+};
+template<ClosureType... Ts> ccl_device_forceinline bool pm2_type_in(const ClosureType type)
+{
+  return ((type == Ts) || ...);
+}
+template<int K, ClosureType... Ts>
+ccl_device_forceinline bool pm2_sig_match(PM2Sig<K, Ts...> /*sig*/, const ccl_private ShaderData *sd)
+{
+  if (sd->num_closure != K) {
+    return false;
+  }
+  bool ok = true;
+  for (int i = 0; i < K; i++) {
+    ok &= pm2_type_in<Ts...>(sd->closure[i].type);
+  }
+  return ok;
+}
