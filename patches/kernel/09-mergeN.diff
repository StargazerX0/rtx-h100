+/* Program dispatch: true when a verified straight-line program ran. */
+template<uint64_t node_feature_mask, ShaderType type, typename ConstIntegratorGenericState>
+ccl_device_forceinline bool pm2_svm_try(KernelGlobals kg, ConstIntegratorGenericState state, ccl_private ShaderData *sd, ccl_global float *render_buffer, const PathRayVisibility path_visibility, const uint32_t path_flag)
+{
+  switch (sd->shader & SHADER_MASK) {
+    case 32:
+      if (!pm2_verify(kg, pm2_idx_32, pm2_val_32, PM2_WORDS_N_32)) {
+        PM2_STAT(1);
+        return false;
+      }
+      PM2_STAT(0);
+      pm2_svm_32<node_feature_mask, type>(kg, state, sd, render_buffer, path_visibility, path_flag);
+      return true;
+    case 17:
+      if (!pm2_verify(kg, pm2_idx_17, pm2_val_17, PM2_WORDS_N_17)) {
+        PM2_STAT(1);
+        return false;
+      }
+      PM2_STAT(0);
+      pm2_svm_17<node_feature_mask, type>(kg, state, sd, render_buffer, path_visibility, path_flag);
+      return true;
+    case 15:
+      if (!pm2_verify(kg, pm2_idx_15, pm2_val_15, PM2_WORDS_N_15)) {
+        PM2_STAT(1);
+        return false;
+      }
+      PM2_STAT(0);
+      pm2_svm_15<node_feature_mask, type>(kg, state, sd, render_buffer, path_visibility, path_flag);
+      return true;
+    default:
+      return false;
+  }
+}
+
+using PM2Sig_1 = PM2Sig<3, CLOSURE_BSDF_MICROFACET_GGX_ID, CLOSURE_BSSRDF_RANDOM_WALK_LEGACY_ID>;
+/* shader 32 "monster": PM2Sig_1 */
+using PM2Sig_2 = PM2Sig<2, CLOSURE_BSDF_DIFFUSE_ID, CLOSURE_BSDF_MICROFACET_GGX_ID>;
+/* shader 17 "wall": PM2Sig_2 */
+/* shader 15 "Laminate floor": PM2Sig_2 */
+
+/* Closure signature of this shading point: 1..N, or 0 for the stock loops. */
+ccl_device_forceinline int pm2_closure_sig(const ccl_private ShaderData *sd)
+{
+  switch (sd->shader & SHADER_MASK) {
+    case 32:
+      return pm2_sig_match(PM2Sig_1{}, sd) ? 1 : 0;
+    case 17:
+      return pm2_sig_match(PM2Sig_2{}, sd) ? 2 : 0;
+    case 15:
+      return pm2_sig_match(PM2Sig_2{}, sd) ? 2 : 0;
+    default:
+      return 0;
+  }
+}
+
+/* PM2_SIG_DISPATCH(sig, CALL): runs CALL(PM2Sig_n{}) for signature n. */
+#define PM2_SIG_DISPATCH(sig, CALL) \
+  switch (sig) { \
+  case 1: { CALL(PM2Sig_1{}); } break; \
+  case 2: { CALL(PM2Sig_2{}); } break; \
+    default: break; \
+  }
+
