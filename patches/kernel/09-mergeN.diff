+/* Ours: CYCLES_FLATTRI=1 writes flat leaf triangles for cubins built with -DCYCLES_FLATTRI
+ * (kernel/geom/triangle_intersect.h): for each BVH2 primitive address a of type PRIMITIVE_TRIANGLE,
+ * float4 3a, 3a+1, 3a+2 hold tri_verts[position_offset + tri_vindex[prim_index[a]].x/y/z] (w = 0),
+ * exactly the values the stock leaf test loads. They go into the prim_time array (6 float2 per
+ * address), which the kernel reads only for motion blur, so the kernel parameter layout is
+ * unchanged; motion blur and non-BVH2 layouts are refused. Unset: nothing changes. A FLATTRI cubin
+ * without this env reads a null prim_time and faults. */
+static bool flattri_enabled()
+{
+  const char *env = getenv("CYCLES_FLATTRI");
+  return env != nullptr && atoi(env) == 1;
+}
+
+static void device_update_flattri(DeviceScene *dscene, Scene *scene)
+{
+  const auto refuse = [](const string &why) {
+    fprintf(stderr, "CYCLES_FLATTRI: %s\n", why.c_str());
+    fflush(stderr);
+    abort();
+  };
+  if (dscene->data.bvh.bvh_layout != BVH_LAYOUT_BVH2) {
+    refuse("the BVH layout is not BVH2");
+  }
+  bool motion = dscene->data.bvh.have_motion || dscene->data.bvh.use_bvh_steps;
+  for (const Geometry *geom : scene->geometry) {
+    motion = motion || geom->has_motion_blur();
+  }
+  if (motion) {
+    refuse("the scene has motion blur; prim_time is in use (unset CYCLES_FLATTRI)");
+  }
+  const double t0 = time_dt();
+  const size_t num_tris = dscene->tri_vindex.size();
+  const KernelObject *kobjects = dscene->objects.data();
+  /* Position offset of every triangle, from the objects that use its geometry (the kernel reads
+   * objects[object].position_offset; all objects of one geometry must agree). */
+  vector<int> tri_position(num_tris, -1);
+  std::map<const Geometry *, int> geom_position;
+  for (const Object *object : scene->objects) {
+    const Geometry *geom = object->get_geometry();
+    if (geom->geometry_type != Geometry::MESH && geom->geometry_type != Geometry::VOLUME) {
+      continue;
+    }
+    const int po = kobjects[object->index].position_offset;
+    const auto it = geom_position.find(geom);
+    if (it != geom_position.end()) {
+      if (it->second != po) {
+        refuse(string_printf("objects of one mesh disagree on position_offset (%d vs %d)", it->second, po));
+      }
+      continue;
+    }
+    geom_position[geom] = po;
+    const Mesh *mesh = static_cast<const Mesh *>(geom);
+    const size_t n = mesh->num_triangles();
+    if (mesh->prim_offset + n > num_tris) {
+      refuse("triangle range outside tri_vindex");
+    }
+    for (size_t i = 0; i < n; i++) {
+      tri_position[mesh->prim_offset + i] = po;
+    }
+  }
+  const size_t num_prims = dscene->prim_index.size();
+  const int *prim_index = dscene->prim_index.data();
+  const int *prim_type = dscene->prim_type.data();
+  const packed_uint3 *tri_vindex = dscene->tri_vindex.data();
+  const packed_float3 *tri_verts = dscene->tri_verts.data();
+  const size_t num_verts = dscene->tri_verts.size();
+  float2 *dst = dscene->prim_time.alloc(std::max<size_t>(6, 6 * num_prims));
+  float4 *rec = reinterpret_cast<float4 *>(dst);
+  memset(static_cast<void *>(dst), 0, std::max<size_t>(6, 6 * num_prims) * sizeof(float2));
+  size_t num_written = 0;
+  for (size_t a = 0; a < num_prims; a++) {
+    if (prim_type[a] != PRIMITIVE_TRIANGLE) {
+      continue;
+    }
+    const int prim = prim_index[a];
+    if (prim < 0 || size_t(prim) >= num_tris || tri_position[prim] < 0) {
+      refuse(string_printf("primitive address %zu: triangle %d has no position offset", a, prim));
+    }
+    const int po = tri_position[prim];
+    const packed_uint3 vi = tri_vindex[prim];
+    const uint idx[3] = {vi.x, vi.y, vi.z};
