+/* Ours: SVM specialization (port of the 4.5.0 final4 selective specialization). With -DCYCLES_SVM_SPECIALIZED the
+ * kernel includes a scene's generated svm_specialized.h, which runs each supported shader program as straight-line
+ * code. A node of such a program reads its parameters through SVMStaticReader<PC> (PC = the node's offset in
+ * svm_nodes), whose words are compile-time constants, so the node's branches fold away. Node handlers are inlined
+ * there (ccl_device_svm). Without CYCLES_SVM_SPECIALIZED every line below expands to the stock code. */
+#if defined(CYCLES_SVM_SPECIALIZED) || defined(CYCLES_PERMAT2)
+#  define ccl_device_svm ccl_device_forceinline
+
+template<int PC> struct SVMStaticReader {
+  KernelGlobals globals;
+  ccl_device_forceinline operator KernelGlobals() const
+  {
+    return globals;
+  }
+  /* svm_nodes[i] as a constant for the words of node PC; defined in the generated header. */
+  ccl_device_forceinline static uint word(int i);
+};
+
+template<typename T, int PC>
+ccl_device_forceinline T svm_node_get(const SVMStaticReader<PC> /*reader*/,
+                                      ccl_private int *const offset)
+{
+  static_assert(alignof(T) <= alignof(uint));
+  static_assert(sizeof(T) % sizeof(uint) == 0);
+  constexpr int num_words = sizeof(T) / sizeof(uint);
+  uint words[num_words];
+#  ifdef CYCLES_PERMAT2
+  /* Ours (cycles-permat2): unroll fully, so every word folds even for the ~80-word principled BSDF data. */
+#    pragma unroll
+#  endif
+  for (int i = 0; i < num_words; i++) {
+    words[i] = SVMStaticReader<PC>::word(*offset + i);
+  }
+  *offset += num_words;
+  T node;
+  memcpy(&node, words, sizeof(T));
+  return node;
+}
+
+#  define SVM_NODE_READER_TEMPLATE , typename NodeReader
+#  define SVM_NODE_READER NodeReader
+#else
+#  define ccl_device_svm ccl_device_noinline
+#  define SVM_NODE_READER_TEMPLATE
+#  define SVM_NODE_READER KernelGlobals
+#endif
