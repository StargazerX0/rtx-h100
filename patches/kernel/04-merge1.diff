@@ -243,6 +243,137 @@ ccl_device_inline void path_state_next(KernelGlobals kg,
   INTEGRATOR_STATE_WRITE(state, path, rng_offset) += PRNG_BOUNCE_NUM;
 }
 
+#ifdef CYCLES_SH2_BOUNCEPREF
+/* path_state_next with the main-path fields it reads loaded by the caller before its first state
+ * store (path_state_preload), so the loads do not wait behind stores the compiler cannot
+ * disambiguate. Same arithmetic as path_state_next; only the counter the label selects is loaded. */
+struct PathStatePre {
+  uint32_t flag;
+  int bounce;
+  int counter; /* transparent, diffuse, glossy or transmission bounce, as the label selects */
+  uint32_t rng_offset;
+};
+
+ccl_device_forceinline PathStatePre path_state_preload(ConstIntegratorState state, const int label)
+{
+  PathStatePre pre;
+  pre.flag = INTEGRATOR_STATE(state, path, flag);
+  pre.rng_offset = INTEGRATOR_STATE(state, path, rng_offset);
+  pre.bounce = INTEGRATOR_STATE(state, path, bounce);
+  if (label & (LABEL_TRANSPARENT | LABEL_RAY_PORTAL)) {
+    pre.counter = INTEGRATOR_STATE(state, path, transparent_bounce);
+  }
+  else if (label & LABEL_REFLECT) {
+    pre.counter = (label & LABEL_DIFFUSE) ? INTEGRATOR_STATE(state, path, diffuse_bounce) :
+                                            INTEGRATOR_STATE(state, path, glossy_bounce);
+  }
+  else {
+    pre.counter = INTEGRATOR_STATE(state, path, transmission_bounce);
+  }
+  return pre;
+}
+
+ccl_device_inline void path_state_next_pre(KernelGlobals kg,
+                                           IntegratorState state,
+                                           const int label,
+                                           const int runtime_flag,
+                                           const PathStatePre pre)
+{
+  uint32_t flag = pre.flag;
+
+  if (label & (LABEL_TRANSPARENT | LABEL_RAY_PORTAL)) {
+    const int transparent_bounce = pre.counter + 1;
+
+    flag |= PATH_RAY_TRANSPARENT;
+    if (transparent_bounce >= kernel_data.integrator.transparent_max_bounce) {
+      flag |= PATH_RAY_TERMINATE_ON_NEXT_SURFACE;
+    }
+
+    if (runtime_flag & SR_RAY_PORTAL) {
+      flag |= PATH_RAY_MIS_SKIP;
+      INTEGRATOR_STATE_WRITE(
+          state, path, portal_bounce) = INTEGRATOR_STATE(state, path, portal_bounce) + 1;
+    }
+
+    INTEGRATOR_STATE_WRITE(state, path, flag) = flag;
+    INTEGRATOR_STATE_WRITE(state, path, transparent_bounce) = transparent_bounce;
+    INTEGRATOR_STATE_WRITE(state, path, rng_offset) = pre.rng_offset + PRNG_BOUNCE_NUM;
+    return;
+  }
+
+  const int bounce = pre.bounce + 1;
+  if (bounce >= kernel_data.integrator.max_bounce) {
+    flag |= PATH_RAY_TERMINATE_AFTER_TRANSPARENT;
+  }
+
+  PathRayVisibility visibility = PATH_RAY_VISIBILITY_NONE;
+  flag &= ~(PATH_RAY_REFLECT | PATH_RAY_SINGULAR | PATH_RAY_TRANSPARENT |
+            PATH_RAY_IMPORTANCE_BAKE | PATH_RAY_MIS_SKIP | PATH_RAY_MIS_HAD_TRANSMISSION);
+
+  /* Surface reflection/transmission (callers are surface bounces: no volume scatter label). */
+  if (label & LABEL_REFLECT) {
+    flag |= PATH_RAY_REFLECT;
+    flag &= ~PATH_RAY_TRANSPARENT_BACKGROUND;
+
+    if (label & LABEL_DIFFUSE) {
+      const int diffuse_bounce = pre.counter + 1;
+      INTEGRATOR_STATE_WRITE(state, path, diffuse_bounce) = diffuse_bounce;
+      if (diffuse_bounce >= kernel_data.integrator.max_diffuse_bounce) {
+        flag |= PATH_RAY_TERMINATE_AFTER_TRANSPARENT;
+      }
+    }
+    else {
+      const int glossy_bounce = pre.counter + 1;
+      INTEGRATOR_STATE_WRITE(state, path, glossy_bounce) = glossy_bounce;
+      if (glossy_bounce >= kernel_data.integrator.max_glossy_bounce) {
+        flag |= PATH_RAY_TERMINATE_AFTER_TRANSPARENT;
+      }
+    }
+  }
+  else {
+    kernel_assert(label & LABEL_TRANSMIT);
+
+    visibility |= PATH_RAY_VISIBILITY_TRANSMIT;
+
+    if (!(label & LABEL_TRANSMIT_TRANSPARENT)) {
+      flag &= ~PATH_RAY_TRANSPARENT_BACKGROUND;
+    }
+
+    const int transmission_bounce = pre.counter + 1;
+    INTEGRATOR_STATE_WRITE(state, path, transmission_bounce) = transmission_bounce;
+    if (transmission_bounce >= kernel_data.integrator.max_transmission_bounce) {
+      flag |= PATH_RAY_TERMINATE_AFTER_TRANSPARENT;
+    }
+  }
+
+  if (label & LABEL_DIFFUSE) {
+    visibility |= PATH_RAY_VISIBILITY_DIFFUSE;
+    flag |= PATH_RAY_DIFFUSE_ANCESTOR;
+  }
+  else if (label & LABEL_GLOSSY) {
+    visibility |= PATH_RAY_VISIBILITY_GLOSSY;
+  }
+  else {
+    kernel_assert(label & LABEL_SINGULAR);
+    visibility |= PATH_RAY_VISIBILITY_GLOSSY;
+    flag |= PATH_RAY_SINGULAR | PATH_RAY_MIS_SKIP;
+  }
+
+  if (runtime_flag & SR_BSDF_HAS_TRANSMISSION) {
+    flag |= PATH_RAY_MIS_HAD_TRANSMISSION;
+  }
+
+  if (!(flag & PATH_RAY_ANY_PASS) && !(flag & PATH_RAY_TRANSPARENT_BACKGROUND)) {
+    flag |= PATH_RAY_SURFACE_PASS;
+  }
+
+  INTEGRATOR_STATE_WRITE(state, path, visibility) = visibility;
+  INTEGRATOR_STATE_WRITE(state, path, flag) = flag;
+  INTEGRATOR_STATE_WRITE(state, path, bounce) = bounce;
+  INTEGRATOR_STATE_WRITE(state, path, rng_offset) = pre.rng_offset + PRNG_BOUNCE_NUM;
+}
