diff --git a/intern/cycles/kernel/device/gpu/parallel_active_index.h b/intern/cycles/kernel/device/gpu/parallel_active_index.h
index b0eed6d..4297c81 100644
--- a/intern/cycles/kernel/device/gpu/parallel_active_index.h
+++ b/intern/cycles/kernel/device/gpu/parallel_active_index.h
@@ -18,7 +18,85 @@ CCL_NAMESPACE_BEGIN
  * `ccl_gpu_thread_warp`, `ccl_gpu_warp_index`, `ccl_gpu_num_warps` for all devices
  * and keep device specific code in `compat.h`. */
 
-#ifdef __KERNEL_ONEAPI__
+#if defined(CYCLES_BOOK_SCAN) && defined(__KERNEL_CUDA__) && !defined(__HIP__)
+
+/* Ours (CYCLES_BOOK_SCAN=K, CUDA only): each warp tests K * 32 consecutive states in K coalesced chunks of 32,
+ * warp 0 scans the per-warp counts with shuffles, and one atomic per block reserves the block's output range,
+ * so a block covers K * blocksize states and the host launches ceil(num_states / (K * blocksize)) blocks
+ * (host env CYCLES_BOOK_SCAN=1, which reads kernel_book_scan_k below). Indices increase within a block, as in
+ * stock; the set of indices is the same. A launch with the stock grid is also correct (surplus blocks find no
+ * state). Needs sizeof(int) * 32 bytes of the dynamic shared memory the host already passes. */
+#  if CYCLES_BOOK_SCAN < 1 || CYCLES_BOOK_SCAN > 32
+#    error "CYCLES_BOOK_SCAN must be in 1..32"
+#  endif
+extern "C" __device__ int kernel_book_scan_k = CYCLES_BOOK_SCAN;
+
+template<typename IsActiveOp>
+__device__ void gpu_parallel_active_index_array_impl(const uint num_states,
+                                                     ccl_global int *indices,
+                                                     ccl_global int *num_indices,
+                                                     IsActiveOp is_active_op)
+{
+  constexpr int K = CYCLES_BOOK_SCAN;
+  extern ccl_gpu_shared int warp_offset[];
+
+  const uint lane = ccl_gpu_thread_idx_x & 31;
+  const uint warp_index = ccl_gpu_thread_idx_x >> 5;
+  const uint num_warps = ccl_gpu_block_dim_x >> 5;
+  const uint warp_base = (ccl_gpu_block_idx_x * num_warps + warp_index) * uint(K * 32);
+
+  uint mask[K];
+  uint count = 0;
+#  pragma unroll
+  for (int k = 0; k < K; k++) {
+    const uint state_index = warp_base + uint(k * 32) + lane;
+    const uint is_active = (state_index < num_states) ? is_active_op(state_index) : 0;
+    mask[k] = __ballot_sync(0xFFFFFFFF, is_active);
+    count += __popc(mask[k]);
+  }
+
+  if (lane == 0) {
+    warp_offset[warp_index] = count;
+  }
+  __syncthreads();
+
+  if (warp_index == 0) {
+    const uint num = (lane < num_warps) ? warp_offset[lane] : 0;
+    uint inclusive = num;
+#  pragma unroll
+    for (int d = 1; d < 32; d <<= 1) {
+      const uint other = __shfl_up_sync(0xFFFFFFFF, inclusive, d);
+      if (lane >= d) {
+        inclusive += other;
+      }
+    }
+    uint block_offset = 0;
+    if (lane == 31 && inclusive != 0) {
+      block_offset = atomic_fetch_and_add_uint32(num_indices, inclusive);
+    }
+    block_offset = __shfl_sync(0xFFFFFFFF, block_offset, 31);
+    if (lane < num_warps) {
+      warp_offset[lane] = block_offset + inclusive - num;
+    }
+  }
+  __syncthreads();
+
+  uint offset = warp_offset[warp_index];
+  const uint lane_mask_lt = (1u << lane) - 1u;
+#  pragma unroll
+  for (int k = 0; k < K; k++) {
+    if ((mask[k] >> lane) & 1u) {
+      indices[offset + __popc(mask[k] & lane_mask_lt)] = warp_base + uint(k * 32) + lane;
+    }
+    offset += __popc(mask[k]);
+  }
+}
+
+#  define gpu_parallel_active_index_array gpu_parallel_active_index_array_impl
+
+#else /* Stock. */
+
+#  ifdef __KERNEL_ONEAPI__
 
 template<typename IsActiveOp>
 void gpu_parallel_active_index_array_impl(const uint num_states,
@@ -170,4 +248,6 @@ __device__
 
 #endif
 
+#endif /* CYCLES_BOOK_SCAN */
+
 CCL_NAMESPACE_END
diff --git a/intern/cycles/kernel/integrator/path_state.h b/intern/cycles/kernel/integrator/path_state.h
