diff --git a/intern/cycles/kernel/integrator/intersect_dynamic.h b/intern/cycles/kernel/integrator/intersect_dynamic.h
new file mode 100644
index 0000000..5aeb6df
--- /dev/null
+++ b/intern/cycles/kernel/integrator/intersect_dynamic.h
@@ -0,0 +1,278 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Dynamic-fetch (persistent-thread) versions of the intersect_closest and intersect_shadow
+ * kernels, on kernel/bvh/bvh2_dynamic.h. Begin and finish are the code of
+ * integrator_intersect_closest and integrator_intersect_shadow before and after their
+ * scene_intersect* call, unchanged; only the traversal between them runs through the
+ * dynamic-fetch loop, which visits each ray's nodes and primitives in the stock order.
+ *
+ * Launch: the host's normal grid (one thread per path, no host change). Every block runs the
+ * fetch loop, blocks that start after the paths are all taken exit at once, and the last block to
+ * finish zeroes the kernel's counter for its next launch (launches on a queue's stream run one
+ * after another).
+ *
+ * Blender 5.3.0 port: begin and finish copy 5.3.0 integrator_intersect_closest,
+ * integrator_intersect_shadow, integrate_intersect_shadow_opaque/_transparent and the setup of
+ * scene_intersect_shadow_all (BVHShadowAllPayload). */
+
+#include "kernel/bvh/bvh2_dynamic.h"
+
+CCL_NAMESPACE_BEGIN
+
+struct IntersectClosestDFWork {
+  const ccl_global int *path_index_array;
+  ccl_global float *render_buffer;
+
+  ccl_device_forceinline int state(const int index)
+  {
+    return path_index_array ? path_index_array[index] : index;
+  }
+
+  ccl_device_forceinline bool begin(const int state, BVH2DFRay &s, BVH2DFStackEntry *stack)
+  {
+    KernelGlobals kg = nullptr;
+    Ray &ray = s.ray;
+    integrator_state_read_ray(state, &ray);
+    kernel_assert(ray.tmax != 0.0f);
+
+    const uint visibility = path_state_ray_visibility(state);
+    const int last_isect_prim = INTEGRATOR_STATE(state, isect, prim);
+    const int last_isect_object = INTEGRATOR_STATE(state, isect, object);
+
+    /* Trick to use short AO rays to approximate indirect light at the end of the path. */
+    if (path_state_ao_bounce(kg, state)) {
+      ray.tmax = kernel_data.integrator.ao_bounces_distance;
+
+      if (last_isect_object != OBJECT_NONE) {
+        const float object_ao_distance = kernel_data_fetch(objects, last_isect_object).ao_distance;
+        if (object_ao_distance != 0.0f) {
+          ray.tmax = object_ao_distance;
+        }
+      }
+    }
+
+    s.isect.object = OBJECT_NONE;
+    s.isect.prim = PRIM_NONE;
+    ray.self.object = last_isect_object;
+    ray.self.prim = last_isect_prim;
+    ray.self.light_object = OBJECT_NONE;
+    ray.self.light_prim = PRIM_NONE;
+    s.visibility = visibility;
+    s.mode = 0;
+    s.hit = false;
+    /* scene_intersect returns false for an invalid ray without touching isect. */
+    if (!intersection_ray_valid(&ray)) {
+      return false;
+    }
+    bvh2df_begin(kg, s, stack);
+    return true;
+  }
+
+  ccl_device_forceinline void finish(const int state, BVH2DFRay &s)
+  {
+    KernelGlobals kg = nullptr;
+    Ray &ray = s.ray;
+    Intersection &isect = s.isect;
+    bool hit = s.hit;
+    const int last_isect_prim = INTEGRATOR_STATE(state, isect, prim);
+    const int last_isect_object = INTEGRATOR_STATE(state, isect, object);
+
+    /* TODO: remove this and do it in the various intersection functions instead. */
+    if (!hit) {
+      isect.prim = PRIM_NONE;
+    }
+
+    /* Setup mnee flag to signal last intersection with a caster */
+    const PathRayVisibility path_visibility = INTEGRATOR_STATE(state, path, visibility);
+    const uint32_t path_flag = INTEGRATOR_STATE(state, path, flag);
+
+#ifdef __MNEE__
+    /* Path culling logic for MNEE (removes fireflies at the cost of bias) */
+    if (kernel_data.integrator.use_caustics) {
+      bool from_caustic_caster = false;
+      bool from_caustic_receiver = false;
+      if (!(path_visibility & PATH_RAY_VISIBILITY_CAMERA) && last_isect_object != OBJECT_NONE) {
+        const uint object_flags = kernel_data_fetch(object_flag, last_isect_object);
+        from_caustic_receiver = (object_flags & SD_OBJECT_CAUSTICS_RECEIVER);
+        from_caustic_caster = (object_flags & SD_OBJECT_CAUSTICS_CASTER);
+      }
+
+      const bool has_receiver_ancestor = INTEGRATOR_STATE(state, path, mnee) &
+                                         PATH_MNEE_RECEIVER_ANCESTOR;
+      INTEGRATOR_STATE_WRITE(state, path, mnee) &= ~PATH_MNEE_CULL_LIGHT_CONNECTION;
+      if (from_caustic_caster && has_receiver_ancestor) {
+        INTEGRATOR_STATE_WRITE(state, path, mnee) |= PATH_MNEE_CULL_LIGHT_CONNECTION;
+      }
+      if (from_caustic_receiver) {
+        INTEGRATOR_STATE_WRITE(state, path, mnee) |= PATH_MNEE_RECEIVER_ANCESTOR;
+      }
+    }
+#endif /* __MNEE__ */
+
+    /* Light intersection for MIS. */
+    if (kernel_data.integrator.use_light_mis && !integrator_intersect_skip_lights(kg, state)) {
+      const int last_type = INTEGRATOR_STATE(state, isect, type);
+      hit = lights_intersect(kg,
+                             state,
+                             &ray,
+                             &isect,
+                             last_isect_prim,
+                             last_isect_object,
+                             last_type,
+                             path_visibility,
+                             path_flag) ||
+            hit;
+    }
+
+    /* Write intersection result into global integrator state memory. */
+    integrator_state_write_isect(state, &isect);
+
+    /* Setup up next kernel to be executed. */
+    integrator_intersect_next_kernel<DEVICE_KERNEL_INTEGRATOR_INTERSECT_CLOSEST>(
+        kg, state, &isect, render_buffer, hit);
+  }
+};
+
+struct IntersectShadowDFWork {
+  const ccl_global int *path_index_array;
+
+  ccl_device_forceinline int state(const int index)
+  {
+    return path_index_array ? path_index_array[index] : index;
+  }
+
+  ccl_device_forceinline bool begin(const int state, BVH2DFRay &s, BVH2DFStackEntry *stack)
+  {
+    KernelGlobals kg = nullptr;
+    integrator_state_read_shadow_ray(state, &s.ray);
+    integrator_state_read_shadow_ray_self(state, &s.ray);
+    s.visibility = integrate_intersect_shadow_visibility(state);
+    s.hit = false;
+#ifdef __TRANSPARENT_SHADOWS__
+    s.mode = kernel_data.integrator.transparent_shadows ? 1 : 0;
+    if (s.mode) {
+      /* integrate_intersect_shadow_transparent and scene_intersect_shadow_all. The payload is set
+       * before the validity test: an invalid ray leaves it as initialized, with no recorded hits
+       * and throughput one, which is what scene_intersect_shadow_all returns for it. */
+      const uint max_transparent_hits = integrate_shadow_max_transparent_hits(kg, state);
+      s.payload = BVHShadowAllPayload();
+      BVH_PAYLOAD_BASE(s.payload).ray_self = s.ray.self;
+      BVH_PAYLOAD_BASE(s.payload).ray_visibility = s.visibility;
+      s.payload.state = state;
+      s.payload.max_transparent_hits = max_transparent_hits;
+      s.payload.max_record_isect_t = s.ray.tmax;
+    }
+    else
+#else
+    s.mode = 0;
+#endif
+    {
+      /* integrate_intersect_shadow_opaque */
+      constexpr const uint opaque_mask = SHADOW_CATCHER_VISIBILITY_SHIFT(
+                                             PATH_RAY_VISIBILITY_SHADOW_OPAQUE) |
+                                         PATH_RAY_VISIBILITY_SHADOW_OPAQUE;
+      s.visibility &= opaque_mask;
+    }
+    /* scene_intersect_shadow / scene_intersect_shadow_all: an invalid ray hits nothing, with no
+     * recorded hits and throughput one. */
+    if (!intersection_ray_valid(&s.ray)) {
+      return false;
+    }
+    bvh2df_begin(kg, s, stack);
+    return true;
+  }
+
+  ccl_device_forceinline void finish(const int state, BVH2DFRay &s)
+  {
+    bool opaque_hit = s.hit;
+#ifdef __TRANSPARENT_SHADOWS__
+    if (s.mode) {
+      /* Rest of integrate_intersect_shadow_transparent. */
+      const uint num_hits = s.payload.num_recorded_hits;
+      const float3 throughput = s.payload.throughput;
+
+      opaque_hit = is_zero(throughput);
+
+      if (!isequal(throughput, one_float3())) {
+        INTEGRATOR_STATE_WRITE(state, shadow_path, throughput) *= throughput;
+      }
+
+      if (!opaque_hit) {
+        const uint num_recorded_hits = min(num_hits, (uint)INTEGRATOR_SHADOW_ISECT_SIZE);
+
+        if (num_recorded_hits > 0) {
+          sort_shadow_intersections(state, num_recorded_hits);
+        }
+
+        INTEGRATOR_STATE_WRITE(state, shadow_path, packed_num_hits) = num_hits;
+      }
+      else {
+        INTEGRATOR_STATE_WRITE(state, shadow_path, packed_num_hits) = 0;
+      }
+    }
+    else
+#endif
+        if (!opaque_hit)
+    {
+      /* Rest of integrate_intersect_shadow_opaque. */
+      INTEGRATOR_STATE_WRITE(state, shadow_path, packed_num_hits) = 0;
+    }
+
+    if (opaque_hit) {
+      /* Hit an opaque surface, shadow path ends here. */
+      integrator_shadow_path_terminate(state, DEVICE_KERNEL_INTEGRATOR_INTERSECT_SHADOW);
+      return;
+    }
+    integrator_shadow_path_next(
+        state, DEVICE_KERNEL_INTEGRATOR_INTERSECT_SHADOW, DEVICE_KERNEL_INTEGRATOR_SHADE_SHADOW);
+  }
+};
+
+/* Per kernel: [0] the fetch counter, [1] blocks finished in the current launch. */
+extern "C" __device__ uint bvh2df_closest_counters[2];
+extern "C" __device__ uint bvh2df_shadow_counters[2];
+__device__ uint bvh2df_closest_counters[2] = {0, 0};
+__device__ uint bvh2df_shadow_counters[2] = {0, 0};
+
+ccl_device_forceinline void bvh2df_block_done(uint *counters)
+{
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    __threadfence();
+    if (atomicAdd(&counters[1], 1u) == gridDim.x - 1) {
+      counters[0] = 0;
+      counters[1] = 0;
+      __threadfence();
+    }
+  }
+}
+
+ccl_device_forceinline void integrator_intersect_closest_df(const ccl_global int *path_index_array,
+                                                            ccl_global float *render_buffer,
+                                                            const int work_size)
+{
+  IntersectClosestDFWork work{path_index_array, render_buffer};
+  bvh2df_run<0>(work, &bvh2df_closest_counters[0], work_size);
+  bvh2df_block_done(bvh2df_closest_counters);
+}
+
+ccl_device_forceinline void integrator_intersect_shadow_df(const ccl_global int *path_index_array,
+                                                           const int work_size)
+{
+  IntersectShadowDFWork work{path_index_array};
+#ifdef __TRANSPARENT_SHADOWS__
+  /* Uniform for the launch: one loop per leaf type. */
+  if (kernel_data.integrator.transparent_shadows) {
+    bvh2df_run<1>(work, &bvh2df_shadow_counters[0], work_size);
+  }
+  else
+#endif
+  {
+    bvh2df_run<0>(work, &bvh2df_shadow_counters[0], work_size);
+  }
+  bvh2df_block_done(bvh2df_shadow_counters);
+}
+
+CCL_NAMESPACE_END
