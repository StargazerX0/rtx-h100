--- /dev/null
+++ b/intern/cycles/kernel/svm/approx.h
@@ -0,0 +1,236 @@
+/* SPDX-FileCopyrightText: 2026 cycles-h100
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* Approximate options for indirect bounces (tree53-approx, analysis/v53_approx_kernel.md).
+ *
+ * CYCLES_APPROX_BUMP_INDIRECT: at bounce >= 1, Bump nodes output their unperturbed input normal,
+ * and the SVM program skips the dx and dy copies of the Bump height graph.
+ *
+ * Why a run-time skip can find them: ShaderGraph::refine_bump_nodes() (and bump_from_displacement)
+ * copies the height graph twice, and every copy feeds only its Bump input (SampleX / SampleY).
+ * SVMCompiler::generate_svm_nodes() emits nodes depth-first from the sinks, so each copy is one
+ * contiguous run of nodes that ends with its root, and the dx run is followed directly by the dy
+ * run (equal Sethi-Ullman keys, dx copies have the lower ids). The two runs have the same node
+ * types in the same order; only the bump offsets of their Geometry / Texture Coordinate /
+ * Attribute / Wireframe nodes differ (DX in one, DY in the other).
+ *
+ * At the first DX-tagged node p, svm_approx_bump_skip() decodes forward to the first DY-tagged
+ * node q (n = q - p words), checks that [q, q + n) repeats [p, q) node by node (same type, same
+ * size, DX <-> DY, all other tags equal), and returns q + n. On any mismatch or an unknown node
+ * type it returns a negative value and the program runs as stock. The skipped nodes only feed
+ * the Bump node's dx/dy inputs, which a Bump node at bounce >= 1 ignores. */
+
+#pragma once
+
+#include "kernel/globals.h"
+#include "kernel/svm/node_types.h"
+#include "kernel/svm/types.h"
+#include "kernel/svm/util.h"
+
+CCL_NAMESPACE_BEGIN
+
+#ifdef CYCLES_APPROX_BUMP_INDIRECT
+
+/* End offset of the node that starts at `start` (its type word), or -1 for a node type the scan
+ * does not decode (closures, jumps, bump nodes, raycast, sky, AOV, ...). *tag is the node's bump
+ * offset for nodes that have one, else -1. */
+ccl_device_inline int svm_approx_node_end(KernelGlobals kg, const int start, ccl_private int *tag)
+{
+  const uint node_type = kernel_data_fetch(svm_nodes, start);
+  const int data = start + 1;
+  *tag = -1;
+  switch (node_type) {
