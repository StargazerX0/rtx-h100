+/* p: start of a DX-tagged node. Returns the offset after the dy run (> 0) when the dx and dy runs
+ * are found and match, else -(offset before which no new attempt should be made). */
+ccl_device_noinline int svm_approx_bump_skip(KernelGlobals kg, const int p)
+{
+  /* Pass 1: find the first DY-tagged node q. */
+  int q = p;
+  int tag;
+  while (true) {
+    const int e = svm_approx_node_end(kg, q, &tag);
+    if (e < 0) {
+      return -q;
+    }
+    if (tag == NODE_BUMP_OFFSET_DY) {
+      break;
+    }
+    q = e;
+    if (q - p > CYCLES_APPROX_BUMP_MAX_WORDS) {
+      return -q;
+    }
+  }
+  /* Pass 2: [q, q + (q - p)) must repeat [p, q) node by node. */
+  int x = p;
+  int y = q;
+  while (x < q) {
+    int tx;
+    int ty;
+    if (kernel_data_fetch(svm_nodes, x) != kernel_data_fetch(svm_nodes, y)) {
+      return -q;
+    }
+    const int ex = svm_approx_node_end(kg, x, &tx);
+    const int ey = svm_approx_node_end(kg, y, &ty);
+    if (ex < 0 || ey < 0 || ex - x != ey - y) {
+      return -q;
+    }
+    if (tx == NODE_BUMP_OFFSET_DY || (tx == NODE_BUMP_OFFSET_DX) != (ty == NODE_BUMP_OFFSET_DY) ||
+        (tx != NODE_BUMP_OFFSET_DX && tx != ty))
+    {
+      return -q;
+    }
+    x = ex;
+    y = ey;
+  }
+  return (x == q) ? y : -q;
+}
