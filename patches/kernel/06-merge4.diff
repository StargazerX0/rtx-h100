@@ -0,0 +1,534 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Variant inner loops for the dynamic-fetch (DF) closest and shadow kernels (bvh2_dynamic.h):
+ * a BVH4 side structure, DPX slab max/min and cull-on-pop. Port of replay53-bvh4/wide_df.h, the
+ * code the H100 replay (E62, results/replay53-bvh4-w3168) timed and checked. Leaves, instance
+ * push/pop, the integrator Work types and the fetch loop are the bvh2_dynamic.h ones; only the
+ * inner-node loop, the stack entry and the pop change. Every other kernel (local, volume, SSS)
+ * keeps the BVH2 arrays.
+ *
+ * Compile flags (each kernel picks its own; nothing changes without them):
+ *   CYCLES_BVH4_CLOSEST        intersect_closest traverses the BVH4 (cull-on-pop)
+ *   CYCLES_BVH4_CLOSEST_DPX    ... with the DPX slab test (bvh4_dpx; without: bvh4_f)
+ *   CYCLES_BVH4_SHADOW         intersect_shadow traverses the BVH4 (cull-on-pop in the opaque loop)
+ *   CYCLES_BVH4_SHADOW_DPX     ... with the DPX slab test
+ *   CYCLES_BVH2_SHADOW_DPX     intersect_shadow stays BVH2, DPX slab test (bvh2_dpx)
+ *   CYCLES_BVH2_SHADOW_CULL    intersect_shadow stays BVH2, cull-on-pop in the opaque loop (bvh2_cull)
+ * They need the bhotB DF knobs (STEP=1, STACK=1, POLICY=1, DEFER=1, SPLITSTACK=1, FETCH=0, CHUNK=0).
+ *
+ * BVH4 layout (built on the host from the packed BVH2, bvh4int/bvh4_collapse.h; uploaded only when
+ * CYCLES_BVH4=1 and the cubin defines cycles_bvh4): node i is 8 float4 at nodes[8i]:
+ *   [0..5] lo_x hi_x lo_y hi_y lo_z hi_z of the 4 children, [6] child refs, [7] child visibility.
+ * A child ref is a BVH4 node index (>= 0, < BVH4_BVH2_TAG), a BVH2 leaf address (< 0, into
+ * bvh_leaf_nodes, as in the BVH2), or BVH4_BVH2_TAG + a BVH2 inner-node address: the subtree under
+ * an unaligned (hair) BVH2 node, which stays BVH2 and is traversed with bvh_node_intersect. Empty
+ * slots have lo = +inf, hi = -inf and visibility 0. Every box is the BVH2 box of the same subtree,
+ * and the FMA slab test is the BVH2 one, so a child box passes whenever BVH2 would reach it at the
+ * same tmax: the visited leaves are the same, only their order differs.
+ *
+ * DPX: the 4-way max/min of the slab test as __vimax3_s32/__vimin3_s32 on the float bits. It
+ * equals the float max/min whenever the box is hit (tmin >= 0 is an operand of the max, a hit needs
+ * every far distance >= tmin >= 0), so the same boxes pass. sm_90 has DPX in hardware; older GPUs
+ * emulate it (slow, same results).
+ *
+ * Cull (closest-hit and opaque-shadow loops, Mode 0): stack entries carry the child's entry
+ * distance; a pop drops entries farther than the current hit, which the BVH2 box test would also
+ * reject at that tmax. The transparent-shadow loop (Mode 1) keeps int entries: its bound is the
+ * constant ray.tmax. */
+
+#if CYCLES_BVH2DF_STEP != 1 || CYCLES_BVH2DF_STACK != 1 || CYCLES_BVH2DF_POLICY != 1 || \
+    !CYCLES_BVH2DF_DEFER || !CYCLES_BVH2DF_SPLITSTACK || CYCLES_BVH2DF_FETCH != 0 || \
+    CYCLES_BVH2DF_CHUNK != 0
+#  error "bvh_wide_dynamic.h needs the bhotB DF knobs (STEP=1 STACK=1 POLICY=1 DEFER=1 SPLITSTACK=1)"
+#endif
+#if defined(CYCLES_BVH4_CLOSEST) && !defined(CYCLES_BVH2DF_CLOSEST)
+#  error "CYCLES_BVH4_CLOSEST needs CYCLES_BVH2DF_CLOSEST"
+#endif
+#if (defined(CYCLES_BVH4_SHADOW) || defined(CYCLES_BVH2_SHADOW_DPX) || \
+     defined(CYCLES_BVH2_SHADOW_CULL)) && \
+    !defined(CYCLES_BVH2DF_SHADOW)
+#  error "the shadow variants need CYCLES_BVH2DF_SHADOW"
+#endif
+#if defined(CYCLES_BVH4_SHADOW) && (defined(CYCLES_BVH2_SHADOW_DPX) || defined(CYCLES_BVH2_SHADOW_CULL))
+#  error "CYCLES_BVH4_SHADOW and CYCLES_BVH2_SHADOW_* exclude each other"
+#endif
+
+/* Per-kernel configuration: width, DPX, cull. */
+#ifdef CYCLES_BVH4_CLOSEST
+#  define WDF_CLOSEST 1
+#  define WDF_CLOSEST_W 4
+#  ifdef CYCLES_BVH4_CLOSEST_DPX
+#    define WDF_CLOSEST_DPX true
+#  else
+#    define WDF_CLOSEST_DPX false
+#  endif
+#endif
+#if defined(CYCLES_BVH4_SHADOW)
+#  define WDF_SHADOW 1
+#  define WDF_SHADOW_W 4
+#  define WDF_SHADOW_CULL true
+#  ifdef CYCLES_BVH4_SHADOW_DPX
+#    define WDF_SHADOW_DPX true
+#  else
+#    define WDF_SHADOW_DPX false
+#  endif
+#elif defined(CYCLES_BVH2_SHADOW_DPX) || defined(CYCLES_BVH2_SHADOW_CULL)
+#  define WDF_SHADOW 1
+#  define WDF_SHADOW_W 2
+#  ifdef CYCLES_BVH2_SHADOW_DPX
+#    define WDF_SHADOW_DPX true
+#  else
+#    define WDF_SHADOW_DPX false
+#  endif
+#  ifdef CYCLES_BVH2_SHADOW_CULL
+#    define WDF_SHADOW_CULL true
+#  else
+#    define WDF_SHADOW_CULL false
+#  endif
+#endif
+
+CCL_NAMESPACE_BEGIN
+
+#if defined(CYCLES_BVH4_CLOSEST) || defined(CYCLES_BVH4_SHADOW)
+#  define WDF_HAS_BVH4 1
+/* The BVH4 side structure. The host looks this symbol up: its presence means the cubin needs
+ * CYCLES_BVH4=1 (device/cuda/device_impl.cpp); offsets 0, 8, 16 (const_copy_to "bvh4_nodes",
+ * "bvh4_object_root", "bvh4_root"). */
+struct KernelBVH4 {
+  const float4 *nodes;
+  const int *object_root;
+  int root;
+  int pad;
+};
+extern "C" __constant__ KernelBVH4 cycles_bvh4;
+__constant__ KernelBVH4 cycles_bvh4;
+#endif
+
+#define BVH4_BVH2_TAG 0x40000000
+
+/* Stack entry: int (address) or int2 (address, entry distance) for cull. */
+template<bool Cull> struct WdfEntrySel {
+  using T = int;
+};
+template<> struct WdfEntrySel<true> {
+  using T = int2;
+};
+
+ccl_device_forceinline void wdf_set(int &e, const int a, const float /*d*/)
+{
+  e = a;
+}
+ccl_device_forceinline void wdf_set(int2 &e, const int a, const float d)
+{
+  e = make_int2(a, __float_as_int(d));
+}
+template<class E>
+ccl_device_forceinline void wdf_push(BVH2DFRay &s, E *stack, const int a, const float d)
+{
+  ++s.stack_ptr;
+  kernel_assert(s.stack_ptr < BVH_STACK_SIZE);
+  wdf_set(stack[s.stack_ptr], a, d);
+}
+ccl_device_forceinline void wdf_pop(BVH2DFRay &s, int *stack)
+{
+  s.node_addr = stack[s.stack_ptr];
+  --s.stack_ptr;
+}
+ccl_device_forceinline void wdf_pop(BVH2DFRay &s, int2 *stack)
+{
+  /* Entries farther than the current hit are stale; sentinels carry -inf and always stop. */
+  const float t = s.isect.t;
+  int2 e;
+  do {
+    e = stack[s.stack_ptr];
+    --s.stack_ptr;
+  } while (__int_as_float(e.y) > t);
+  s.node_addr = e.x;
+}
+
+/* bvh2df_begin with the variant's entry type and root. */
+template<int W, class E> ccl_device_forceinline void wdf_begin(BVH2DFRay &s, E *stack)
+{
+  wdf_set(stack[0], ENTRYPOINT_SENTINEL, -INFINITY);
+  s.stack_ptr = 0;
+#ifdef WDF_HAS_BVH4
+  s.node_addr = (W == 4) ? cycles_bvh4.root : kernel_data.bvh.root;
+#else
+  s.node_addr = kernel_data.bvh.root;
+#endif
+  s.P = s.ray.P;
+  s.dir = bvh_clamp_direction(s.ray.D);
+  s.idir = bvh_inverse_direction(s.dir);
+  s.object = OBJECT_NONE;
+  s.isect.t = s.ray.tmax;
+  s.isect.u = 0.0f;
+  s.isect.v = 0.0f;
+  s.isect.prim = PRIM_NONE;
+  s.isect.object = OBJECT_NONE;
+  s.hit = false;
+}
+
+ccl_device_forceinline float wdf_max4i(const float a, const float b, const float c, const float lo)
+{
+  return __int_as_float(__vimax3_s32(
+      __float_as_int(a), __float_as_int(b), max(__float_as_int(c), __float_as_int(lo))));
+}
+ccl_device_forceinline float wdf_min4i(const float a, const float b, const float c, const float hi)
+{
+  return __int_as_float(__vimin3_s32(
+      __float_as_int(a), __float_as_int(b), min(__float_as_int(c), __float_as_int(hi))));
+}
+
+/* nodes.h bvh_aligned_node_intersect (CYCLES_BVH_FMA form) with the DPX 4-way max/min. */
+ccl_device_forceinline int wdf2_aligned_dpx(const float4 cnodes,
+                                            const float3 P,
+                                            const float3 idir,
+                                            const float tmin,
+                                            const float tmax,
+                                            const int node_addr,
+                                            const uint visibility,
+                                            float dist[2])
+{
+  const float4 node0 = kernel_data_fetch(bvh_nodes, node_addr + 1);
+  const float4 node1 = kernel_data_fetch(bvh_nodes, node_addr + 2);
+  const float4 node2 = kernel_data_fetch(bvh_nodes, node_addr + 3);
+  const float pidx = P.x * idir.x, pidy = P.y * idir.y, pidz = P.z * idir.z;
+  const float c0lox = fmaf(node0.x, idir.x, -pidx), c0hix = fmaf(node0.z, idir.x, -pidx);
+  const float c0loy = fmaf(node1.x, idir.y, -pidy), c0hiy = fmaf(node1.z, idir.y, -pidy);
+  const float c0loz = fmaf(node2.x, idir.z, -pidz), c0hiz = fmaf(node2.z, idir.z, -pidz);
+  const float c0min = wdf_max4i(
+      fminf(c0lox, c0hix), fminf(c0loy, c0hiy), fminf(c0loz, c0hiz), tmin);
+  const float c0max = wdf_min4i(
+      fmaxf(c0lox, c0hix), fmaxf(c0loy, c0hiy), fmaxf(c0loz, c0hiz), tmax);
+  const float c1lox = fmaf(node0.y, idir.x, -pidx), c1hix = fmaf(node0.w, idir.x, -pidx);
+  const float c1loy = fmaf(node1.y, idir.y, -pidy), c1hiy = fmaf(node1.w, idir.y, -pidy);
+  const float c1loz = fmaf(node2.y, idir.z, -pidz), c1hiz = fmaf(node2.w, idir.z, -pidz);
+  const float c1min = wdf_max4i(
+      fminf(c1lox, c1hix), fminf(c1loy, c1hiy), fminf(c1loz, c1hiz), tmin);
+  const float c1max = wdf_min4i(
+      fmaxf(c1lox, c1hix), fmaxf(c1loy, c1hiy), fmaxf(c1loz, c1hiz), tmax);
+  dist[0] = c0min;
+  dist[1] = c1min;
+#ifdef __VISIBILITY_FLAG__
+  return (((c0max >= c0min) && (__float_as_uint(cnodes.x) & visibility)) ? 1 : 0) |
+         (((c1max >= c1min) && (__float_as_uint(cnodes.y) & visibility)) ? 2 : 0);
+#else
+  return ((c0max >= c0min) ? 1 : 0) | ((c1max >= c1min) ? 2 : 0);
+#endif
+}
+
+/* One BVH2 inner node at addr: bvh2df_node with the variant's slab test and stack. Child inner
+ * addresses get + tag (BVH4_BVH2_TAG inside a BVH4 traversal, 0 in a BVH2 one). */
+template<bool Dpx, class E>
+ccl_device_forceinline void wdf2_node(
+    BVH2DFRay &s, E *stack, const float tmax, const int addr, const int tag)
+{
+  const float4 cnodes = kernel_data_fetch(bvh_nodes, addr + 0);
+  float dist[2];
+  int mask;
+  if constexpr (Dpx) {
+#ifdef __HAIR__
+    if (kernel_data.bvh.have_curves &&
+        (__float_as_uint(cnodes.x) & PATH_RAY_VISIBILITY_NODE_UNALIGNED))
+    {
+      mask = bvh_unaligned_node_intersect(
+          nullptr, s.P, s.dir, s.ray.tmin, tmax, addr, s.visibility, dist);
+    }
+    else
+#endif
+    {
+      mask = wdf2_aligned_dpx(cnodes, s.P, s.idir, s.ray.tmin, tmax, addr, s.visibility, dist);
+    }
+  }
+  else {
+    /* bvh2df_node's test. */
+#ifdef __HAIR__
+    mask = kernel_data.bvh.have_curves ?
+               bvh_node_intersect(
+                   nullptr, s.P, s.dir, s.idir, s.ray.tmin, tmax, addr, s.visibility, dist) :
+               bvh_aligned_node_intersect(
+                   nullptr, s.P, s.idir, s.ray.tmin, tmax, addr, s.visibility, dist);
+#else
+    mask = bvh_aligned_node_intersect(
+        nullptr, s.P, s.idir, s.ray.tmin, tmax, addr, s.visibility, dist);
+#endif
+  }
+  int child0 = __float_as_int(cnodes.z);
+  int child1 = __float_as_int(cnodes.w);
+  if (tag) {
+    child0 = (child0 >= 0) ? child0 + tag : child0;
+    child1 = (child1 >= 0) ? child1 + tag : child1;
+  }
+  if (mask == 3) {
+    float dfar = dist[1];
+    if (dist[1] < dist[0]) {
+      const int tmp = child0;
+      child0 = child1;
+      child1 = tmp;
+      dfar = dist[0];
+    }
+    wdf_push(s, stack, child1, dfar);
+    s.node_addr = child0;
+  }
+  else if (mask == 2) {
+    s.node_addr = child1;
+  }
+  else if (mask == 1) {
+    s.node_addr = child0;
+  }
+  else {
+    wdf_pop(s, stack);
+  }
+}
+
+#ifdef WDF_HAS_BVH4
+ccl_device_forceinline unsigned long long wdf_pin64(const unsigned long long x)
+{
+  unsigned long long y;
+  asm volatile("mov.b64 %0, %1;" : "=l"(y) : "l"(x));
+  return y;
+}
+
+/* All inner nodes (BVH4, and tagged BVH2 under unaligned nodes) down to the next leaf or
+ * sentinel. */
+template<bool Dpx, class E>
+ccl_device_forceinline void wdf4_inner(BVH2DFRay &s, E *stack, const float tmax)
+{
+  const float3 idir = s.idir;
+  const float tmin = s.ray.tmin;
+  const uint vis = s.visibility;
+  const float pidx = s.P.x * idir.x, pidy = s.P.y * idir.y, pidz = s.P.z * idir.z;
+  /* Per ray: the address of each axis's near-plane vector in node 0, from the ray octant (lo at
+   * +0, hi at +16 within the axis's 32-byte pair). The far plane is near ^ 16: bit 4 never
+   * carries. Pinned so the compiler keeps them instead of recomputing them per node. */
+  const unsigned long long base = reinterpret_cast<unsigned long long>(cycles_bvh4.nodes);
+  const unsigned long long bx = wdf_pin64(base + (idir.x >= 0.0f ? 0u : 16u));
+  const unsigned long long by = wdf_pin64(base + (idir.y >= 0.0f ? 32u : 48u));
+  const unsigned long long bz = wdf_pin64(base + (idir.z >= 0.0f ? 64u : 80u));
+  while (s.node_addr >= 0 && s.node_addr != ENTRYPOINT_SENTINEL) {
+#  ifdef CYCLES_BVH2DF_COUNT
+    s.count_nodes++;
+#  endif
+#  ifdef __HAIR__
+    if (s.node_addr >= BVH4_BVH2_TAG) {
+      /* Subtree under an unaligned BVH2 node: BVH2 traversal, children stay tagged. */
+      wdf2_node<Dpx>(s, stack, tmax, s.node_addr - BVH4_BVH2_TAG, BVH4_BVH2_TAG);
+      continue;
+    }
+#  endif
+    const unsigned long long o = (unsigned long long)(unsigned)s.node_addr * 128u;
+    const unsigned long long ax = bx + o, ay = by + o, az = bz + o;
+    const float4 NX = *reinterpret_cast<const float4 *>(ax);
+    const float4 FX = *reinterpret_cast<const float4 *>(ax ^ 16u);
+    const float4 NY = *reinterpret_cast<const float4 *>(ay);
+    const float4 FY = *reinterpret_cast<const float4 *>(ay ^ 16u);
+    const float4 NZ = *reinterpret_cast<const float4 *>(az);
+    const float4 FZ = *reinterpret_cast<const float4 *>(az ^ 16u);
+    const char *nb = reinterpret_cast<const char *>(base + o);
+    const int4 ch = *reinterpret_cast<const int4 *>(nb + 96);
+#  ifdef __VISIBILITY_FLAG__
+    const uint4 vs = *reinterpret_cast<const uint4 *>(nb + 112);
+    const uint vv[4] = {vs.x, vs.y, vs.z, vs.w};
+#  endif
+    const float nxv[4] = {NX.x, NX.y, NX.z, NX.w}, fxv[4] = {FX.x, FX.y, FX.z, FX.w};
+    const float nyv[4] = {NY.x, NY.y, NY.z, NY.w}, fyv[4] = {FY.x, FY.y, FY.z, FY.w};
+    const float nzv[4] = {NZ.x, NZ.y, NZ.z, NZ.w}, fzv[4] = {FZ.x, FZ.y, FZ.z, FZ.w};
+    float d[4];
+    int a[4] = {ch.x, ch.y, ch.z, ch.w};
+#  pragma unroll
+    for (int j = 0; j < 4; j++) {
+      const float tnx = fmaf(nxv[j], idir.x, -pidx), tny = fmaf(nyv[j], idir.y, -pidy),
+                  tnz = fmaf(nzv[j], idir.z, -pidz);
+      const float tfx = fmaf(fxv[j], idir.x, -pidx), tfy = fmaf(fyv[j], idir.y, -pidy),
+                  tfz = fmaf(fzv[j], idir.z, -pidz);
+      float tn, tf;
+      if constexpr (Dpx) {
+        tn = wdf_max4i(tnx, tny, tnz, tmin);
+        tf = wdf_min4i(tfx, tfy, tfz, tmax);
+      }
+      else {
+        tn = fmaxf(fmaxf(tmin, tnx), fmaxf(tny, tnz));
+        tf = fminf(fminf(tmax, tfx), fminf(tfy, tfz));
+      }
+#  ifdef __VISIBILITY_FLAG__
+      d[j] = (tn <= tf && (vv[j] & vis)) ? tn : INFINITY;
+#  else
+      d[j] = (tn <= tf) ? tn : INFINITY;
+#  endif
+    }
+#  define WDF_CS(x, y) \
+    { \
+      const bool sw = d[y] < d[x]; \
+      const float td = sw ? d[y] : d[x]; \
+      d[y] = sw ? d[x] : d[y]; \
+      d[x] = td; \
+      const int ta = sw ? a[y] : a[x]; \
+      a[y] = sw ? a[x] : a[y]; \
+      a[x] = ta; \
+    }
+    WDF_CS(0, 1) WDF_CS(2, 3) WDF_CS(0, 2) WDF_CS(1, 3) WDF_CS(1, 2)
+#  undef WDF_CS
+#  pragma unroll
+    for (int j = 3; j >= 1; j--) {
+      if (d[j] != INFINITY) {
+        wdf_push(s, stack, a[j], d[j]);
+      }
+    }
+    if (d[0] != INFINITY) {
+      s.node_addr = a[0];
+    }
+    else {
+      wdf_pop(s, stack);
+    }
+  }
+}
+#endif
+
+/* bvh2df_step (STEP=1) with the variant's inner loop and stack. */
+template<int Mode, int W, bool Dpx, class E>
+ccl_device_forceinline bool wdf_step(BVH2DFRay &s, E *stack)
+{
+  constexpr bool record_all = (Mode == 1);
+  const float node_tmax = record_all ? s.ray.tmax : s.isect.t;
+#ifdef WDF_HAS_BVH4
+  if constexpr (W == 4) {
+    wdf4_inner<Dpx>(s, stack, node_tmax);
+  }
+  else
+#endif
+  {
+    while (s.node_addr >= 0 && s.node_addr != ENTRYPOINT_SENTINEL) {
+#ifdef CYCLES_BVH2DF_COUNT
+      s.count_nodes++;
+#endif
+      wdf2_node<Dpx>(s, stack, node_tmax, s.node_addr, 0);
+    }
+  }
+  if (s.node_addr < 0) {
+    const float4 leaf = kernel_data_fetch(bvh_leaf_nodes, (-s.node_addr - 1));
+    const int prim_addr = __float_as_int(leaf.x);
+    if (prim_addr >= 0) {
+      const int prim_addr2 = __float_as_int(leaf.y);
+      const uint type = __float_as_int(leaf.w);
+#ifdef CYCLES_BVH2DF_COUNT
+      s.count_leaves++;
+      s.count_prims += prim_addr2 - prim_addr;
+#endif
+      wdf_pop(s, stack);
+#ifdef __TRANSPARENT_SHADOWS__
+      const bool stop = record_all ?
+                            bvh2df_leaf_shadow_all(nullptr, s, prim_addr, prim_addr2, type) :
+                            bvh2df_leaf_closest(nullptr, s, prim_addr, prim_addr2, type);
+#else
+      const bool stop = bvh2df_leaf_closest(nullptr, s, prim_addr, prim_addr2, type);
+#endif
+      if (stop) {
+        s.hit = true;
+        return true;
+      }
+    }
+    else {
+      /* bvh2df_instance_push with the variant's object root. */
+      s.object = kernel_data_fetch(prim_object, -prim_addr - 1);
+#ifdef __OBJECT_MOTION__
+      if (kernel_data.bvh.have_motion) {
+        bvh_instance_motion_push(nullptr, s.object, &s.ray, &s.P, &s.dir, &s.idir);
+      }
+      else {
+        bvh_instance_push(nullptr, s.object, &s.ray, &s.P, &s.dir, &s.idir);
+      }
+#else
+      bvh_instance_push(nullptr, s.object, &s.ray, &s.P, &s.dir, &s.idir);
+#endif
+      wdf_push(s, stack, ENTRYPOINT_SENTINEL, -INFINITY);
+#ifdef WDF_HAS_BVH4
+      s.node_addr = (W == 4) ? cycles_bvh4.object_root[s.object] :
