+/* bvh2df_run at the bhotB knobs (FETCH=0, CHUNK=0, POLICY=1, DEFER=1, SPLITSTACK=1) with
+ * wdf_step. Work::begin takes the variant's stack (template) and calls wdf_begin<W>. */
+template<int Mode, int W, bool Dpx, bool Cull, class Work>
+ccl_device_forceinline void wdf_run(Work &work, uint *counter, const int work_size)
+{
+  using E = typename WdfEntrySel<Cull && Mode == 0>::T;
+  BVH2DFRay s;
+  E stack[BVH_STACK_SIZE];
+  const uint lane = threadIdx.x & 31;
+  const uint warp_mask = __activemask();
+  bool active = false;
+  bool exhausted = false;
+  bool pending = false;
+  int state = 0;
+  while (true) {
+    if (pending) {
+      work.finish(state, s);
+      pending = false;
+    }
+    const bool idle = !active && !exhausted;
+    const uint fetch_mask = __ballot_sync(warp_mask, idle);
+    if (fetch_mask) {
+      const int leader = __ffs(fetch_mask) - 1;
+      uint base = 0;
+      if (lane == leader) {
+        base = atomicAdd(counter, uint(__popc(fetch_mask)));
+      }
+      base = __shfl_sync(warp_mask, base, leader);
+      if (idle) {
+        const uint next = base + __popc(fetch_mask & ((1u << lane) - 1));
+        exhausted = next >= uint(work_size);
+        if (!exhausted) {
+          state = work.state(int(next));
+          active = work.begin(state, s, stack);
+          if (!active) {
+            work.finish(state, s);
+          }
+        }
+      }
+    }
+    if (!__any_sync(warp_mask, active)) {
+      if (__all_sync(warp_mask, exhausted)) {
+        return;
+      }
+      continue;
+    }
+    while (true) {
+      if (active) {
+        if (wdf_step<Mode, W, Dpx>(s, stack)) {
+          pending = true;
+          active = false;
+        }
+      }
+      const uint live = __ballot_sync(warp_mask, active);
+      if (!live) {
+        break;
+      }
+      /* Refill only while rays remain; once the counter is exhausted keep stepping. */
+      if (__popc(live) < CYCLES_BVH2DF_MINLIVE && !__all_sync(warp_mask, exhausted || active)) {
+        break;
+      }
+    }
+  }
+}
