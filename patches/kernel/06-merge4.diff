+      s.object = OBJECT_NONE;
+      wdf_pop(s, stack);
+    }
+    if (s.node_addr == ENTRYPOINT_SENTINEL) {
+      s.hit = record_all ? false : (s.isect.prim != PRIM_NONE);
+      return true;
+    }
+  }
+  return false;
