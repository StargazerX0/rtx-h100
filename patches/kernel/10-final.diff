+    const ccl_global KernelLight *klight = &kernel_data_fetch(lights, ls.prim);
+    eval *= rgb_to_spectrum(
+        make_float3(klight->strength[0], klight->strength[1], klight->strength[2]));
+  }
+
+  return is_constant;
+}
