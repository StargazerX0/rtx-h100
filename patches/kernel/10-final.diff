+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#ifdef CYCLES_SSS_LOCAL_FIX
+
+/* Lean, exact single-hit local BVH traversal for subsurface random walk (CYCLES_SSS_LOCAL_FIX).
+ *
+ * Fixes and optimizations over stock kernel/bvh/local.h (all exact for single-hit SSS walk rays,
+ * where lcg_state == nullptr, max_hits == 1, tmin == 0, and Ng is unused):
+ *   1. Tightens isect_t on every closer hit (stock local.h passes isect_t by value to
+ *      triangle_intersect_local, so tmax never shrinks during traversal).
+ *   2. Cull-on-pop stack (CYCLES_SSS_LOCAL_CULL=1, default): skips stacked nodes whose entry
+ *      distance exceeds the tightened isect_t.
+ *   3. Drops dead Ng (cross + normalize) and LocalIntersection[4] array; writes one Intersection.
+ *   4. Uses bvh_aligned_node_intersect directly when !__HAIR__ (or !have_curves), eliminating
+ *      bvh_unaligned_node_intersect bloat and per-node unaligned flag checks.
+ *   5. Hoists object_node, object_flag, position_offset once per walk, and skips the wasted
+ *      world-space bvh_clamp_direction / bvh_inverse_direction before bvh_instance_push.
+ *   6. Optional H100 DPX 4-way slab min/max (CYCLES_SSS_LOCAL_DPX; exact for tmin >= 0).
+ *   7. Optional 4-wide BVH4 local traversal (CYCLES_SSS_LOCAL_BVH4; uses host cycles_bvh4).
+ *   8. Step-by-step interface (bvh_local_fast_begin / bvh_local_fast_step) for two-phase
+ *      persistent warp scheduling (CYCLES_SSS_STEP_BVH).
+ */
+
+#ifndef CYCLES_SSS_LOCAL_CULL
+#  define CYCLES_SSS_LOCAL_CULL 1
+#endif
+#ifndef CYCLES_SSS_LOCAL_STACK
+#  define CYCLES_SSS_LOCAL_STACK BVH_STACK_SIZE
+#endif
+#ifndef CYCLES_SSS_LOCAL_NO_VIS
+#  define CYCLES_SSS_LOCAL_NO_VIS 0
+#endif
+
+CCL_NAMESPACE_BEGIN
+
+#ifdef CYCLES_SSS_LOCAL_BVH4
+#  ifndef CYCLES_KERNEL_BVH4_DEF
+#    define CYCLES_KERNEL_BVH4_DEF 1
+struct KernelBVH4 {
+  const float4 *nodes;
+  const int *object_root;
+  int root;
+  int pad;
+};
+extern "C" __constant__ KernelBVH4 cycles_bvh4;
+__constant__ KernelBVH4 cycles_bvh4;
+#  endif
+#  ifndef BVH4_BVH2_TAG
+#    define BVH4_BVH2_TAG 0x40000000
+#  endif
+#endif
+
+#if CYCLES_SSS_LOCAL_CULL
+typedef int2 BVHLocalStackEntry;
+ccl_device_forceinline void blf_stack_set(int2 &e, const int a, const float d)
+{
+  e = make_int2(a, __float_as_int(d));
+}
+#else
+typedef int BVHLocalStackEntry;
+ccl_device_forceinline void blf_stack_set(int &e, const int a, const float /*d*/)
+{
+  e = a;
+}
+#endif
+
+struct BVHLocalFastState {
+  float3 P;
+  float3 dir;
+  float3 idir;
+  float isect_t;
+  int node_addr;
+  int stack_ptr;
+  int local_object;
+  int object;
+  int position_offset;
+  int self_prim;
+  Intersection isect;
+  bool hit;
+};
+
+ccl_device_forceinline void blf_push(BVHLocalFastState &tr,
+                                     BVHLocalStackEntry *stack,
+                                     const int a,
+                                     const float d)
+{
+  ++tr.stack_ptr;
+  kernel_assert(tr.stack_ptr < CYCLES_SSS_LOCAL_STACK);
+  blf_stack_set(stack[tr.stack_ptr], a, d);
+}
+
+#if CYCLES_SSS_LOCAL_CULL
+ccl_device_forceinline void blf_pop(BVHLocalFastState &tr, const int2 *stack)
+{
+  const float t = tr.isect_t;
+  int2 e;
+  do {
+    e = stack[tr.stack_ptr];
+    --tr.stack_ptr;
+  } while (__int_as_float(e.y) > t);
+  tr.node_addr = e.x;
+}
+#else
+ccl_device_forceinline void blf_pop(BVHLocalFastState &tr, const int *stack)
+{
+  tr.node_addr = stack[tr.stack_ptr];
+  --tr.stack_ptr;
+}
+#endif
+
+#ifdef CYCLES_SSS_LOCAL_DPX
+ccl_device_forceinline float blf_max4i(const float a, const float b, const float c, const float lo)
+{
+  return __int_as_float(__vimax3_s32(
+      __float_as_int(a), __float_as_int(b), max(__float_as_int(c), __float_as_int(lo))));
+}
+ccl_device_forceinline float blf_min4i(const float a, const float b, const float c, const float hi)
+{
+  return __int_as_float(__vimin3_s32(
+      __float_as_int(a), __float_as_int(b), min(__float_as_int(c), __float_as_int(hi))));
+}
+#endif
+
+/* Aligned BVH2 node intersection for local rays (tmin == 0.0f). */
+ccl_device_forceinline int blf_aligned_bvh2(const float4 cnodes,
+                                            const float3 P,
+                                            const float3 idir,
+                                            const float tmax,
+                                            const int node_addr,
+                                            float dist[2])
+{
+  const float4 node0 = kernel_data_fetch(bvh_nodes, node_addr + 1);
+  const float4 node1 = kernel_data_fetch(bvh_nodes, node_addr + 2);
+  const float4 node2 = kernel_data_fetch(bvh_nodes, node_addr + 3);
+
+#ifdef CYCLES_BVH_FMA
+  const float pidx = P.x * idir.x, pidy = P.y * idir.y, pidz = P.z * idir.z;
+  const float c0lox = fmaf(node0.x, idir.x, -pidx);
+  const float c0hix = fmaf(node0.z, idir.x, -pidx);
+  const float c0loy = fmaf(node1.x, idir.y, -pidy);
+  const float c0hiy = fmaf(node1.z, idir.y, -pidy);
+  const float c0loz = fmaf(node2.x, idir.z, -pidz);
+  const float c0hiz = fmaf(node2.z, idir.z, -pidz);
+  const float c1lox = fmaf(node0.y, idir.x, -pidx);
+  const float c1hix = fmaf(node0.w, idir.x, -pidx);
+  const float c1loy = fmaf(node1.y, idir.y, -pidy);
+  const float c1hiy = fmaf(node1.w, idir.y, -pidy);
+  const float c1loz = fmaf(node2.y, idir.z, -pidz);
+  const float c1hiz = fmaf(node2.w, idir.z, -pidz);
+#else
+  const float c0lox = (node0.x - P.x) * idir.x;
+  const float c0hix = (node0.z - P.x) * idir.x;
+  const float c0loy = (node1.x - P.y) * idir.y;
+  const float c0hiy = (node1.z - P.y) * idir.y;
+  const float c0loz = (node2.x - P.z) * idir.z;
+  const float c0hiz = (node2.z - P.z) * idir.z;
+  const float c1lox = (node0.y - P.x) * idir.x;
+  const float c1hix = (node0.w - P.x) * idir.x;
+  const float c1loy = (node1.y - P.y) * idir.y;
+  const float c1hiy = (node1.w - P.y) * idir.y;
+  const float c1loz = (node2.y - P.z) * idir.z;
+  const float c1hiz = (node2.w - P.z) * idir.z;
+#endif
+
+#ifdef CYCLES_SSS_LOCAL_DPX
+  const float c0min = blf_max4i(
+      fminf(c0lox, c0hix), fminf(c0loy, c0hiy), fminf(c0loz, c0hiz), 0.0f);
+  const float c0max = blf_min4i(
+      fmaxf(c0lox, c0hix), fmaxf(c0loy, c0hiy), fmaxf(c0loz, c0hiz), tmax);
+  const float c1min = blf_max4i(
+      fminf(c1lox, c1hix), fminf(c1loy, c1hiy), fminf(c1loz, c1hiz), 0.0f);
+  const float c1max = blf_min4i(
+      fmaxf(c1lox, c1hix), fmaxf(c1loy, c1hiy), fmaxf(c1loz, c1hiz), tmax);
+#else
+  const float c0min = max4(0.0f, min(c0lox, c0hix), min(c0loy, c0hiy), min(c0loz, c0hiz));
+  const float c0max = min4(tmax, max(c0lox, c0hix), max(c0loy, c0hiy), max(c0loz, c0hiz));
+  const float c1min = max4(0.0f, min(c1lox, c1hix), min(c1loy, c1hiy), min(c1loz, c1hiz));
+  const float c1max = min4(tmax, max(c1lox, c1hix), max(c1loy, c1hiy), max(c1loz, c1hiz));
+#endif
+
+  dist[0] = c0min;
+  dist[1] = c1min;
+
+#if defined(__VISIBILITY_FLAG__) && !CYCLES_SSS_LOCAL_NO_VIS
+  return (((c0max >= c0min) && (__float_as_uint(cnodes.x) & PATH_RAY_VISIBILITY_OBJECT_ALL)) ? 1 :
+                                                                                               0) |
+         (((c1max >= c1min) && (__float_as_uint(cnodes.y) & PATH_RAY_VISIBILITY_OBJECT_ALL)) ? 2 :
+                                                                                               0);
+#else
+  return ((c0max >= c0min) ? 1 : 0) | ((c1max >= c1min) ? 2 : 0);
+#endif
+}
+
+ccl_device_forceinline void blf_bvh2_node(BVHLocalFastState &tr,
+                                          BVHLocalStackEntry *stack,
+                                          const float tmax,
+                                          const int addr,
+                                          const int tag)
+{
+  const float4 cnodes = kernel_data_fetch(bvh_nodes, addr + 0);
+  float dist[2];
+  int mask;
+#ifdef __HAIR__
+  if (kernel_data.bvh.have_curves &&
+      (__float_as_uint(cnodes.x) & PATH_RAY_VISIBILITY_NODE_UNALIGNED))
+  {
+    mask = bvh_unaligned_node_intersect(
+        nullptr, tr.P, tr.dir, 0.0f, tmax, addr, PATH_RAY_VISIBILITY_OBJECT_ALL, dist);
+  }
+  else
+#endif
+  {
+    mask = blf_aligned_bvh2(cnodes, tr.P, tr.idir, tmax, addr, dist);
+  }
+
+  int child0 = __float_as_int(cnodes.z);
+  int child1 = __float_as_int(cnodes.w);
+  if (tag) {
+    child0 = (child0 >= 0) ? child0 + tag : child0;
+    child1 = (child1 >= 0) ? child1 + tag : child1;
+  }
+
+  if (mask == 3) {
+    float dfar = dist[1];
+    if (dist[1] < dist[0]) {
+      const int tmp = child0;
+      child0 = child1;
+      child1 = tmp;
+      dfar = dist[0];
+    }
+    blf_push(tr, stack, child1, dfar);
+    tr.node_addr = child0;
+  }
+  else if (mask == 2) {
+    tr.node_addr = child1;
+  }
+  else if (mask == 1) {
+    tr.node_addr = child0;
+  }
+  else {
+    blf_pop(tr, stack);
+  }
+}
+
+#ifdef CYCLES_SSS_LOCAL_BVH4
+ccl_device_forceinline unsigned long long blf_pin64(const unsigned long long x)
+{
+  unsigned long long y;
+  asm volatile("mov.b64 %0, %1;" : "=l"(y) : "l"(x));
+  return y;
+}
+
+ccl_device_forceinline void blf_bvh4_inner(BVHLocalFastState &tr, BVHLocalStackEntry *stack)
+{
+  const float3 idir = tr.idir;
+  const float tmax = tr.isect_t;
+  const float pidx = tr.P.x * idir.x, pidy = tr.P.y * idir.y, pidz = tr.P.z * idir.z;
+  const unsigned long long base = reinterpret_cast<unsigned long long>(cycles_bvh4.nodes);
+  const unsigned long long bx = blf_pin64(base + (idir.x >= 0.0f ? 0u : 16u));
+  const unsigned long long by = blf_pin64(base + (idir.y >= 0.0f ? 32u : 48u));
+  const unsigned long long bz = blf_pin64(base + (idir.z >= 0.0f ? 64u : 80u));
+
+  while (tr.node_addr >= 0 && tr.node_addr != ENTRYPOINT_SENTINEL) {
+#  ifdef __HAIR__
+    if (tr.node_addr >= BVH4_BVH2_TAG) {
+      blf_bvh2_node(tr, stack, tmax, tr.node_addr - BVH4_BVH2_TAG, BVH4_BVH2_TAG);
+      continue;
+    }
+#  endif
+    const unsigned long long o = (unsigned long long)(unsigned)tr.node_addr * 128u;
+    const unsigned long long ax = bx + o, ay = by + o, az = bz + o;
+    const float4 NX = *reinterpret_cast<const float4 *>(ax);
+    const float4 FX = *reinterpret_cast<const float4 *>(ax ^ 16u);
+    const float4 NY = *reinterpret_cast<const float4 *>(ay);
+    const float4 FY = *reinterpret_cast<const float4 *>(ay ^ 16u);
+    const float4 NZ = *reinterpret_cast<const float4 *>(az);
+    const float4 FZ = *reinterpret_cast<const float4 *>(az ^ 16u);
+    const char *nb = reinterpret_cast<const char *>(base + o);
+    const int4 ch = *reinterpret_cast<const int4 *>(nb + 96);
+#  if defined(__VISIBILITY_FLAG__) && !CYCLES_SSS_LOCAL_NO_VIS
+    const uint4 vs = *reinterpret_cast<const uint4 *>(nb + 112);
+    const uint vv[4] = {vs.x, vs.y, vs.z, vs.w};
+#  endif
+    const float nxv[4] = {NX.x, NX.y, NX.z, NX.w}, fxv[4] = {FX.x, FX.y, FX.z, FX.w};
+    const float nyv[4] = {NY.x, NY.y, NY.z, NY.w}, fyv[4] = {FY.x, FY.y, FY.z, FY.w};
+    const float nzv[4] = {NZ.x, NZ.y, NZ.z, NZ.w}, fzv[4] = {FZ.x, FZ.y, FZ.z, FZ.w};
+    float d[4];
+    int a[4] = {ch.x, ch.y, ch.z, ch.w};
+#  pragma unroll
+    for (int j = 0; j < 4; j++) {
+      const float tnx = fmaf(nxv[j], idir.x, -pidx);
+      const float tny = fmaf(nyv[j], idir.y, -pidy);
+      const float tnz = fmaf(nzv[j], idir.z, -pidz);
+      const float tfx = fmaf(fxv[j], idir.x, -pidx);
+      const float tfy = fmaf(fyv[j], idir.y, -pidy);
+      const float tfz = fmaf(fzv[j], idir.z, -pidz);
+#  ifdef CYCLES_SSS_LOCAL_DPX
+      const float tn = blf_max4i(tnx, tny, tnz, 0.0f);
+      const float tf = blf_min4i(tfx, tfy, tfz, tmax);
+#  else
+      const float tn = fmaxf(fmaxf(0.0f, tnx), fmaxf(tny, tnz));
+      const float tf = fminf(fminf(tmax, tfx), fminf(tfy, tfz));
+#  endif
+#  if defined(__VISIBILITY_FLAG__) && !CYCLES_SSS_LOCAL_NO_VIS
+      d[j] = (tn <= tf && (vv[j] & PATH_RAY_VISIBILITY_OBJECT_ALL)) ? tn : INFINITY;
+#  else
+      d[j] = (tn <= tf) ? tn : INFINITY;
+#  endif
+    }
+#  define BLF_CS(x, y) \
+    { \
+      const bool sw = d[y] < d[x]; \
+      const float td = sw ? d[y] : d[x]; \
+      d[y] = sw ? d[x] : d[y]; \
+      d[x] = td; \
+      const int ta = sw ? a[y] : a[x]; \
+      a[y] = sw ? a[x] : a[y]; \
+      a[x] = ta; \
+    }
+    BLF_CS(0, 1) BLF_CS(2, 3) BLF_CS(0, 2) BLF_CS(1, 3) BLF_CS(1, 2)
+#  undef BLF_CS
+#  pragma unroll
+    for (int j = 3; j >= 1; j--) {
+      if (d[j] != INFINITY) {
+        blf_push(tr, stack, a[j], d[j]);
+      }
+    }
+    if (d[0] != INFINITY) {
+      tr.node_addr = a[0];
+    }
+    else {
+      blf_pop(tr, stack);
+    }
+  }
+}
+#endif /* CYCLES_SSS_LOCAL_BVH4 */
+
+/* Initialize local traversal for one walk ray. Returns false if no traversal is needed. */
+ccl_device_forceinline bool bvh_local_fast_begin(KernelGlobals kg,
+                                                 BVHLocalFastState &tr,
+                                                 BVHLocalStackEntry *stack,
+                                                 const float3 ray_P,
+                                                 const float3 ray_D,
+                                                 const float ray_tmax,
+                                                 const int local_object,
+                                                 const int object_node,
+                                                 const uint object_flag,
+                                                 const int position_offset,
+                                                 const int self_prim
+#ifdef __OBJECT_MOTION__
+                                                 ,
+                                                 const float ray_time
+#endif
+)
+{
+  tr.hit = false;
+  if (!(isfinite_safe(ray_P.x) && isfinite_safe(ray_D.x) && len_squared(ray_D) != 0.0f)) {
+    tr.node_addr = ENTRYPOINT_SENTINEL;
+    return false;
+  }
+
+  blf_stack_set(stack[0], ENTRYPOINT_SENTINEL, -INFINITY);
+  tr.stack_ptr = 0;
+  tr.node_addr = object_node;
+  tr.isect_t = ray_tmax;
+  tr.local_object = local_object;
+  tr.position_offset = position_offset;
+  tr.self_prim = self_prim;
+
+  if (!(object_flag & SD_OBJECT_TRANSFORM_APPLIED)) {
+#ifdef __OBJECT_MOTION__
+    Transform itfm;
+    object_fetch_transform_motion_test(kg, local_object, ray_time, &itfm);
+#else
+    const Transform itfm = object_fetch_transform(kg, local_object, OBJECT_INVERSE_TRANSFORM);
+#endif
+    tr.P = transform_point(&itfm, ray_P);
+    tr.dir = bvh_clamp_direction(transform_direction(&itfm, ray_D));
+    tr.idir = bvh_inverse_direction(tr.dir);
+    tr.object = local_object;
+  }
+  else {
+    tr.P = ray_P;
+    tr.dir = bvh_clamp_direction(ray_D);
+    tr.idir = bvh_inverse_direction(tr.dir);
+    tr.object = OBJECT_NONE;
+  }
+
+  return tr.node_addr != ENTRYPOINT_SENTINEL;
+}
+
+/* One while-while step: traverse inner nodes down to the next leaf, test its triangles, then pop
+ * (after tightening tr.isect_t so cull-on-pop drops stale stack entries immediately).
+ * Returns true when traversal is complete (tr.node_addr == ENTRYPOINT_SENTINEL). */
+ccl_device_forceinline bool bvh_local_fast_step(KernelGlobals kg,
+                                                BVHLocalFastState &tr,
+                                                BVHLocalStackEntry *stack
+#ifdef __OBJECT_MOTION__
+                                                ,
+                                                const float ray_time
+#endif
+)
+{
+#ifdef CYCLES_SSS_LOCAL_BVH4
+  blf_bvh4_inner(tr, stack);
+#else
+  const float tmax = tr.isect_t;
+  while (tr.node_addr >= 0 && tr.node_addr != ENTRYPOINT_SENTINEL) {
+    blf_bvh2_node(tr, stack, tmax, tr.node_addr, 0);
+  }
+#endif
+
+  if (tr.node_addr < 0) {
+    const float4 leaf = kernel_data_fetch(bvh_leaf_nodes, (-tr.node_addr - 1));
+    int prim_addr = __float_as_int(leaf.x);
+    const int prim_addr2 = __float_as_int(leaf.y);
+    const uint type = __float_as_int(leaf.w);
+
+    if ((type & PRIMITIVE_ALL) == PRIMITIVE_TRIANGLE) {
+      for (; prim_addr < prim_addr2; prim_addr++) {
+        if (tr.object == OBJECT_NONE) {
+          if (kernel_data_fetch(prim_object, prim_addr) != tr.local_object) {
+            continue;
+          }
+        }
+        const int prim = kernel_data_fetch(prim_index, prim_addr);
+        if (prim == tr.self_prim) {
+          continue;
+        }
+        if (triangle_intersect_local_single(kg,
+                                            &tr.isect,
+                                            tr.P,
+                                            tr.dir,
+                                            tr.local_object,
+                                            tr.position_offset,
+                                            prim,
+                                            0.0f,
+                                            &tr.isect_t))
+        {
+          tr.hit = true;
+        }
+      }
+    }
+#ifdef __OBJECT_MOTION__
+    else if ((type & PRIMITIVE_ALL) == PRIMITIVE_MOTION_TRIANGLE) {
+      LocalIntersection tmp_isect;
+      tmp_isect.num_hits = tr.hit ? 1 : 0;
+      if (tr.hit) {
+        tmp_isect.hits[0] = tr.isect;
+      }
+      for (; prim_addr < prim_addr2; prim_addr++) {
+        if (tr.object == OBJECT_NONE) {
+          if (kernel_data_fetch(prim_object, prim_addr) != tr.local_object) {
+            continue;
+          }
+        }
+        const int prim = kernel_data_fetch(prim_index, prim_addr);
+        if (prim == tr.self_prim) {
+          continue;
+        }
+        motion_triangle_intersect_local(
+            kg, &tmp_isect, tr.P, tr.dir, ray_time, tr.local_object, prim, 0.0f, tr.isect_t, nullptr, 1);
+        if (tmp_isect.num_hits > 0 && (!tr.hit || tmp_isect.hits[0].t <= tr.isect_t)) {
+          tr.hit = true;
+          tr.isect = tmp_isect.hits[0];
+          tr.isect_t = tr.isect.t;
+        }
+      }
+    }
+#endif
+
+    /* Pop AFTER triangle tests so cull-on-pop uses the tightened isect_t. */
+    blf_pop(tr, stack);
+  }
+
+  return tr.node_addr == ENTRYPOINT_SENTINEL;
+}
+
+/* Complete single-hit local traversal for one walk ray. */
+ccl_device_forceinline bool bvh_intersect_local_single(KernelGlobals kg,
+                                                       const float3 ray_P,
+                                                       const float3 ray_D,
+                                                       const float ray_tmax,
+                                                       const int local_object,
+                                                       const int object_node,
+                                                       const uint object_flag,
+                                                       const int position_offset,
+                                                       const int self_prim,
+#ifdef __OBJECT_MOTION__
+                                                       const float ray_time,
+#endif
+                                                       ccl_private Intersection *out_isect)
+{
+  BVHLocalStackEntry stack[CYCLES_SSS_LOCAL_STACK];
+  BVHLocalFastState tr;
+  if (!bvh_local_fast_begin(kg,
+                            tr,
+                            stack,
+                            ray_P,
+                            ray_D,
+                            ray_tmax,
+                            local_object,
+                            object_node,
+                            object_flag,
+                            position_offset,
+                            self_prim
+#ifdef __OBJECT_MOTION__
+                            ,
+                            ray_time
+#endif
+                            ))
+  {
+    return false;
+  }
