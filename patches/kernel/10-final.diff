+#  ifdef CYCLES_SSS_LOCAL_FIX
+#    include "kernel/bvh/bvh_local_fast.h"
+#  endif
+
 CCL_NAMESPACE_BEGIN
 
+#  ifdef CYCLES_SSS_LOCAL_FIX
+
+struct SSSWalk {
+  float3 ray_P, ray_D;
+  float ray_tmax;
+  int self_prim;
+#    ifdef __OBJECT_MOTION__
+  float ray_time;
+#    endif
+  Intersection isect;
+  RNGState rng_state;
+  /* Walk constants (no dead LocalIntersection[4]/Ng, albedo, D, or *_star). */
+  float3 P, N;
+  int object, object_node, position_offset;
+  uint object_flag;
+  Spectrum alpha, sigma_t, sigma_s;
+  float anisotropy, guided_fraction, diffusion_length, phase_log;
+  /* Loop-carried. */
+  Spectrum throughput;
+  float opposite_distance;
+  int bounce;
+  bool hit, have_opposite_interface;
+};
+
+struct SSSWalkStepCtx {
+  Spectrum channel_pdf;
+  float t;
+  float backward_fraction;
+  float forward_pdf_factor;
+  float backward_pdf_factor;
+  float forward_stretching;
+  float backward_stretching;
+};
+
+/* rng_state must hold path_state_rng_load(state) on entry, as subsurface_scatter passes it. */
+ccl_device_forceinline bool sss_walk_begin(KernelGlobals kg, IntegratorState state, SSSWalk &w)
+{
+  RNGState &rng_state = w.rng_state;
+
+  w.P = INTEGRATOR_STATE(state, ray, P);
+  const float3 D = INTEGRATOR_STATE(state, ray, D);
+#    ifdef __OBJECT_MOTION__
+  w.ray_time = INTEGRATOR_STATE(state, ray, time);
+#    endif
+  w.N = INTEGRATOR_STATE(state, subsurface, N);
+  w.object = INTEGRATOR_STATE(state, isect, object);
+  w.self_prim = INTEGRATOR_STATE(state, isect, prim);
+
+  w.ray_P = w.P;
+  w.ray_D = D;
+  w.ray_tmax = FLT_MAX;
+
+  /* Convert subsurface to volume coefficients. */
+  const Spectrum albedo = INTEGRATOR_STATE(state, subsurface, albedo);
+  const Spectrum radius = INTEGRATOR_STATE(state, subsurface, radius);
+  float anisotropy = INTEGRATOR_STATE(state, subsurface, anisotropy);
+
+  bool van_de_hulst;
+  if (anisotropy >= 1.0f) {
+    anisotropy -= 2.0f;
+    van_de_hulst = anisotropy < 0.0f;
+  }
+  else {
+    van_de_hulst = true;
+  }
+
+  Spectrum sigma_t;
+  Spectrum alpha;
+  Spectrum throughput = INTEGRATOR_STATE(state, path, throughput);
+  subsurface_random_walk_coefficients(
+      albedo, radius, anisotropy, van_de_hulst, &sigma_t, &alpha, &throughput);
+  const Spectrum sigma_s = sigma_t * alpha;
+
+  const float diffusion_length = diffusion_length_dwivedi(reduce_max(alpha));
+
+  if (diffusion_length == 1.0f) {
+    return false;
+  }
+
+  w.phase_log = logf((diffusion_length + 1.0f) / (diffusion_length - 1.0f));
+  path_state_rng_scramble(&rng_state, 0xdeadbeef);
+
+  w.hit = false;
+  w.have_opposite_interface = false;
+  w.opposite_distance = 0.0f;
+
+  const float guided_fraction = 1.0f - fmaxf(0.5f, powf(fabsf(anisotropy), 0.125f));
+
+  w.sigma_t = sigma_t;
+  w.sigma_s = sigma_s;
+  w.anisotropy = anisotropy;
+  w.guided_fraction = guided_fraction;
+
+  w.alpha = alpha;
+  w.throughput = throughput;
+  w.diffusion_length = diffusion_length;
+  w.bounce = 0;
+
+#    ifdef CYCLES_SSS_LOCAL_BVH4
+  w.object_node = cycles_bvh4.object_root[w.object];
+#    else
+  w.object_node = kernel_data_fetch(object_node, w.object);
+#    endif
+  w.object_flag = kernel_data_fetch(object_flag, w.object);
+  w.position_offset = kernel_data_fetch(objects, w.object).position_offset;
+  return true;
+}
+
+/* Prepare the ray for bounce w.bounce before local BVH intersection. */
+ccl_device_forceinline void sss_walk_prep_ray(KernelGlobals kg, SSSWalk &w, SSSWalkStepCtx &ctx)
+{
+  RNGState &rng_state = w.rng_state;
+  const int bounce = w.bounce;
+  const float3 P = w.P;
+  const float3 N = w.N;
+  const float diffusion_length = w.diffusion_length;
+  const float phase_log = w.phase_log;
+
+  rng_state.rng_offset += PRNG_BOUNCE_NUM;
+
+  float anisotropy = w.anisotropy;
+  float guided_fraction = w.guided_fraction;
+  Spectrum sigma_t = w.sigma_t;
+  if (bounce > SUBSURFACE_RANDOM_WALK_SIMILARITY_LEVEL) {
+    anisotropy = 0.0f;
+    guided_fraction = 0.75f;
+    const Spectrum sigma_s_star = w.sigma_s * (1.0f - w.anisotropy);
+    sigma_t = w.sigma_t - w.sigma_s + sigma_s_star;
+  }
+
+  float rchannel = path_state_rng_1D(kg, &rng_state, PRNG_SUBSURFACE_COLOR_CHANNEL);
+  const int channel = volume_sample_channel(w.alpha, w.throughput, &rchannel, &ctx.channel_pdf);
+  float sample_sigma_t = volume_channel_get(sigma_t, channel);
+  const float randt = path_state_rng_1D(kg, &rng_state, PRNG_SUBSURFACE_SCATTER_DISTANCE);
+
+  ctx.backward_fraction = 0.0f;
+  ctx.forward_pdf_factor = 0.0f;
+  ctx.forward_stretching = 1.0f;
+  ctx.backward_pdf_factor = 0.0f;
+  ctx.backward_stretching = 1.0f;
+
+  if (bounce > 0) {
+    const bool guided = (path_state_rng_1D(kg, &rng_state, PRNG_SUBSURFACE_GUIDE_STRATEGY) <
+                         guided_fraction);
+
+    bool guide_backward = false;
+    if (w.have_opposite_interface) {
+      const float x = clamp(dot(w.ray_P - P, -N), 0.0f, w.opposite_distance);
+      ctx.backward_fraction = 1.0f /
+                              (1.0f + expf((w.opposite_distance - 2.0f * x) / diffusion_length));
+      guide_backward = path_state_rng_1D(kg, &rng_state, PRNG_SUBSURFACE_GUIDE_DIRECTION) <
+                       ctx.backward_fraction;
+    }
+
+    const float2 rand_scatter = path_state_rng_2D(kg, &rng_state, PRNG_SUBSURFACE_BSDF);
+    float cos_theta;
+    float hg_pdf;
+    if (guided) {
+      cos_theta = sample_phase_dwivedi(diffusion_length, phase_log, rand_scatter.x);
+      if (guide_backward) {
+        cos_theta = -cos_theta;
+      }
+      const float3 newD = direction_from_cosine(N, cos_theta, rand_scatter.y);
+      hg_pdf = phase_henyey_greenstein(dot(w.ray_D, newD), anisotropy);
+      w.ray_D = newD;
+    }
+    else {
+      const float3 newD = phase_henyey_greenstein_sample(
+          w.ray_D, anisotropy, rand_scatter, &hg_pdf);
+      cos_theta = dot(newD, N);
+      w.ray_D = newD;
+    }
+
+    ctx.forward_pdf_factor = M_1_2PI_F * eval_phase_dwivedi(diffusion_length, phase_log, cos_theta) /
+                             hg_pdf;
+    ctx.backward_pdf_factor = M_1_2PI_F *
+                              eval_phase_dwivedi(diffusion_length, phase_log, -cos_theta) / hg_pdf;
+
+    ctx.forward_stretching = (1.0f - cos_theta / diffusion_length);
+    ctx.backward_stretching = (1.0f + cos_theta / diffusion_length);
+    if (guided) {
+      sample_sigma_t *= guide_backward ? ctx.backward_stretching : ctx.forward_stretching;
+    }
+  }
+
+  const float t = -logf(1.0f - randt) / sample_sigma_t;
+  ctx.t = t;
+
+  if (bounce == 0) {
+    w.ray_tmax = max(t, 10.0f / (reduce_min(sigma_t)));
+  }
+  else {
+    w.ray_tmax = t;
+    w.self_prim = PRIM_NONE;
+  }
+}
+
+/* Complete bounce w.bounce after local BVH intersection; true when the walk loop has ended. */
+ccl_device_forceinline bool sss_walk_post_ray(
+    KernelGlobals kg, IntegratorState state, SSSWalk &w, const SSSWalkStepCtx &ctx, const bool ray_hit)
+{
+  const int bounce = w.bounce;
+  float guided_fraction = w.guided_fraction;
+  Spectrum sigma_t = w.sigma_t;
+  Spectrum sigma_s = w.sigma_s;
+  if (bounce > SUBSURFACE_RANDOM_WALK_SIMILARITY_LEVEL) {
+    guided_fraction = 0.75f;
+    sigma_s = w.sigma_s * (1.0f - w.anisotropy);
+    sigma_t = w.sigma_t - w.sigma_s + sigma_s;
+  }
+
+  bool hit = ray_hit;
+  if (hit) {
+    w.ray_tmax = w.isect.t;
+  }
+
+  if (bounce == 0) {
+    if (hit) {
+      w.have_opposite_interface = true;
+      w.opposite_distance = dot(w.ray_P + w.ray_tmax * w.ray_D - w.P, -w.N);
+    }
+    hit = w.ray_tmax < ctx.t;
+  }
+
+  const float t = hit ? w.ray_tmax : ctx.t;
+  w.ray_P += t * w.ray_D;
+
+  Spectrum transmittance;
+  Spectrum pdf = subsurface_random_walk_pdf(sigma_t, t, hit, &transmittance);
+  if (bounce > 0) {
+    Spectrum guided_pdf = subsurface_random_walk_pdf(
+        ctx.forward_stretching * sigma_t, t, hit, nullptr);
+
+    if (w.have_opposite_interface) {
+      const Spectrum back_pdf = subsurface_random_walk_pdf(
+          ctx.backward_stretching * sigma_t, t, hit, nullptr);
+      guided_pdf = mix(guided_pdf * ctx.forward_pdf_factor,
+                       back_pdf * ctx.backward_pdf_factor,
+                       ctx.backward_fraction);
+    }
+    else {
+      guided_pdf *= ctx.forward_pdf_factor;
+    }
+
+    pdf = mix(pdf, guided_pdf, guided_fraction);
+  }
+
+  w.throughput *= (hit ? transmittance : sigma_s * transmittance) / dot(ctx.channel_pdf, pdf);
+  w.hit = hit;
+
+  if (hit) {
+    return true;
+  }
+  if (reduce_max(w.throughput) < VOLUME_THROUGHPUT_EPSILON) {
+    return true;
+  }
+#    if defined(CYCLES_SSS_WALK_RR_Q)
+#      if defined(CYCLES_SSS_WALK_RR_QI)
+  const bool sss_indirect = INTEGRATOR_STATE(state, path, bounce) > 0;
+  const int sss_k0 = sss_indirect ? CYCLES_SSS_WALK_RR_K0I : CYCLES_SSS_WALK_RR_K0;
+  if (bounce + 1 >= sss_k0) {
+    const float q = float(sss_indirect ? CYCLES_SSS_WALK_RR_QI : CYCLES_SSS_WALK_RR_Q) * 0.001f;
+    const float u = hash_uint4_to_float(
+        w.rng_state.rng_pixel, uint(w.rng_state.sample), w.rng_state.rng_offset, uint(bounce) ^ 0x5bd1e995u);
+    if (u >= q) {
+      return true;
+    }
+    w.throughput /= q;
+  }
+#      else
+  if (bounce + 1 >= CYCLES_SSS_WALK_RR_K0) {
+    const float q = float(CYCLES_SSS_WALK_RR_Q) * 0.001f;
+    const float u = hash_uint4_to_float(
+        w.rng_state.rng_pixel, uint(w.rng_state.sample), w.rng_state.rng_offset, uint(bounce) ^ 0x5bd1e995u);
+    if (u >= q) {
+      return true;
+    }
+    w.throughput /= q;
+  }
+#      endif
+#    endif
+  w.bounce = bounce + 1;
+#    if defined(CYCLES_SSS_STEP_CAP)
+  return w.bounce >= min(CYCLES_SSS_STEP_CAP, BSSRDF_MAX_BOUNCES);
+#    else
+  return w.bounce >= BSSRDF_MAX_BOUNCES;
+#    endif
+}
+
+ccl_device_forceinline bool sss_walk_step(KernelGlobals kg, IntegratorState state, SSSWalk &w)
+{
+  SSSWalkStepCtx ctx;
+  sss_walk_prep_ray(kg, w, ctx);
+  const bool ray_hit = bvh_intersect_local_single(kg,
+                                                  w.ray_P,
+                                                  w.ray_D,
+                                                  w.ray_tmax,
+                                                  w.object,
+                                                  w.object_node,
+                                                  w.object_flag,
+                                                  w.position_offset,
+                                                  w.self_prim,
+#    ifdef __OBJECT_MOTION__
+                                                  w.ray_time,
+#    endif
+                                                  &w.isect);
+  return sss_walk_post_ray(kg, state, w, ctx, ray_hit);
+}
+
+ccl_device_forceinline bool sss_walk_end(KernelGlobals kg, IntegratorState state, SSSWalk &w)
+{
+  if (w.hit) {
+    kernel_assert(isfinite_safe(w.throughput));
+    INTEGRATOR_STATE_WRITE(state, path, throughput) = w.throughput;
+  }
+  return w.hit;
+}
