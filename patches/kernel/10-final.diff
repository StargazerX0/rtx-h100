+ *  - Pattern 2: NODE_LIGHT_PATH(ray_length) -> NODE_MATH(DIVIDE) -> NODE_MAP_RANGE(SMOOTHERSTEP)
+ *               -> NODE_CLAMP -> NODE_JUMP_IF_ONE -> NODE_MIX_CLOSURE -> NODE_CLOSURE_SET_WEIGHT
+ *               -> NODE_CLOSURE_EMISSION (monster Area.001..Area.008)
+ * Returns true and writes shader emission (before klight->strength) into eval if matched. */
+ccl_device_noinline bool emit_bake_eval_lamp(KernelGlobals kg,
+                                             const int shader_id,
+                                             const float ray_length,
+                                             ccl_private Spectrum &eval)
+{
+  const int off = emit_bake_shader_surface_offset(kg, shader_id);
+  if (off < 0) {
+    return false;
+  }
+
+  const uint op0 = kernel_data_fetch(svm_nodes, off);
+
+  /* Pattern 1: NODE_LIGHT_FALLOFF (5w) -> NODE_EMISSION_WEIGHT (5w) -> NODE_CLOSURE_EMISSION. */
+  if (op0 == NODE_LIGHT_FALLOFF &&
+      kernel_data_fetch(svm_nodes, off + 5) == NODE_EMISSION_WEIGHT &&
+      kernel_data_fetch(svm_nodes, off + 10) == NODE_CLOSURE_EMISSION)
+  {
+    const ccl_global SVMNodeLightFalloff &lf =
+        *reinterpret_cast<const ccl_global SVMNodeLightFalloff *>(
+            &kernel_data_fetch(svm_nodes, off + 1));
+    const ccl_global SVMNodeEmissionWeight &ew =
+        *reinterpret_cast<const ccl_global SVMNodeEmissionWeight *>(
+            &kernel_data_fetch(svm_nodes, off + 6));
+    if (emit_bake_input_is_const(lf.strength) && emit_bake_input_is_const(lf.smooth) &&
+        emit_bake_input_is_const3(ew.color) && !emit_bake_input_is_const(ew.strength) &&
+        (ew.strength.bits & 0xFFu) == (uint)lf.out_offset)
+    {
+      float s = emit_bake_input_float(lf.strength);
+      if (ray_length != FLT_MAX) {
+        if (lf.falloff_type == NODE_LIGHT_FALLOFF_LINEAR) {
+          s *= ray_length;
+        }
+        else if (lf.falloff_type == NODE_LIGHT_FALLOFF_CONSTANT) {
+          s *= ray_length * ray_length;
+        }
+        const float smooth = emit_bake_input_float(lf.smooth);
+        if (smooth > 0.0f) {
+          const float sq = ray_length * ray_length;
+          s *= sq / (smooth + sq);
+        }
+      }
+      eval = rgb_to_spectrum(emit_bake_input_float3(ew.color) * s);
+      return true;
+    }
+  }
+
+  /* Pattern 2: Monster controlled-falloff Area lights (smootherstep(ray_length / div)). */
+  if (op0 == NODE_LIGHT_PATH && kernel_data_fetch(svm_nodes, off + 3) == NODE_MATH &&
+      kernel_data_fetch(svm_nodes, off + 9) == NODE_MAP_RANGE &&
+      kernel_data_fetch(svm_nodes, off + 30) == NODE_CLOSURE_SET_WEIGHT &&
+      kernel_data_fetch(svm_nodes, off + 34) == NODE_CLOSURE_EMISSION)
+  {
+    const ccl_global SVMNodeMath &mnode = *reinterpret_cast<const ccl_global SVMNodeMath *>(
+        &kernel_data_fetch(svm_nodes, off + 4));
+    const ccl_global SVMNodeMapRange &mr = *reinterpret_cast<const ccl_global SVMNodeMapRange *>(
+        &kernel_data_fetch(svm_nodes, off + 10));
+    if (mnode.math_type == NODE_MATH_DIVIDE && emit_bake_input_is_const(mnode.value2) &&
+        mr.range_type == NODE_MAP_RANGE_SMOOTHERSTEP)
+    {
+      const float div = emit_bake_input_float(mnode.value2);
+      if (div > 0.0f && ray_length >= div) {
+        eval = zero_spectrum();
+        return true;
+      }
+      const float x = fmaxf(safe_divide(ray_length, div), 0.0f);
+      const float fac = x * x * x * (x * (x * 6.0f - 15.0f) + 10.0f);
+      const ccl_global SVMNodeClosureSetWeight &sw =
+          *reinterpret_cast<const ccl_global SVMNodeClosureSetWeight *>(
+              &kernel_data_fetch(svm_nodes, off + 31));
+      eval = rgb_to_spectrum(make_float3(sw.rgb) * (1.0f - fac));
+      return true;
+    }
+  }
+
+  return false;
+}
+
+/* Exact fast evaluation for PBR + UV-mapped Emissive texture mesh (junkshop 5 emissive meshes).
+ * Evaluates only the emissive texture (skipping 4 dead PBR textures + NormalMap + Principled). */
+ccl_device_inline bool emit_bake_eval_pbr_emissive_tex(KernelGlobals kg,
+                                                       const int off,
+                                                       const int object,
+                                                       const int prim,
+                                                       const float tri_u,
+                                                       const float tri_v,
+                                                       ccl_private Spectrum &eval)
+{
+  if (kernel_data_fetch(svm_nodes, off) != NODE_ATTR ||
+      kernel_data_fetch(svm_nodes, off + 109) != NODE_TEX_IMAGE ||
+      kernel_data_fetch(svm_nodes, off + 117) != NODE_EMISSION_WEIGHT ||
+      kernel_data_fetch(svm_nodes, off + 122) != NODE_CLOSURE_EMISSION)
+  {
+    return false;
+  }
+
+  const ccl_global SVMNodeAttr &attr_node = *reinterpret_cast<const ccl_global SVMNodeAttr *>(
+      &kernel_data_fetch(svm_nodes, off + 1));
+  const ccl_global SVMNodeTexImage &tex_node =
+      *reinterpret_cast<const ccl_global SVMNodeTexImage *>(
+          &kernel_data_fetch(svm_nodes, off + 110));
+  const ccl_global SVMNodeEmissionWeight &ew =
+      *reinterpret_cast<const ccl_global SVMNodeEmissionWeight *>(
+          &kernel_data_fetch(svm_nodes, off + 118));
+
+  if (tex_node.projection != NODE_IMAGE_PROJ_FLAT || tex_node.id < 0 ||
+      tex_node.co != attr_node.out_offset || !emit_bake_input_is_const(ew.strength) ||
+      emit_bake_input_is_const3(ew.color) ||
+      (ew.color.x.bits & 0xFFu) != (uint)tex_node.out_offset)
+  {
+    return false;
+  }
+
+  const ccl_global KernelImageTexture &tex = kernel_data_fetch(image_textures, tex_node.id);
+  if (tex.tile_descriptor_offset != KERNEL_TILE_LOAD_NONE ||
+      tex.image_info_id == KERNEL_IMAGE_NONE)
+  {
+    return false;
+  }
+
+  const ccl_global KernelImageInfo &info = kernel_data_fetch(image_info, tex.image_info_id);
+  if (info.interpolation == INTERPOLATION_CUBIC || info.interpolation == INTERPOLATION_SMART) {
+    return false;
+  }
+
+  const AttributeDescriptor desc = find_attribute(kg, object, prim, attr_node.attr);
+  if (desc.offset == ATTR_STD_NOT_FOUND ||
+      !(desc.element & (ATTR_ELEMENT_VERTEX | ATTR_ELEMENT_CORNER)))
+  {
+    return false;
+  }
+
+  int i0, i1, i2;
+  if (desc.element & ATTR_ELEMENT_VERTEX) {
+    const uint3 vi = kernel_data_fetch(tri_vindex, prim);
+    i0 = vi.x;
+    i1 = vi.y;
+    i2 = vi.z;
+  }
+  else {
+    const int tri = prim * 3;
+    i0 = tri + 0;
+    i1 = tri + 1;
+    i2 = tri + 2;
+  }
+
+  const float2 f0 = kernel_data_fetch(attributes_float2, desc.offset + i0);
+  const float2 f1 = kernel_data_fetch(attributes_float2, desc.offset + i1);
+  const float2 f2 = kernel_data_fetch(attributes_float2, desc.offset + i2);
+  const float2 uv = triangle_interpolate(tri_u, tri_v, f0, f1, f2);
+
+  ccl_gpu_image_object_2D tex_obj = (ccl_gpu_image_object_2D)info.data;
+  const int texture_type = info.data_type;
+  float4 r;
+  if (texture_type == IMAGE_DATA_TYPE_FLOAT4 || texture_type == IMAGE_DATA_TYPE_BYTE4 ||
+      texture_type == IMAGE_DATA_TYPE_HALF4 || texture_type == IMAGE_DATA_TYPE_USHORT4)
+  {
+    r = ccl_gpu_image_object_read_2D<float4>(tex_obj, uv.x, uv.y);
+  }
+  else {
+    const float f = ccl_gpu_image_object_read_2D<float>(tex_obj, uv.x, uv.y);
+    r = make_float4(f, f, f, 1.0f);
+  }
+
+  if (r.x <= 0.0f && r.y <= 0.0f && r.z <= 0.0f) {
+    eval = zero_spectrum();
+    return true;
+  }
+
+  const float alpha = r.w;
+  if ((tex_node.flags & NODE_IMAGE_ALPHA_UNASSOCIATE) && alpha != 1.0f && alpha != 0.0f) {
+    r /= alpha;
+    r.w = alpha;
+  }
+  if (tex_node.flags & NODE_IMAGE_COMPRESS_AS_SRGB) {
+    r = color_srgb_to_linear_v4(r);
+  }
+
+  const float strength = emit_bake_input_float(ew.strength);
+  eval = rgb_to_spectrum(make_float3(r.x, r.y, r.z) * strength);
+  return true;
+}
+
+/* Evaluate non-constant triangle mesh emitters inline in shade_surface (NEE). */
+ccl_device_noinline bool emit_bake_eval_mesh_nee(KernelGlobals kg,
+                                                 const ccl_private LightSample &ls,
+                                                 ccl_private Spectrum &eval)
+{
+  const int off = emit_bake_shader_surface_offset(kg, ls.shader);
+  if (off < 0) {
+    return false;
+  }
+
+  const uint op0 = kernel_data_fetch(svm_nodes, off);
+
+  /* Pattern 3: Monster light softboxes (Object -> Mapping(TEXTURE) -> QuadraticSphere -> *mul). */
+  if (op0 == NODE_TEX_COORD && kernel_data_fetch(svm_nodes, off + 3) == NODE_MAPPING &&
+      kernel_data_fetch(svm_nodes, off + 18) == NODE_TEX_GRADIENT &&
+      kernel_data_fetch(svm_nodes, off + 21) == NODE_MATH &&
+      kernel_data_fetch(svm_nodes, off + 27) == NODE_EMISSION_WEIGHT &&
+      kernel_data_fetch(svm_nodes, off + 32) == NODE_CLOSURE_EMISSION)
+  {
+    const ccl_global SVMNodeTexCoord &tc = *reinterpret_cast<const ccl_global SVMNodeTexCoord *>(
+        &kernel_data_fetch(svm_nodes, off + 1));
+    const ccl_global SVMNodeMapping &mp = *reinterpret_cast<const ccl_global SVMNodeMapping *>(
+        &kernel_data_fetch(svm_nodes, off + 4));
+    const ccl_global SVMNodeTexGradient &gr =
+        *reinterpret_cast<const ccl_global SVMNodeTexGradient *>(
+            &kernel_data_fetch(svm_nodes, off + 19));
+    const ccl_global SVMNodeMath &mn = *reinterpret_cast<const ccl_global SVMNodeMath *>(
+        &kernel_data_fetch(svm_nodes, off + 22));
+    const ccl_global SVMNodeEmissionWeight &ew =
+        *reinterpret_cast<const ccl_global SVMNodeEmissionWeight *>(
+            &kernel_data_fetch(svm_nodes, off + 28));
+    const uint object_flag = kernel_data_fetch(object_flag, ls.object);
+    if (tc.texco_type == NODE_TEXCO_OBJECT && mp.mapping_type == NODE_MAPPING_TYPE_TEXTURE &&
+        gr.gradient_type == NODE_BLEND_QUADRATIC_SPHERE && mn.math_type == NODE_MATH_MULTIPLY &&
+        !(object_flag & SD_OBJECT_MOTION) && emit_bake_input_is_const3(mp.location) &&
+        emit_bake_input_is_const3(mp.rotation) && emit_bake_input_is_const3(mp.scale) &&
+        emit_bake_input_is_const(mn.value2) && emit_bake_input_is_const3(ew.color))
+    {
+      const float3 rot = emit_bake_input_float3(mp.rotation);
+      if (is_zero(rot)) {
+        const Transform itfm = object_fetch_transform(kg, ls.object, OBJECT_INVERSE_TRANSFORM);
+        const float3 P_obj = transform_point(&itfm, ls.P);
+        const float3 loc = emit_bake_input_float3(mp.location);
+        const float3 scale = emit_bake_input_float3(mp.scale);
+        const float3 v = safe_divide(P_obj - loc, scale);
+        const float r = fmaxf(0.999999f - len(v), 0.0f);
+        const float fac = saturatef(r * r);
+        const float mul = emit_bake_input_float(mn.value2);
+        eval = rgb_to_spectrum(emit_bake_input_float3(ew.color) * (fac * mul));
+        return true;
+      }
+    }
+  }
+
+#  ifndef CYCLES_EMIT_BAKE_NEE_KERNEL
+  /* Pattern 4: Junkshop PBR + Emissive 2D image texture evaluated inline via 1 tex2D. */
+  if (op0 == NODE_ATTR) {
+    if (emit_bake_eval_pbr_emissive_tex(kg, off, ls.object, ls.prim, ls.tri_u, ls.tri_v, eval)) {
+      return true;
+    }
+  }
+#  endif
+
+#  ifdef CYCLES_EMIT_BAKE_SKY_LUT
+  /* Pattern 5: Classroom dayLight_portal (Backfacing -> Sky -> Curves -> HSV -> *20). */
+  if (op0 == NODE_LIGHT_PATH && kernel_data_fetch(svm_nodes, off + 24) == NODE_TEX_SKY &&
+      kernel_data_fetch(svm_nodes, off + 59) == NODE_CURVES &&
+      kernel_data_fetch(svm_nodes, off + 1096) == NODE_HSV &&
+      kernel_data_fetch(svm_nodes, off + 27) == EMIT_BAKE_CLASSROOM_SKY_SIG_PHI &&
+      kernel_data_fetch(svm_nodes, off + 28) == EMIT_BAKE_CLASSROOM_SKY_SIG_THETA)
+  {
+    const float3 Ng = make_float3(ls.Ng);
+    const float d_dot_n = dot(ls.D, Ng);
+    /* Backfacing = (dot(Ng, -ls.D) < 0) <=> (dot(ls.D, Ng) > 0). Frontfacing is Transparent. */
+    if (d_dot_n <= 0.0f) {
+      eval = zero_spectrum();
+      return true;
+    }
+    const float3 R = ls.D - 2.0f * d_dot_n * Ng;
+    eval = rgb_to_spectrum(emit_bake_classroom_sky_eval(R));
+    return true;
+  }
+#  endif
+
+  return false;
+}
+
+ccl_device_inline bool emit_bake_eval_nee(KernelGlobals kg,
+                                          const ccl_private LightSample &ls,
+                                          ccl_private Spectrum &eval)
+{
+  if (ls.type != LIGHT_TRIANGLE) {
+    return emit_bake_eval_lamp(kg, ls.shader, ls.t, eval);
+  }
+  return emit_bake_eval_mesh_nee(kg, ls, eval);
+}
+
+CCL_NAMESPACE_END
+
+#endif /* CYCLES_EMIT_BAKE */
