+                                                          const ccl_private LightSample &ls,
+                                                          ccl_private Spectrum &eval)
+{
+  eval = one_spectrum();
+  bool is_constant = surface_shader_constant_emission(kg, ls.shader, &eval);
+  if (!is_constant) {
+    is_constant = emit_bake_eval_nee(kg, ls, eval);
