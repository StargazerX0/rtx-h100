+ccl_device_inline float3 emit_bake_classroom_sky_eval(const float3 R)
+{
+  const float N_m1 = (float)(EMIT_BAKE_CLASSROOM_SKY_N - 1);
+  const float cg = R.x * EMIT_BAKE_CLASSROOM_SUN_X + R.y * EMIT_BAKE_CLASSROOM_SUN_Y +
+                   R.z * EMIT_BAKE_CLASSROOM_SUN_Z;
+  const float u = sqrtf(fmaxf(R.z, 0.0f)) * N_m1;
+  const float v = sqrtf(fmaxf(0.5f * (1.0f - cg), 0.0f)) * N_m1;
+  const int i0 = min((int)u, EMIT_BAKE_CLASSROOM_SKY_N - 2);
+  const int j0 = min((int)v, EMIT_BAKE_CLASSROOM_SKY_N - 2);
+  const float fu = u - (float)i0;
+  const float fv = v - (float)j0;
+
+  const int idx00 = (i0 * EMIT_BAKE_CLASSROOM_SKY_N + j0) * 3;
+  const int idx01 = idx00 + 3;
+  const int idx10 = idx00 + EMIT_BAKE_CLASSROOM_SKY_N * 3;
+  const int idx11 = idx10 + 3;
+
+  const float w00 = (1.0f - fu) * (1.0f - fv);
+  const float w01 = (1.0f - fu) * fv;
+  const float w10 = fu * (1.0f - fv);
+  const float w11 = fu * fv;
+
+  const float r = w00 * k_emit_bake_classroom_sky_lut[idx00 + 0] +
+                  w01 * k_emit_bake_classroom_sky_lut[idx01 + 0] +
+                  w10 * k_emit_bake_classroom_sky_lut[idx10 + 0] +
+                  w11 * k_emit_bake_classroom_sky_lut[idx11 + 0];
+  const float g = w00 * k_emit_bake_classroom_sky_lut[idx00 + 1] +
+                  w01 * k_emit_bake_classroom_sky_lut[idx01 + 1] +
+                  w10 * k_emit_bake_classroom_sky_lut[idx10 + 1] +
+                  w11 * k_emit_bake_classroom_sky_lut[idx11 + 1];
+  const float b = w00 * k_emit_bake_classroom_sky_lut[idx00 + 2] +
+                  w01 * k_emit_bake_classroom_sky_lut[idx01 + 2] +
+                  w10 * k_emit_bake_classroom_sky_lut[idx10 + 2] +
+                  w11 * k_emit_bake_classroom_sky_lut[idx11 + 2];
+  return make_float3(r, g, b);
+}
