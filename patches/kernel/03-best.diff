--- a/intern/cycles/kernel/bvh/bvh2_dynamic.h
+++ b/intern/cycles/kernel/bvh/bvh2_dynamic.h
@@ -646,6 +646,97 @@ ccl_device_forceinline void bvh2df_run(Work &work, uint *counter, const int work
     }
   }
 }
+
+#  ifdef CYCLES_SSSDF
+/* The same fetch / refill / deferred-finish loop for per-lane work whose step is not a BVH2
+ * traversal step (the subsurface random walk: one bounce per step). Work provides
+ *   int state(int index); bool begin(int state)   (false: nothing to step, finish at once)
+ *   bool step(int state)  (true: finished);       void finish(int state)
+ * Policy knobs as above (CYCLES_BVH2DF_POLICY / _MINLIVE / _ND / _NW / _DEFER / _FETCH);
+ * CYCLES_BVH2DF_CHUNK is not applied here. */
+template<class Work>
+ccl_device_forceinline void bvh2df_run_work(Work &work, uint *counter, const int work_size)
+{
+  const uint lane = threadIdx.x & 31;
+  const uint warp_mask = __activemask();
+  bool active = false;
+  bool exhausted = false;
+#    if CYCLES_BVH2DF_DEFER
+  bool pending = false;
+#    endif
+  int state = 0;
+  while (true) {
+#    if CYCLES_BVH2DF_DEFER
+    if (pending) {
+      work.finish(state);
+      pending = false;
+    }
+#    endif
+    const bool idle = !active && !exhausted;
+    const uint fetch_mask = __ballot_sync(warp_mask, idle);
+    if (fetch_mask) {
+#    if CYCLES_BVH2DF_FETCH == 0
+      const int leader = __ffs(fetch_mask) - 1;
+      uint base = 0;
+      if (lane == leader) {
+        base = atomicAdd(counter, uint(__popc(fetch_mask)));
+      }
+      base = __shfl_sync(warp_mask, base, leader);
+#    endif
+      if (idle) {
+#    if CYCLES_BVH2DF_FETCH == 0
+        const uint next = base + __popc(fetch_mask & ((1u << lane) - 1));
+#    else
+        const uint next = atomicAdd(counter, 1u);
+#    endif
+        exhausted = next >= uint(work_size);
+        if (!exhausted) {
+          state = work.state(int(next));
+          active = work.begin(state);
+          if (!active) {
+            work.finish(state);
+          }
+        }
+      }
+    }
+    if (!__any_sync(warp_mask, active)) {
+      if (__all_sync(warp_mask, exhausted)) {
+        return;
+      }
+      continue;
+    }
+#    if CYCLES_BVH2DF_POLICY == 0
+    int lost_iterations = 0;
+#    endif
+    while (true) {
+      if (active) {
+        if (work.step(state)) {
+#    if CYCLES_BVH2DF_DEFER
+          pending = true;
+#    else
+          work.finish(state);
+#    endif
+          active = false;
+        }
+      }
+      const uint live = __ballot_sync(warp_mask, active);
+      if (!live) {
+        break;
+      }
+#    if CYCLES_BVH2DF_POLICY == 0
+      lost_iterations += __popc(warp_mask & ~live) - CYCLES_BVH2DF_ND;
+      if (lost_iterations >= CYCLES_BVH2DF_NW) {
+        break;
+      }
+#    else
+      if (__popc(live) < CYCLES_BVH2DF_MINLIVE && !__all_sync(warp_mask, exhausted || active)) {
+        break;
+      }
+#    endif
+    }
+  }
+}
+#  endif /* CYCLES_SSSDF */
 #endif
 
 CCL_NAMESPACE_END
