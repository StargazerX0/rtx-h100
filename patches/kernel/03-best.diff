diff --git a/intern/cycles/util/atomic.h b/intern/cycles/util/atomic.h
index 697df94..4db699b 100644
--- a/intern/cycles/util/atomic.h
+++ b/intern/cycles/util/atomic.h
@@ -327,4 +327,40 @@ ccl_device_inline int atomic_load_local(int *p)
 
 #  endif /* __KERNEL_ONEAPI__ */
 
+/* Ours, CYCLES_WARP_ATOMICS (final4's warp-aggregated atomics, Zhifei Li, ported to 5.3.0): the lanes of a warp
+ * that update the same queue counter combine their updates into one atomic by the lowest such lane. A counter
+ * ends with the same value as with one atomic per lane; only which lane gets which returned index changes, and
+ * that order was already decided by atomic arrival order. Unset: the stock calls, unchanged. */
+#  if defined(CYCLES_WARP_ATOMICS) && defined(__KERNEL_CUDA__) && defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 800
+ccl_device_forceinline void atomic_add_aggregated_uint32(ccl_global uint *p, const uint x)
+{
+  const unsigned int mask = __activemask();
+  const unsigned int peers = __match_any_sync(mask, (unsigned long long)p);
+  const unsigned int sum = __reduce_add_sync(peers, x);
+  if ((threadIdx.x & 31) == (__ffs(peers) - 1)) {
+    atomicAdd((unsigned int *)p, sum);
+  }
+}
+ccl_device_forceinline uint atomic_fetch_add_one_aggregated_uint32(ccl_global uint *p)
+{
+  const unsigned int mask = __activemask();
+  const unsigned int peers = __match_any_sync(mask, (unsigned long long)p);
+  const int leader = __ffs(peers) - 1;
+  const unsigned int lane = threadIdx.x & 31;
+  unsigned int base = 0;
+  if (lane == leader) {
+    base = atomicAdd((unsigned int *)p, __popc(peers));
+  }
+  base = __shfl_sync(peers, base, leader);
+  return base + __popc(peers & ((1u << lane) - 1u));
+}
+#    define CYCLES_COUNTER_ADD1(p) atomic_add_aggregated_uint32((ccl_global uint *)(p), 1u)
+#    define CYCLES_COUNTER_SUB1(p) atomic_add_aggregated_uint32((ccl_global uint *)(p), (uint)-1)
+#    define CYCLES_COUNTER_FETCH_INC(p) atomic_fetch_add_one_aggregated_uint32((ccl_global uint *)(p))
+#  else
+#    define CYCLES_COUNTER_ADD1(p) atomic_fetch_and_add_uint32((p), 1)
+#    define CYCLES_COUNTER_SUB1(p) atomic_fetch_and_sub_uint32((p), 1)
+#    define CYCLES_COUNTER_FETCH_INC(p) atomic_fetch_and_add_uint32((p), 1)
+#  endif
+
 #endif /* __KERNEL_GPU__ */
