new file mode 100644
index 0000000..0649495
--- /dev/null
+++ b/intern/cycles/kernel/integrator/intersect_subsurface_dynamic.h
@@ -0,0 +1,153 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Dynamic-fetch version of the intersect_subsurface kernel (CYCLES_SSSDF), Blender 5.3.0: random
+ * walks advance one bounce per step through bvh2df_run_work, and a lane whose walk ends takes the
+ * next path, so warps stay full. Begin, step and end are subsurface_random_walk's own code
+ * (subsurface_walk_steps.h); the rest is subsurface_scatter / integrator_intersect_subsurface,
+ * unchanged. Every walk runs to its end inside the launch. Paths that do not take a random walk
+ * (disk BSSRDF) run the stock kernel body.
+ *
+ * Launch: the host's normal grid, no host change; the last block to finish resets the counter. */
+
+#include "kernel/bvh/bvh2_dynamic.h"
+#include "kernel/integrator/subsurface_walk_steps.h"
+
+CCL_NAMESPACE_BEGIN
+
+#ifdef __SUBSURFACE__
+
+/* subsurface_scatter after subsurface_random_walk returned true. */
+ccl_device_forceinline void subsurface_scatter_exit(KernelGlobals kg,
+                                                    IntegratorState state,
+                                                    ccl_private Ray &ray,
+                                                    const ccl_private Intersection &exit_isect)
+{
+#  ifdef __VOLUME__
+  /* Update volume stack if needed. */
+  if (kernel_data.integrator.use_volumes) {
+    const int object = exit_isect.object;
+    const uint object_flag = kernel_data_fetch(object_flag, object);
+
+    if (object_flag & SD_OBJECT_INTERSECTS_VOLUME) {
+      const float3 P = INTEGRATOR_STATE(state, ray, P);
+
+      integrator_volume_stack_update_for_subsurface(kg, state, P, ray.P);
+    }
+  }
+#  endif /* __VOLUME__ */
+
+  /* Pretend ray is coming from the outside towards the exit point. This ensures
+   * correct front/back facing normals.
+   * TODO: find a more elegant solution? */
+  ray.P += ray.D * ray.tmax * 2.0f;
+  ray.D = -ray.D;
+
+  integrator_state_write_isect(state, &exit_isect);
+  integrator_state_write_ray(state, &ray);
+
+  /* Advance random number offset for bounce. */
+  INTEGRATOR_STATE_WRITE(state, path, rng_offset) += PRNG_BOUNCE_NUM;
+
+  const int shader = intersection_get_shader(kg, &exit_isect);
+  const int shader_flags = kernel_data_fetch(shaders, shader).flags;
+  const uint object_flags = intersection_get_object_flags(kg, &exit_isect);
+  const bool use_caustics = kernel_data.integrator.use_caustics &&
+                            (object_flags & SD_OBJECT_CAUSTICS_RECEIVER);
+  const bool use_raytrace_kernel = (shader_flags & SD_HAS_RAYTRACE);
+
+  if (use_caustics) {
+    integrator_path_next(state,
+                         DEVICE_KERNEL_INTEGRATOR_INTERSECT_SUBSURFACE,
+                         DEVICE_KERNEL_INTEGRATOR_INTERSECT_MNEE);
+  }
+  else if (use_raytrace_kernel) {
+    integrator_path_next_sorted(kg,
+                                state,
+                                DEVICE_KERNEL_INTEGRATOR_INTERSECT_SUBSURFACE,
+                                DEVICE_KERNEL_INTEGRATOR_SHADE_SURFACE_RAYTRACE,
+                                shader);
+  }
+  else {
+    integrator_path_next_sorted(kg,
+                                state,
+                                DEVICE_KERNEL_INTEGRATOR_INTERSECT_SUBSURFACE,
+                                DEVICE_KERNEL_INTEGRATOR_SHADE_SURFACE,
+                                shader);
+  }
+}
+
+struct IntersectSubsurfaceDFWork {
+  const ccl_global int *path_index_array;
+  SSSWalk w;
+  /* 0: walk returned false before its loop, 1: walk loop ended, 2: not a random walk (stock
+   * kernel body). */
+  int status;
+
+  ccl_device_forceinline int state(const int index)
+  {
+    return path_index_array ? path_index_array[index] : index;
+  }
+
+  ccl_device_forceinline bool begin(const int state)
+  {
+    if (!(INTEGRATOR_STATE(state, path, flag) & PATH_RAY_SUBSURFACE_RANDOM_WALK)) {
+      status = 2;
+      return false;
+    }
+    /* subsurface_scatter: rng_state is loaded before the walk, which takes a copy. */
+    path_state_rng_load(state, &w.rng_state);
+    if (!sss_walk_begin(nullptr, state, w)) {
+      status = 0;
+      return false;
+    }
+    status = 1;
+    return true;
+  }
+
+  ccl_device_forceinline bool step(const int state)
+  {
+    return sss_walk_step(nullptr, state, w);
+  }
+
+  ccl_device_forceinline void finish(const int state)
+  {
+    KernelGlobals kg = nullptr;
+    if (status == 2) {
+      integrator_intersect_subsurface(kg, state);
+      return;
+    }
+    if (status == 1 && sss_walk_end(kg, state, w)) {
+      subsurface_scatter_exit(kg, state, w.ray, w.ss_isect.hits[0]);
+      return;
+    }
+    /* integrator_intersect_subsurface after subsurface_scatter returned false. */
+    integrator_path_terminate(kg, state, nullptr, DEVICE_KERNEL_INTEGRATOR_INTERSECT_SUBSURFACE);
+  }
+};
+
+/* [0] the fetch counter, [1] blocks finished in the current launch. */
+extern "C" __device__ uint sssdf_counters[2];
+__device__ uint sssdf_counters[2] = {0, 0};
+
+ccl_device_forceinline void integrator_intersect_subsurface_df(
+    const ccl_global int *path_index_array, const int work_size)
+{
+  IntersectSubsurfaceDFWork work;
+  work.path_index_array = path_index_array;
+  bvh2df_run_work(work, &sssdf_counters[0], work_size);
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    __threadfence();
+    if (atomicAdd(&sssdf_counters[1], 1u) == gridDim.x - 1) {
+      sssdf_counters[0] = 0;
+      sssdf_counters[1] = 0;
+      __threadfence();
+    }
+  }
+}
+
+#endif /* __SUBSURFACE__ */
+
+CCL_NAMESPACE_END
