diff --git a/intern/cycles/kernel/integrator/state_flow.h b/intern/cycles/kernel/integrator/state_flow.h
index b58188b..c2db518 100644
--- a/intern/cycles/kernel/integrator/state_flow.h
+++ b/intern/cycles/kernel/integrator/state_flow.h
@@ -68,10 +68,38 @@ ccl_device_inline void write_optical_depth(KernelGlobals kg,
 
 #ifdef __KERNEL_GPU__
 
+/* Ours, CYCLES_AO_RESERVE: count the paths queued for a surface shading kernel with camera visibility (the only
+ * ones that branch an AO-pass shadow path, integrate_surface_ao), so that the host can reserve one shadow state
+ * per path plus one per counted path. The count goes up when such a path is queued and down when the kernel
+ * starts on it (integrator_shade_surface); visibility is not written in between. */
+#  ifdef CYCLES_AO_RESERVE
+ccl_device_forceinline void integrator_ao_reserve_queue(IntegratorState state,
+                                                        const DeviceKernel next_kernel)
+{
+  if (next_kernel == DEVICE_KERNEL_INTEGRATOR_SHADE_SURFACE ||
+      next_kernel == DEVICE_KERNEL_INTEGRATOR_SHADE_SURFACE_RAYTRACE)
+  {
+    if (INTEGRATOR_STATE(state, path, visibility) & PATH_RAY_VISIBILITY_CAMERA) {
+      CYCLES_COUNTER_ADD1(&kernel_integrator_state.queue_counter->num_camera_surface);
+    }
+  }
+}
+ccl_device_forceinline void integrator_ao_reserve_dequeue(ConstIntegratorState state)
+{
+  if (INTEGRATOR_STATE(state, path, visibility) & PATH_RAY_VISIBILITY_CAMERA) {
+    CYCLES_COUNTER_SUB1(&kernel_integrator_state.queue_counter->num_camera_surface);
+  }
+}
+#    define INTEGRATOR_AO_RESERVE_QUEUE(state, next_kernel) integrator_ao_reserve_queue(state, next_kernel)
+#  else
+#    define INTEGRATOR_AO_RESERVE_QUEUE(state, next_kernel)
+#  endif
+
 ccl_device_forceinline void integrator_path_init(IntegratorState state,
                                                  const DeviceKernel next_kernel)
 {
   CYCLES_COUNTER_ADD1(&kernel_integrator_state.queue_counter->num_queued[next_kernel]);
+  INTEGRATOR_AO_RESERVE_QUEUE(state, next_kernel);
   INTEGRATOR_STATE_WRITE(state, path, queued_kernel) = next_kernel;
 }
 
@@ -81,6 +109,7 @@ ccl_device_forceinline void integrator_path_next(IntegratorState state,
 {
   CYCLES_COUNTER_SUB1(&kernel_integrator_state.queue_counter->num_queued[current_kernel]);
   CYCLES_COUNTER_ADD1(&kernel_integrator_state.queue_counter->num_queued[next_kernel]);
+  INTEGRATOR_AO_RESERVE_QUEUE(state, next_kernel);
   INTEGRATOR_STATE_WRITE(state, path, queued_kernel) = next_kernel;
 }
 
