diff --git a/intern/cycles/kernel/bvh/nodes.h b/intern/cycles/kernel/bvh/nodes.h
index 7063a8b..3554ff6 100644
--- a/intern/cycles/kernel/bvh/nodes.h
+++ b/intern/cycles/kernel/bvh/nodes.h
@@ -39,6 +39,26 @@ ccl_device_forceinline int bvh_aligned_node_intersect(KernelGlobals kg,
   float4 node1 = kernel_data_fetch(bvh_nodes, node_addr + 2);
   float4 node2 = kernel_data_fetch(bvh_nodes, node_addr + 3);
 
+#ifdef CYCLES_BVH_FMA
+  const float pidx = P.x * idir.x, pidy = P.y * idir.y, pidz = P.z * idir.z;
+  float c0lox = fmaf(node0.x, idir.x, -pidx);
+  float c0hix = fmaf(node0.z, idir.x, -pidx);
+  float c0loy = fmaf(node1.x, idir.y, -pidy);
+  float c0hiy = fmaf(node1.z, idir.y, -pidy);
+  float c0loz = fmaf(node2.x, idir.z, -pidz);
+  float c0hiz = fmaf(node2.z, idir.z, -pidz);
+  float c0min = max4(tmin, min(c0lox, c0hix), min(c0loy, c0hiy), min(c0loz, c0hiz));
+  float c0max = min4(tmax, max(c0lox, c0hix), max(c0loy, c0hiy), max(c0loz, c0hiz));
+
+  float c1lox = fmaf(node0.y, idir.x, -pidx);
+  float c1hix = fmaf(node0.w, idir.x, -pidx);
+  float c1loy = fmaf(node1.y, idir.y, -pidy);
+  float c1hiy = fmaf(node1.w, idir.y, -pidy);
+  float c1loz = fmaf(node2.y, idir.z, -pidz);
+  float c1hiz = fmaf(node2.w, idir.z, -pidz);
+  float c1min = max4(tmin, min(c1lox, c1hix), min(c1loy, c1hiy), min(c1loz, c1hiz));
+  float c1max = min4(tmax, max(c1lox, c1hix), max(c1loy, c1hiy), max(c1loz, c1hiz));
+#else
   /* intersect ray against child nodes */
   float c0lox = (node0.x - P.x) * idir.x;
   float c0hix = (node0.z - P.x) * idir.x;
@@ -57,6 +77,7 @@ ccl_device_forceinline int bvh_aligned_node_intersect(KernelGlobals kg,
   float c1hiz = (node2.w - P.z) * idir.z;
   float c1min = max4(tmin, min(c1lox, c1hix), min(c1loy, c1hiy), min(c1loz, c1hiz));
   float c1max = min4(tmax, max(c1lox, c1hix), max(c1loy, c1hiy), max(c1loz, c1hiz));
+#endif
 
   dist[0] = c0min;
   dist[1] = c1min;
