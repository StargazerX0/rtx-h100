+
+#include "util/string.h"
+#include "util/unique_ptr.h"
+
+CCL_NAMESPACE_BEGIN
+
+class Device;
+struct NrcEngine;
+
+/* The engine's plain C interface (nrc/include/cycles_nrc.h). */
+struct NRCEngineAPI {
+  NrcEngine *(*create)(const char *json_config, void *cu_stream) = nullptr;
+  int (*infer)(NrcEngine *, int n, const void *d_inputs, float *d_rgb, void *cu_stream) = nullptr;
+  int (*train)(NrcEngine *,
+               int n,
+               const void *d_inputs,
+               const float *d_target_rgb,
+               int steps,
+               void *cu_stream) = nullptr;
+  void (*destroy)(NrcEngine *) = nullptr;
+};
+
+class PathTraceNRC {
+ public:
+  /* CYCLES_NRC=1. */
+  static bool requested();
+
+  PathTraceNRC(Device *device, DeviceQueue *queue);
+  ~PathTraceNRC();
+
+  /* Allocate for max_num_paths states. False: NRC stays off (cubin without the kernels, engine missing). */
+  bool alloc(int max_num_paths);
+  /* Fill and copy the kernel_nrc constant (scene box from DeviceScene). */
+  void upload(const float bounds[6]);
+
+  void begin_pass();
+  /* Queue the counter read-back; call before the queue synchronizes. */
+  void enqueue_readback();
+  /* After a synchronize: train when enough training paths are done, infer + resolve when the query buffer
+   * is nearly full. */
+  void poll(device_ptr render_buffer);
+  /* After the last path of render_samples: train on what is left, then infer + resolve every query. */
+  void end_pass(device_ptr render_buffer);
+
+ private:
+  void train();
+  void infer(device_ptr render_buffer);
+  bool load_engine();
+  struct NRCControlHost *ctrl();
+
+  Device *device_;
+  DeviceQueue *queue_;
+  bool allocated_ = false;
+  int max_num_paths_ = 0;
+
+  /* Settings (env). */
+  float c_ = 0.01f;
+  int min_bounce_ = 1;
+  int terminate_enabled_ = 1;
+  int skip_singular_ = 1;
+  float train_frac_ = 0.01f;
+  int train_steps_ = 4;
+  int train_slots_ = 65536;
+  int warmup_ = 256;
+  int warmup_steps_ = 16;
+  int num_slots_ = 1 << 18;
+  int record_cap_ = 1 << 18;
+  int query_cap_ = 0;
+  int infer_chunk_ = 1 << 21;
+  int flush_at_ = 0;
+  int stats_ = 0;
+  string engine_name_;
+
+  /* Engine. */
+  NRCEngineAPI api_;
+  NrcEngine *engine_ = nullptr;
+  void *engine_lib_ = nullptr;
+  int stub_mode_ = 1; /* 0: zero cache, 1: hash-grid mean, -1: external engine */
+
+  /* Stats. */
+  int64_t n_train_calls_ = 0, n_steps_ = 0, n_records_ = 0, n_queries_ = 0, n_infer_calls_ = 0;
+  int64_t n_tagged_ = 0, n_dropped_ = 0;
+
+  /* Device memory. */
+  device_vector<uint> ctrl_;
+  device_only_memory<int> main_slot_;
+  device_only_memory<float> main_spread_;
+  device_only_memory<int> shadow_slot_;
+  device_only_memory<uint16_t> query_in_;
+  device_only_memory<uint> query_meta_;
+  device_only_memory<float> query_out_;
+  device_only_memory<int> slots_;
+  device_only_memory<uint16_t> slot_feat_;
+  device_only_memory<float> slot_T_;
+  device_only_memory<float> slot_bins_;
+  device_only_memory<int> done_list_;
+  device_only_memory<uint16_t> rec_in_;
+  device_only_memory<float> rec_target_;
+  device_only_memory<float> rec_T_;
+  device_only_memory<float> stub_table_;
+};
+
+CCL_NAMESPACE_END
