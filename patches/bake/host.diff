diff --git a/intern/cycles/kernel/integrator/permat_prof.h b/intern/cycles/kernel/integrator/permat_prof.h
new file mode 100644
index 0000000..f341ac5
--- /dev/null
+++ b/intern/cycles/kernel/integrator/permat_prof.h
@@ -0,0 +1,131 @@
+/* SPDX-FileCopyrightText: 2026 cycles-h100
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* Per-shader profile of shade_surface (analysis/v53_permat.md).
+ *
+ * GPU: active only with -DCYCLES_PERMAT_PROFILE. Each thread measures clock64() deltas inside
+ * integrate_surface and adds them, with path and closure counts, to the __device__ array
+ * permat_prof[shader][field]. The host (blender-src-v5.3.0-svm, CYCLES_PERMAT_PROFILE=1) reads the array with
+ * cuModuleGetGlobal("permat_prof") before it unloads the module and prints it.
+ * CPU: active when the host sets ccl_permat_prof_cpu (env CYCLES_PERMAT_PROFILE=1); the same fields, rdtsc deltas.
+ * Without the macro (GPU) or the env (CPU) nothing is recorded and the GPU code is unchanged. */
+
+#pragma once
+
+#define PERMAT_MAX_SHADERS 256
+#define PERMAT_FIELDS 64
+#define PERMAT_F_COUNT 0
+#define PERMAT_F_CYC_EVAL 1   /* setup + SVM evaluation */
+#define PERMAT_F_CYC_LIGHT 2  /* closure prepare, holdout, emission, passes, direct light */
+#define PERMAT_F_CYC_BOUNCE 3 /* AO, BSDF/BSSRDF bounce, volume stack, exit */
+#define PERMAT_F_CYC_TOTAL 4
+#define PERMAT_F_CL_SUM 5
+#define PERMAT_F_CL_MIN 6 /* stored as ~min */
+#define PERMAT_F_CL_MAX 7
+#define PERMAT_F_SSS_EXIT 8
+#define PERMAT_F_CL_SQ 9
+#define PERMAT_F_TYPE0 16 /* 16 + ClosureType (< 48) */
+
+#if defined(__KERNEL_GPU__) && defined(CYCLES_PERMAT_PROFILE)
+#  define PERMAT_ACTIVE 1
+extern "C" {
+__device__ unsigned long long permat_prof[PERMAT_MAX_SHADERS * PERMAT_FIELDS];
+}
+#  define PERMAT_TABLE (permat_prof)
+#  define PERMAT_NOW() ((unsigned long long)clock64())
+#  define PERMAT_ADD(p, v) atomicAdd((p), (unsigned long long)(v))
+#  define PERMAT_MAX(p, v) atomicMax((p), (unsigned long long)(v))
+#elif !defined(__KERNEL_GPU__)
+#  define PERMAT_ACTIVE 1
+extern "C" unsigned long long *ccl_permat_prof_cpu;
+#  define PERMAT_TABLE (ccl_permat_prof_cpu)
+#  define PERMAT_NOW() ((unsigned long long)__builtin_ia32_rdtsc())
+#  define PERMAT_ADD(p, v) __atomic_fetch_add((p), (unsigned long long)(v), __ATOMIC_RELAXED)
+#  define PERMAT_MAX(p, v) \
+    { \
+      unsigned long long _v = (v), _o = __atomic_load_n((p), __ATOMIC_RELAXED); \
+      while (_o < _v && \
+             !__atomic_compare_exchange_n((p), &_o, _v, true, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) \
+      { \
+      } \
+    }
+#endif
+
+#ifdef PERMAT_ACTIVE
+CCL_NAMESPACE_BEGIN
+
+struct PermatScope {
+  unsigned long long t0, t1, t2;
+  int shader, ncl, sss_exit;
+  unsigned long long types[2]; /* bit set per closure type seen (one count per evaluation and type) */
+
+  ccl_device_inline_method PermatScope() : t0(PERMAT_NOW()), t1(0), t2(0), shader(-1), ncl(-1), sss_exit(0)
+  {
+    types[0] = types[1] = 0;
+  }
+  ccl_device_inline_method void set_shader(const int s)
+  {
+    shader = s;
+  }
+  /* Right after surface_shader_eval (num_closure is only valid there). */
+  ccl_device_inline_method void mark_closures(const ccl_private ShaderData *sd)
+  {
+    ncl = sd->num_closure;
+    for (int i = 0; i < sd->num_closure; i++) {
+      const int t = int(sd->closure[i].type) & 63;
+      types[t >> 5] |= 1ull << (t & 31);
+    }
+  }
+  ccl_device_inline_method void mark_eval(const uint32_t path_flag)
+  {
+    t1 = PERMAT_NOW();
+    sss_exit = (path_flag & PATH_RAY_SUBSURFACE) ? 1 : 0;
+  }
+  ccl_device_inline_method void mark_light()
+  {
+    t2 = PERMAT_NOW();
+  }
+  ccl_device_inline_method ~PermatScope()
+  {
+    unsigned long long *table = PERMAT_TABLE;
+    if (table == nullptr || shader < 0 || shader >= PERMAT_MAX_SHADERS) {
+      return;
+    }
+    const unsigned long long t3 = PERMAT_NOW();
+    const unsigned long long e = t1 ? t1 : t3;
+    const unsigned long long l = t2 ? t2 : e;
+    unsigned long long *row = table + shader * PERMAT_FIELDS;
+    PERMAT_ADD(row + PERMAT_F_COUNT, 1);
+    PERMAT_ADD(row + PERMAT_F_CYC_EVAL, e - t0);
+    PERMAT_ADD(row + PERMAT_F_CYC_LIGHT, l - e);
+    PERMAT_ADD(row + PERMAT_F_CYC_BOUNCE, t3 - l);
+    PERMAT_ADD(row + PERMAT_F_CYC_TOTAL, t3 - t0);
+    if (ncl >= 0) {
+      PERMAT_ADD(row + PERMAT_F_CL_SUM, ncl);
+      PERMAT_ADD(row + PERMAT_F_CL_SQ, ncl * ncl);
+      PERMAT_MAX(row + PERMAT_F_CL_MIN, ~(unsigned long long)ncl);
+      PERMAT_MAX(row + PERMAT_F_CL_MAX, ncl);
+      PERMAT_ADD(row + PERMAT_F_SSS_EXIT, sss_exit);
+      for (int t = 0; t < 48; t++) {
+        if (types[t >> 5] & (1ull << (t & 31))) {
+          PERMAT_ADD(row + PERMAT_F_TYPE0 + t, 1);
+        }
+      }
+    }
+  }
+};
+
+CCL_NAMESPACE_END
+#  define PERMAT_SCOPE() PermatScope permat_scope
+#  define PERMAT_SET_SHADER(s) permat_scope.set_shader(s)
+#  define PERMAT_MARK_CLOSURES(sd) permat_scope.mark_closures(sd)
+#  define PERMAT_MARK_EVAL(pf) permat_scope.mark_eval(pf)
+#  define PERMAT_MARK_LIGHT() permat_scope.mark_light()
+#else
+#  define PERMAT_SCOPE()
+#  define PERMAT_SET_SHADER(s)
+#  define PERMAT_MARK_CLOSURES(sd)
+#  define PERMAT_MARK_EVAL(pf)
+#  define PERMAT_MARK_LIGHT()
+#endif
