+    r.lo[1] = b.min.y;
+    r.lo[2] = b.min.z;
+    r.hi[0] = b.max.x;
+    r.hi[1] = b.max.y;
+    r.hi[2] = b.max.z;
+    return r;
+  };
+  auto plain = [](const BVHNode *n) {
+    return !n->is_unaligned && n->time_from == 0.0f && n->time_to == 1.0f;
+  };
+  auto add = [&](BVHNode *n) -> int {
+    if (n->is_leaf()) {
+      leaves.push_back(n);
+      t.lbox.push_back(to_box(n->bounds));
+      t.lvis.push_back(n->visibility);
+      return ~int(leaves.size() - 1);
+    }
+    inner.push_back(static_cast<InnerNode *>(n));
+    t.c0.push_back(0);
+    t.c1.push_back(0);
+    t.box.push_back(to_box(n->bounds));
+    t.vis.push_back(n->visibility);
+    t.fixed.push_back(0);
+    return int(inner.size() - 1);
+  };
+  add(root);
+  for (size_t i = 0; i < inner.size(); i++) {
+    InnerNode *n = inner[i];
+    if (n->num_children() != 2 || !plain(n)) {
