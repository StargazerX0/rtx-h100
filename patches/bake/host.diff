+static void sss_log_dump_object(KernelGlobals kg, const int object)
+{
+  static std::mutex mtx;
+  static bool done[65536] = {false};
+  if (object < 0 || object >= 65536) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(mtx);
+  if (done[object]) {
+    return;
+  }
+  done[object] = true;
+  char name[1024];
+  snprintf(name, sizeof(name), "%s/tris_obj%d.bin", sss_log_dir(), object);
+  FILE *f = fopen(name, "wb");
+  if (!f) {
+    return;
+  }
+  const int prim_offset = (int)kernel_data_fetch(object_prim_offset, object);
+  const int num_prims = kernel_data_fetch(objects, object).mesh_volume.num_prims;
+  const int flag = (int)kernel_data_fetch(object_flag, object);
+  const Transform tfm = kernel_data_fetch(objects, object).tfm;
+  const int header[4] = {object, flag, prim_offset, num_prims};
+  fwrite(header, sizeof(int), 4, f);
+  fwrite(&tfm, sizeof(float), 12, f);
