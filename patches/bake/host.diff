+/* Ours (cycles-h100, CYCLES_BVH2_OPTIMIZE; copy of bvhopt/treelet.h). Post-build BVH2 topology optimizer with fixed leaves.
+ *
+ * Treelet restructuring after Karras & Aila 2013 ("Fast parallel construction of high-quality bounding volume
+ * hierarchies"): for every inner node r (children before parents), grow a treelet of up to N leaves by repeatedly
+ * opening the treelet leaf with the largest surface area that is an inner node, then find by dynamic programming over
+ * leaf subsets the binary tree over those leaves with the smallest sum of inner-node surface areas, and rebuild the
+ * treelet if it is cheaper. With the BVH leaves fixed, the leaf term of the SAH is constant, so the sum of inner-node
+ * areas is the whole objective.
+ *
+ * Boxes: every rebuilt inner box is the float min/max union of its children's boxes (the builder's BoundBox::grow), so
+ * no box shrinks below its contents; the treelet root's box is the union of the same leaves, hence unchanged bit for
+ * bit, and nothing above the treelet changes. Visibility is the OR of the children.
+ *
+ * Header-only, no Cycles types. Entities: inner node i >= 0, BVH leaf l encoded as ~l (< 0). Node 0 is the root.
+ * The parallel driver cuts the tree at depth `cut_depth`; the subtrees below the cut are disjoint, so their nodes are
+ * processed in parallel, then the nodes above the cut sequentially. The result does not depend on the thread count.
+ */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace bvhopt {
+
+struct Box {
+  float lo[3], hi[3];
+};
+
+static inline double overlap_half_area(const Box &a, const Box &b)
+{
+  double e[3];
+  for (int k = 0; k < 3; k++) {
+    e[k] = double(std::min(a.hi[k], b.hi[k])) - double(std::max(a.lo[k], b.lo[k]));
+    if (e[k] <= 0.0) {
+      return 0.0;
+    }
+  }
+  return e[0] * e[1] + e[1] * e[2] + e[2] * e[0];
+}
+
+static inline Box box_union(const Box &a, const Box &b)
+{
+  Box r;
+  for (int k = 0; k < 3; k++) {
+    r.lo[k] = std::min(a.lo[k], b.lo[k]);
+    r.hi[k] = std::max(a.hi[k], b.hi[k]);
+  }
+  return r;
+}
+
+static inline double half_area(const Box &b)
+{
+  const double x = std::max(0.0, double(b.hi[0]) - double(b.lo[0]));
+  const double y = std::max(0.0, double(b.hi[1]) - double(b.lo[1]));
+  const double z = std::max(0.0, double(b.hi[2]) - double(b.lo[2]));
+  return x * y + y * z + z * x;
+}
+
+static inline double volume(const Box &b)
+{
+  const double x = std::max(0.0, double(b.hi[0]) - double(b.lo[0]));
+  const double y = std::max(0.0, double(b.hi[1]) - double(b.lo[1]));
+  const double z = std::max(0.0, double(b.hi[2]) - double(b.lo[2]));
+  return x * y * z;
+}
+
+struct Tree {
+  /* Node cost = half area + vol_weight * volume. 0: SAH. For segments of length L in random directions, the measure
+   * of segments that meet a convex box is proportional to V + L*A/4 = V + L*H/2, so vol_weight = 2/L. */
+  double vol_weight = 0.0;
+  /* Extra cost per inner node = overlap_weight * half area of the intersection of its two child boxes. Sibling overlap
+   * makes nearest-first traversal of terminating rays (occluded shadow rays) open both children. 0: off. */
+  double overlap_weight = 0.0;
+  /* Child order of rebuilt nodes. Traversal visits the nearer child first and child 0 on ties (a ray starting inside
+   * both boxes), so the order matters for rays that stop at their first hit. 1: as the builder's splits, the child
+   * with the lower box center on the axis where the centers differ most comes first. 0: DP order. -1: reversed. */
+  int order = 1;
+  double cost(const Box &b) const
+  {
+    return vol_weight > 0.0 ? half_area(b) + vol_weight * volume(b) : half_area(b);
+  }
+  /* inner nodes */
+  std::vector<int> c0, c1;
+  std::vector<Box> box;
+  std::vector<uint32_t> vis;
+  std::vector<uint8_t> fixed; /* 1: never restructure through this node (e.g. unaligned or motion node) */
+  /* leaves */
+  std::vector<Box> lbox;
+  std::vector<uint32_t> lvis;
+
+  int num_inner() const
+  {
+    return int(c0.size());
+  }
+  const Box &ebox(int e) const
+  {
+    return e >= 0 ? box[e] : lbox[~e];
+  }
+  uint32_t evis(int e) const
+  {
+    return e >= 0 ? vis[e] : lvis[~e];
+  }
+};
+
+/* Sum of inner-node half areas (root included). */
+static inline double inner_area_sum(const Tree &t)
+{
+  double s = 0;
+  for (int i = 0; i < t.num_inner(); i++) {
+    s += half_area(t.box[i]);
+  }
+  return s;
+}
+
+/* Recompute every inner box and visibility from the leaves (same topology). Children-first order via post-order. */
+static inline void refit(Tree &t)
+{
+  if (t.num_inner() == 0) {
+    return;
+  }
+  std::vector<int> order;
+  order.reserve(t.num_inner());
+  std::vector<std::pair<int, int>> st;
+  st.push_back({0, 0});
+  while (!st.empty()) {
+    auto &f = st.back();
+    if (f.second < 2) {
+      const int c = f.second++ == 0 ? t.c0[f.first] : t.c1[f.first];
+      if (c >= 0) {
+        st.push_back({c, 0});
+      }
+    }
+    else {
+      order.push_back(f.first);
+      st.pop_back();
+    }
+  }
+  for (int i : order) {
+    t.box[i] = box_union(t.ebox(t.c0[i]), t.ebox(t.c1[i]));
+    t.vis[i] = t.evis(t.c0[i]) | t.evis(t.c1[i]);
+  }
+}
+
+struct Scratch {
+  Box sbox[128];
+  double area[128];
+  double cost[128];
+  uint8_t split[128];
+  int leaves[8];
+  int inner[8];
+  int next_inner;
+};
+
+template<int N> static int treelet_rebuild(Tree &t, Scratch &s, int mask, int full, int r)
+{
+  if ((mask & (mask - 1)) == 0) {
+    int b = 0;
+    while (!(mask >> b & 1)) {
+      b++;
+    }
+    return s.leaves[b];
+  }
+  const int id = (mask == full) ? r : s.inner[s.next_inner++];
+  const int p = s.split[mask];
+  const int a = treelet_rebuild<N>(t, s, p, full, r);
+  const int b = treelet_rebuild<N>(t, s, mask ^ p, full, r);
+  bool swap = false;
+  if (t.order != 0) {
+    const Box &ba = t.ebox(a), &bb = t.ebox(b);
+    int axis = 0;
+    double best = -1.0;
+    for (int k = 0; k < 3; k++) {
+      const double d = std::abs((double(ba.lo[k]) + double(ba.hi[k])) - (double(bb.lo[k]) + double(bb.hi[k])));
+      if (d > best) {
+        best = d;
+        axis = k;
+      }
+    }
+    const double ca = double(ba.lo[axis]) + double(ba.hi[axis]), cb = double(bb.lo[axis]) + double(bb.hi[axis]);
+    swap = (t.order > 0) ? (cb < ca) : (ca < cb);
+  }
+  t.c0[id] = swap ? b : a;
+  t.c1[id] = swap ? a : b;
+  t.box[id] = box_union(t.ebox(a), t.ebox(b));
+  t.vis[id] = t.evis(a) | t.evis(b);
+  return id;
+}
+
+/* Restructure the treelet rooted at r. Returns 1 if it was rebuilt. */
+template<int N> static int treelet_optimize(Tree &t, Scratch &s, int r, double rel_eps)
+{
+  if (t.fixed[r]) {
+    return 0;
+  }
+  int n = 2, ni = 1;
+  s.leaves[0] = t.c0[r];
+  s.leaves[1] = t.c1[r];
+  s.inner[0] = r;
+  double old_cost = t.cost(t.box[r]);
+  while (n < N) {
+    int best = -1;
+    double best_a = -1;
+    for (int i = 0; i < n; i++) {
+      const int e = s.leaves[i];
+      if (e >= 0 && !t.fixed[e]) {
+        const double a = t.cost(t.box[e]);
+        if (a > best_a) {
+          best_a = a;
+          best = i;
+        }
+      }
+    }
+    if (best < 0) {
+      break;
+    }
+    const int e = s.leaves[best];
+    s.inner[ni++] = e;
+    old_cost += best_a;
+    s.leaves[best] = t.c0[e];
+    s.leaves[n++] = t.c1[e];
+  }
+  if (n < 3) {
+    return 0;
+  }
+  if (t.overlap_weight > 0.0) {
+    for (int i = 0; i < ni; i++) {
+      old_cost += t.overlap_weight * overlap_half_area(t.ebox(t.c0[s.inner[i]]), t.ebox(t.c1[s.inner[i]]));
+    }
+  }
+  const int full = (1 << n) - 1;
+  for (int i = 0; i < n; i++) {
+    s.sbox[1 << i] = t.ebox(s.leaves[i]);
+    s.cost[1 << i] = 0;
+  }
+  for (int m = 1; m <= full; m++) {
+    if ((m & (m - 1)) == 0) {
+      continue;
+    }
+    const int low = m & -m;
+    s.sbox[m] = box_union(s.sbox[m ^ low], s.sbox[low]);
+    s.area[m] = t.cost(s.sbox[m]);
+  }
+  /* masks in increasing order: every proper subset is smaller than its superset */
+  for (int m = 1; m <= full; m++) {
+    if ((m & (m - 1)) == 0) {
+      continue;
+    }
+    const int low = m & -m;
+    double best = INFINITY;
+    int bp = 0;
+    /* partitions {p, m^p} with the lowest bit in p, p != m */
+    const int rest = m ^ low;
+    for (int q = (rest - 1) & rest;; q = (q - 1) & rest) {
+      const int p = q | low;
+      double c = s.cost[p] + s.cost[m ^ p];
+      if (t.overlap_weight > 0.0) {
+        c += t.overlap_weight * overlap_half_area(s.sbox[p], s.sbox[m ^ p]);
+      }
+      if (c < best) {
+        best = c;
+        bp = p;
+      }
+      if (q == 0) {
+        break;
+      }
+    }
+    s.cost[m] = s.area[m] + best;
+    s.split[m] = uint8_t(bp);
+  }
+  if (!(s.cost[full] < old_cost * (1.0 - rel_eps))) {
+    return 0;
+  }
+  s.next_inner = 1;
+  treelet_rebuild<N>(t, s, full, full, r);
+  return 1;
+}
+
+static inline void post_order(const Tree &t, int root, int depth0, int cut_depth, std::vector<int> &out,
+                              std::vector<int> *cut_roots)
+{
+  std::vector<std::pair<int, int>> st; /* node, state; depth tracked in a parallel stack */
+  std::vector<int> dep;
+  st.push_back({root, 0});
+  dep.push_back(depth0);
+  while (!st.empty()) {
+    const int node = st.back().first;
+    const int d = dep.back();
+    if (cut_roots && d == cut_depth) {
+      cut_roots->push_back(node);
+      st.pop_back();
+      dep.pop_back();
+      continue;
+    }
+    int &state = st.back().second;
+    if (state < 2) {
+      const int c = state++ == 0 ? t.c0[node] : t.c1[node];
+      if (c >= 0) {
+        st.push_back({c, 0});
+        dep.push_back(d + 1);
+      }
+    }
+    else {
+      out.push_back(node);
+      st.pop_back();
+      dep.pop_back();
+    }
+  }
+}
+
+/* passes: number of sweeps; N: treelet leaves (5..7). ParallelFor(n, fn(i)) runs fn for i in [0, n). */
+template<int N, class ParallelFor>
+static long long optimize(Tree &t, int passes, ParallelFor &&pfor, int cut_depth = 12, double rel_eps = 1e-6)
+{
+  static_assert(N >= 3 && N <= 7, "treelet size");
+  if (t.num_inner() < 2) {
+    return 0;
+  }
+  long long rebuilt = 0;
+  for (int pass = 0; pass < passes; pass++) {
+    std::vector<int> top, cuts;
+    post_order(t, 0, 0, cut_depth, top, &cuts);
+    std::vector<long long> per(cuts.size(), 0);
+    pfor(int(cuts.size()), [&](int i) {
+      std::vector<int> order;
+      post_order(t, cuts[i], 0, -1, order, nullptr);
+      Scratch s;
+      long long k = 0;
+      for (int node : order) {
+        k += treelet_optimize<N>(t, s, node, rel_eps);
+      }
+      per[i] = k;
+    });
+    Scratch s;
+    for (int node : top) {
+      rebuilt += treelet_optimize<N>(t, s, node, rel_eps);
+    }
+    for (long long k : per) {
+      rebuilt += k;
+    }
+  }
+  return rebuilt;
+}
+
+}  // namespace bvhopt
