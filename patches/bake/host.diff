new file mode 100644
index 0000000..589cfff
--- /dev/null
+++ b/intern/cycles/scene/svm_specialize.cpp
@@ -0,0 +1,307 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+/* Ours: SVM specialization (port of the 4.5.0 final4 selective specialization to 5.3.0).
+ *
+ * The scene's SVM program (svm_nodes: a jump table of NODE_SHADER_JUMP entries, then each shader's nodes, each node
+ * a type word followed by its SVMNode* struct words) is cut into programs, one per entry offset of the jump table.
+ * A program is the list of instructions (node offsets recorded by SVMCompiler::add_node) from the entry to its
+ * NODE_END. For each supported program the generated header has one function that calls svm_eval_node<..., type>
+ * per instruction with an SVMStaticReader<pc>, whose words are constants, so the node handler folds; jumps become
+ * gotos. A node that leaves an offset other than the next instruction hands over to the interpreter at that
+ * offset. The kernel only runs the generated code when kernel_data.image.pad1..3 hold this program's key. */
+
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <set>
+#include <sstream>
+
+#include "scene/devicescene.h"
+#include "scene/svm_specialize.h"
+
+#include "kernel/svm/node_types.h"
+#include "kernel/svm/types.h"
+
+#include "util/md5.h"
+#include "util/path.h"
+
+CCL_NAMESPACE_BEGIN
+
+bool svm_specialization_enabled()
+{
+  const char *enabled = getenv("CYCLES_SVM_SPECIALIZE");
+  return enabled && string(enabled) == "1";
+}
+
+static const char *svm_node_type_name(const uint type)
+{
+  static const char *names[] = {
+#define SHADER_NODE_TYPE(name) #name,
+#define SHADER_NODE_TYPE_DERIVATIVE(name) #name, #name "_DERIVATIVE",
+#include "kernel/svm/node_types_template.h"
+  };
+  return type < sizeof(names) / sizeof(*names) ? names[type] : nullptr;
+}
+
+void svm_specialize(DeviceScene *dscene, const int num_shaders, const vector<int> &instructions)
+{
+  const int *nodes = reinterpret_cast<const int *>(dscene->svm_nodes.data());
+  const int size = dscene->svm_nodes.size();
+  const int jump_node_size = 1 + sizeof(SVMNodeShaderJump) / sizeof(int);
+  const int jump_if_size = 1 + sizeof(SVMNodeJumpIfZero) / sizeof(int);
+  static_assert(sizeof(SVMNodeJumpIfZero) == sizeof(SVMNodeJumpIfOne));
+
+  MD5Hash hash;
+  hash.append(reinterpret_cast<const uint8_t *>(nodes), size * sizeof(int));
+  hash.append(reinterpret_cast<const uint8_t *>(instructions.data()),
+              instructions.size() * sizeof(int));
+  const string digest = hash.get_hex();
+  uint key[3];
+  for (int i = 0; i < 3; i++) {
+    key[i] = uint(strtoul(digest.substr(8 * i, 8).c_str(), nullptr, 16));
+  }
+  /* KernelImage's padding (unused by stock 5.3.0) carries the key, so KernelData keeps its stock layout. */
+  dscene->data.image.pad1 = int(key[0]);
+  dscene->data.image.pad2 = int(key[1]);
+  dscene->data.image.pad3 = int(key[2]);
+
+  const char *dump = getenv("CYCLES_SVM_DUMP");
+  const char *selection = getenv("CYCLES_SVM_SELECTIVE");
+  const bool selective = selection && string(selection) == "1";
+
+  /* next[pc]: the offset of the instruction after pc (the end of pc's struct and data words). */
+  std::map<int, int> next;
+  for (size_t i = 0; i < instructions.size(); i++) {
+    next[instructions[i]] = i + 1 < instructions.size() ? instructions[i + 1] : size;
+  }
+  std::set<int> starts;
+  for (int i = 0; i < num_shaders; i++) {
+    const SVMNodeShaderJump &jump = *reinterpret_cast<const SVMNodeShaderJump *>(
+        &nodes[i * jump_node_size + 1]);
+    starts.insert(jump.offset_surface);
+    starts.insert(jump.offset_volume);
+    starts.insert(jump.offset_displacement);
+  }
+
+  std::map<int, vector<int>> programs;
+  std::ostringstream costs;
+  costs << "start,instructions,image_2d,image_box,procedural,bump,closures,selected,reason\n";
+  int covered = 0, fallbacks = 0, policy_fallbacks = 0;
+  for (const int start : starts) {
+    vector<int> program;
+    const char *reason = nullptr;
+    if (!next.count(start)) {
+      reason = "not_an_instruction";
+    }
+    for (auto it = next.find(start); !reason && it != next.end(); ++it) {
+      const int pc = it->first;
+      const uint type = uint(nodes[pc]);
+      program.push_back(pc);
+      if (type >= NODE_NONE || type == NODE_SHADER_JUMP) {
+        reason = "unsupported_node";
+      }
+      else if (type == NODE_RAYCAST) {
+        /* Reads the NODE_ATTR instructions after it as its own data. */
+        reason = "raycast";
+      }
+      else if (type == NODE_JUMP_IF_ZERO || type == NODE_JUMP_IF_ONE) {
+        const int target = pc + jump_if_size + nodes[pc + 1];
+        if (it->second != pc + jump_if_size || target <= pc || !next.count(target)) {
+          reason = "jump";
+        }
+      }
+      else if (type == NODE_END) {
+        break;
+      }
+    }
+    if (!reason && (program.empty() || nodes[program.back()] != NODE_END)) {
+      reason = "no_end";
+    }
+    if (!reason) {
+      /* Every jump must land inside this program. */
+      const std::set<int> in_program(program.begin(), program.end());
+      for (const int pc : program) {
+        if ((nodes[pc] == NODE_JUMP_IF_ZERO || nodes[pc] == NODE_JUMP_IF_ONE) &&
+            !in_program.count(pc + jump_if_size + nodes[pc + 1]))
+        {
+          reason = "jump";
+        }
+      }
+    }
+    if (reason) {
+      ++fallbacks;
+      costs << start << ',' << program.size() << ",,,,,,0," << reason << '\n';
+      continue;
+    }
+    int images = 0, boxes = 0, procedural = 0, bump = 0, closures = 0;
+    for (const int pc : program) {
+      switch (nodes[pc]) {
+        case NODE_TEX_IMAGE:
+        case NODE_TEX_IMAGE_DERIVATIVE:
+          ++images;
+          break;
+        case NODE_TEX_IMAGE_BOX:
+        case NODE_TEX_IMAGE_BOX_DERIVATIVE:
+          ++boxes;
+          break;
+        case NODE_SET_BUMP:
+          ++bump;
+          break;
+        case NODE_CLOSURE_BSDF:
+          ++closures;
+          break;
+        case NODE_TEX_NOISE:
+        case NODE_TEX_VORONOI:
+        case NODE_TEX_GABOR:
+        case NODE_TEX_WAVE:
+        case NODE_TEX_MAGIC:
+        case NODE_TEX_BRICK:
+        case NODE_TEX_CHECKER:
+        case NODE_TEX_WHITE_NOISE:
+          ++procedural;
+          break;
+        default:
+          break;
+      }
+    }
+    /* 4.5.0 policy: image-textured programs with at most one BSDF stay on the interpreter. */
+    const bool texture_chain = images > 0 && boxes == 0 && procedural == 0 && bump == 0 &&
+                               closures <= 1;
+    const bool selected = !selective || !texture_chain;
+    costs << start << ',' << program.size() << ',' << images << ',' << boxes << ',' << procedural
+          << ',' << bump << ',' << closures << ',' << int(selected) << ','
+          << (selected ? "selected" : "image_single_bsdf") << '\n';
+    if (!selected) {
+      ++policy_fallbacks;
+      continue;
+    }
+    covered += program.size();
+    programs[start] = std::move(program);
+  }
+
+  printf(
+      "SVM_SPECIALIZE shaders=%d programs=%zu instructions=%zu words=%d covered=%d fallbacks=%d "
+      "policy_fallbacks=%d selective=%d key=%08x%08x%08x\n",
+      num_shaders,
+      programs.size(),
+      instructions.size(),
+      size,
+      covered,
+      fallbacks,
+      policy_fallbacks,
+      int(selective),
+      key[0],
+      key[1],
+      key[2]);
+  fflush(stdout);
+  if (!dump) {
+    return;
+  }
+
+  std::ostringstream out;
+  out << "/* Generated by Cycles scene/svm_specialize.cpp (CYCLES_SVM_DUMP). */\n#pragma once\n";
+  out << "#define CYCLES_SVM_SPECIALIZATION_KEY_0 " << key[0] << "u\n"
+      << "#define CYCLES_SVM_SPECIALIZATION_KEY_1 " << key[1] << "u\n"
+      << "#define CYCLES_SVM_SPECIALIZATION_KEY_2 " << key[2] << "u\n";
+  /* Node words of every instruction of a generated program. */
+  for (const auto &[start, program] : programs) {
+    for (const int pc : program) {
+      const uint type = uint(nodes[pc]);
+      if (type == NODE_END || type == NODE_JUMP_IF_ZERO || type == NODE_JUMP_IF_ONE) {
+        continue;
+      }
+      out << "template<> ccl_device_forceinline uint SVMStaticReader<" << pc
+          << ">::word(const int i)\n{\n  switch (i) {\n";
+      for (int j = pc + 1; j < next[pc]; j++) {
+        out << "    case " << j << ": return " << uint(nodes[j]) << "u;\n";
+      }
+      out << "    default: return kernel_data_fetch(svm_nodes, i);\n  }\n}\n";
+    }
+  }
+  const char *parameters =
+      "KernelGlobals kg, ConstIntegratorGenericState state, ccl_private ShaderData *sd, "
+      "ccl_global float *render_buffer, const PathRayVisibility path_visibility, "
+      "const uint32_t path_flag";
+  const char *arguments = "kg, state, sd, render_buffer, path_visibility, path_flag";
+  for (const auto &[start, program] : programs) {
+    out << "template<uint64_t node_feature_mask, ShaderType type, typename "
+           "ConstIntegratorGenericState>\nccl_device_noinline void svm_specialized_"
+        << start << "(" << parameters << ")\n{\n";
+    if (program.size() == 1) {
+      out << "  return;\n}\n";
+      continue;
+    }
+    out << "  float stack[SVM_STACK_SIZE];\n  Spectrum closure_weight = zero_spectrum();\n";
+    std::set<int> labels;
+    for (const int pc : program) {
+      if (nodes[pc] == NODE_JUMP_IF_ZERO || nodes[pc] == NODE_JUMP_IF_ONE) {
+        labels.insert(pc + jump_if_size + nodes[pc + 1]);
+      }
+    }
+    for (const int pc : program) {
+      const uint type = uint(nodes[pc]);
+      if (labels.count(pc)) {
+        out << "L" << pc << ":\n";
+      }
+      if (type == NODE_END) {
+        out << "  return;\n";
+        continue;
+      }
+      if (type == NODE_JUMP_IF_ZERO || type == NODE_JUMP_IF_ONE) {
+        const SVMNodeJumpIfZero &jump = *reinterpret_cast<const SVMNodeJumpIfZero *>(
+            &nodes[pc + 1]);
+        out << "  if (stack_load_float(stack, " << uint(jump.stack_offset) << ") "
+            << (type == NODE_JUMP_IF_ZERO ? "<= 0.0f" : ">= 1.0f") << ") {\n    goto L"
+            << pc + jump_if_size + jump.jump_offset << ";\n  }\n";
+        continue;
+      }
+      out << "  {\n    int offset = " << pc + 1 << ";\n"
+          << "    if (svm_eval_node<node_feature_mask, type, " << svm_node_type_name(type)
+          << ">(SVMStaticReader<" << pc << ">{kg}, state, sd, render_buffer, path_visibility, "
+          << "path_flag, stack, closure_weight, " << svm_node_type_name(type) << ", offset)) {\n"
+          << "      return;\n    }\n"
+          << "    if (offset != " << next[pc] << ") {\n"
+          << "      svm_eval_nodes_generic<node_feature_mask, type>(kg, state, sd, render_buffer, "
+             "path_visibility, path_flag, stack, closure_weight, offset);\n"
+          << "      return;\n    }\n  }\n";
+    }
+    out << "}\n";
+  }
+  out << "template<uint64_t node_feature_mask, ShaderType type, typename "
+         "ConstIntegratorGenericState>\nccl_device_forceinline bool svm_try_specialized("
+      << parameters << ")\n{\n"
+      << "  if (uint(kernel_data.image.pad1) != CYCLES_SVM_SPECIALIZATION_KEY_0 ||\n"
+         "      uint(kernel_data.image.pad2) != CYCLES_SVM_SPECIALIZATION_KEY_1 ||\n"
+         "      uint(kernel_data.image.pad3) != CYCLES_SVM_SPECIALIZATION_KEY_2)\n  {\n"
+         "    return false;\n  }\n";
+  const char *types[] = {"SHADER_TYPE_SURFACE", "SHADER_TYPE_VOLUME", "SHADER_TYPE_DISPLACEMENT"};
+  for (int kind = 0; kind < 3; kind++) {
+    out << "  " << (kind ? "else " : "") << "if constexpr (type == " << types[kind]
+        << ") {\n    switch (sd->shader & SHADER_MASK) {\n";
+    for (int shader = 0; shader < num_shaders; shader++) {
+      const SVMNodeShaderJump &jump = *reinterpret_cast<const SVMNodeShaderJump *>(
+          &nodes[shader * jump_node_size + 1]);
+      const int start = kind == 0 ? jump.offset_surface :
+                        kind == 1 ? jump.offset_volume :
+                                    jump.offset_displacement;
+      if (programs.count(start)) {
+        out << "      case " << shader << ":\n        svm_specialized_" << start
+            << "<node_feature_mask, type>(" << arguments << ");\n        return true;\n";
+      }
+    }
+    out << "      default:\n        return false;\n    }\n  }\n";
+  }
+  out << "  return false;\n}\n";
+
+  path_create_directories(path_join(dump, "svm_specialized.h"));
+  path_write_text(path_join(dump, "svm_specialized.h"), out.str());
+  std::ostringstream manifest;
+  manifest << "shaders " << num_shaders << "\nprograms " << programs.size() << "\ninstructions "
+           << instructions.size() << "\nwords " << size << "\ncovered " << covered
+           << "\nfallbacks " << fallbacks << "\npolicy_fallbacks " << policy_fallbacks
+           << "\nselective " << int(selective) << "\nkey " << digest.substr(0, 24) << "\n";
+  path_write_text(path_join(dump, "manifest.txt"), manifest.str());
+  path_write_text(path_join(dump, "program_costs.csv"), costs.str());
+}
+
+CCL_NAMESPACE_END
