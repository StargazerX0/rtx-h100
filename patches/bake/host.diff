+NRCControlHost *PathTraceNRC::ctrl()
+{
+  return reinterpret_cast<NRCControlHost *>(ctrl_.data());
+}
+
+bool PathTraceNRC::load_engine()
+{
+  void *stream = queue_->nrc_stream();
+  if (engine_name_ == "stub" || engine_name_ == "zero") {
+    stub_mode_ = (engine_name_ == "stub") ? 1 : 0;
+    return true;
+  }
+  stub_mode_ = -1;
+  engine_lib_ = dlopen(engine_name_.c_str(), RTLD_NOW | RTLD_LOCAL);
+  if (!engine_lib_) {
+    LOG_ERROR << "NRC: dlopen " << engine_name_ << " failed: " << dlerror();
+    return false;
+  }
+  api_.create = (decltype(api_.create))dlsym(engine_lib_, "nrc_create");
+  api_.infer = (decltype(api_.infer))dlsym(engine_lib_, "nrc_infer");
+  api_.train = (decltype(api_.train))dlsym(engine_lib_, "nrc_train");
+  api_.destroy = (decltype(api_.destroy))dlsym(engine_lib_, "nrc_destroy");
+  if (!api_.create || !api_.infer || !api_.train || !api_.destroy) {
+    LOG_ERROR << "NRC: " << engine_name_ << " lacks the nrc_* symbols";
+    return false;
+  }
+  /* Default config: EMA 0.95 instead of the engine's 0.99 (A40: 0.99 lags the cold start, cache 2.5-7% low
+   * after ~300 steps), and the engine workspace sized to our largest calls (growth would sync the device). */
+  const int train_batch = (((record_cap_ + min(train_steps_, warmup_steps_) - 1) /
+                            min(train_steps_, warmup_steps_)) +
+                           255) &
+                          ~255;
+  string config = string_printf(
+      "{\"optimizer\": {\"otype\": \"EMA\", \"decay\": 0.95, \"nested\": {\"otype\": \"Adam\", "
+      "\"learning_rate\": 1e-2, \"beta1\": 0.9, \"beta2\": 0.99, \"epsilon\": 1e-15, \"l2_reg\": 1e-6}}, "
+      "\"nrc\": {\"warmup_infer_batch\": %d, \"warmup_train_batch\": %d}}",
+      infer_chunk_,
+      train_batch);
+  if (const char *path = getenv("CYCLES_NRC_CONFIG")) {
+    std::ifstream f(path);
+    if (f) {
+      std::stringstream ss;
+      ss << f.rdbuf();
+      config = ss.str();
+    }
+    else {
+      LOG_ERROR << "NRC: cannot read CYCLES_NRC_CONFIG " << path;
+    }
+  }
+  queue_->run_in_context([&]() { engine_ = api_.create(config.c_str(), stream); });
+  if (!engine_) {
+    LOG_ERROR << "NRC: nrc_create failed";
+    return false;
+  }
+  return true;
+}
+
+bool PathTraceNRC::alloc(const int max_num_paths)
+{
+  if (allocated_ && max_num_paths == max_num_paths_) {
+    return true;
+  }
+  if (!queue_->has_named_kernel("kernel_gpu_nrc_resolve") || !queue_->nrc_stream()) {
+    LOG_ERROR << "NRC: CYCLES_NRC=1 but the cubin has no NRC kernels (build it with -DCYCLES_NRC) or the "
+                 "device is not CUDA; NRC off";
+    return false;
+  }
+  if (!allocated_ && !load_engine()) {
+    return false;
+  }
+  max_num_paths_ = max_num_paths;
+  query_cap_ = env_int("CYCLES_NRC_QUERY_CAP", max(2 * max_num_paths, 1 << 20));
+  query_cap_ = max(query_cap_, max_num_paths + 1024);
+  query_cap_ = (query_cap_ + 255) & ~255;
+  flush_at_ = query_cap_ - max_num_paths;
+
+  const size_t nv = CYCLES_NRC_NV;
+  ctrl_.alloc(12);
+  main_slot_.alloc_to_device(max_num_paths);
+  main_spread_.alloc_to_device(size_t(max_num_paths) * 2);
+  shadow_slot_.alloc_to_device(max_num_paths);
+  query_in_.alloc_to_device(size_t(query_cap_) * NRC_IN_FEATURES);
+  query_meta_.alloc_to_device(size_t(query_cap_) * 4);
+  query_out_.alloc_to_device(size_t(query_cap_) * 3);
+  slots_.alloc_to_device(size_t(num_slots_) * 4);
+  slot_feat_.alloc_to_device(size_t(num_slots_) * nv * NRC_IN_FEATURES);
+  slot_T_.alloc_to_device(size_t(num_slots_) * nv * 3);
+  slot_bins_.alloc_to_device(size_t(num_slots_) * nv * 3);
+  done_list_.alloc_to_device(num_slots_);
+  rec_in_.alloc_to_device(size_t(record_cap_) * NRC_IN_FEATURES);
+  rec_target_.alloc_to_device(size_t(record_cap_) * 3);
+  rec_T_.alloc_to_device(size_t(record_cap_) * 3);
+  if (stub_mode_ == 1) {
+    stub_table_.alloc_to_device(size_t(8) << env_int("CYCLES_NRC_STUB_LOG2", 22));
+    queue_->zero_to_device(stub_table_);
+  }
+  queue_->zero_to_device(slots_);
+  memset(ctrl_.data(), 0, sizeof(NRCControl));
+  ctrl()->train = 1;
+  ctrl()->terminate = (terminate_enabled_ && warmup_ == 0) ? 1 : 0;
+  queue_->copy_to_device(ctrl_);
+  queue_->synchronize();
+  allocated_ = true;
+
+  LOG_INFO << "NRC: on, engine " << engine_name_ << ", " << max_num_paths << " states, query cap "
+           << query_cap_ << ", slots " << num_slots_ << ", c " << c_ << ", train frac " << train_frac_;
+  if (stats_) {
+    fprintf(stderr,
+            "NRC: on, engine %s, states %d, query cap %d (flush at %d), slots %d, records %d, c %g, "
+            "min bounce %d, term %d, train frac %g, steps %d, train slots %d, warmup %d\n",
+            engine_name_.c_str(),
+            max_num_paths,
+            query_cap_,
+            flush_at_,
+            num_slots_,
+            record_cap_,
+            c_,
+            min_bounce_,
+            terminate_enabled_,
+            train_frac_,
+            train_steps_,
+            train_slots_,
+            warmup_);
+  }
+  return true;
+}
+
+void PathTraceNRC::upload(const float bounds[6])
+{
+  if (!allocated_) {
+    return;
+  }
+  KernelNRC k;
+  memset(&k, 0, sizeof(k));
+  k.enabled = 1;
+  k.min_bounce = min_bounce_;
+  k.c = c_;
+  k.skip_singular = skip_singular_;
+  k.train_threshold = (uint)min(double(train_frac_) * 4294967296.0, 4294967295.0);
+  k.num_slots = num_slots_;
+  k.query_cap = query_cap_;
+  k.record_cap = record_cap_;
+  float lo[3] = {bounds[0], bounds[1], bounds[2]}, hi[3] = {bounds[3], bounds[4], bounds[5]};
+  if (const char *b = getenv("CYCLES_NRC_BOUNDS")) {
+    sscanf(b, "%f,%f,%f,%f,%f,%f", &lo[0], &lo[1], &lo[2], &hi[0], &hi[1], &hi[2]);
+  }
+  for (int i = 0; i < 3; i++) {
+    float ext = hi[i] - lo[i];
+    if (!(ext > 1e-6f)) {
+      ext = 1.0f;
+    }
+    k.box_lo[i] = lo[i] - 0.01f * ext;
+    k.box_scale[i] = 1.0f / (1.02f * ext);
+  }
+  k.stub_log2 = env_int("CYCLES_NRC_STUB_LOG2", 22);
+  k.stub_res = env_int("CYCLES_NRC_STUB_RES", 32);
+  k.stub_dir = env_int("CYCLES_NRC_STUB_DIR", 0);
+  k.budget_feature = env_int("CYCLES_NRC_BUDGET", 1);
+  k.train_match = env_int("CYCLES_NRC_TRAIN_MATCH", 0);
+  k.train_weight = env_int("CYCLES_NRC_TRAIN_WEIGHT", 1);
+  k.diffuse_only = env_int("CYCLES_NRC_DIFFUSE_ONLY", 0);
+#define NRC_PTR(field, mem) k.field = reinterpret_cast<decltype(k.field)>(mem.device_pointer)
+  NRC_PTR(ctrl, ctrl_);
+  NRC_PTR(main_slot, main_slot_);
+  NRC_PTR(main_spread, main_spread_);
+  NRC_PTR(shadow_slot, shadow_slot_);
+  NRC_PTR(query_in, query_in_);
+  NRC_PTR(query_meta, query_meta_);
+  NRC_PTR(query_out, query_out_);
+  NRC_PTR(slots, slots_);
+  NRC_PTR(slot_feat, slot_feat_);
+  NRC_PTR(slot_T, slot_T_);
+  NRC_PTR(slot_bins, slot_bins_);
+  NRC_PTR(done_list, done_list_);
+  NRC_PTR(rec_in, rec_in_);
+  NRC_PTR(rec_target, rec_target_);
+  NRC_PTR(rec_T, rec_T_);
+  NRC_PTR(stub_table, stub_table_);
+#undef NRC_PTR
+  queue_->synchronize();
+  device_->const_copy_to("kernel_nrc", &k, sizeof(k));
+  if (stats_) {
+    fprintf(stderr,
+            "NRC: box lo %g %g %g extent %g %g %g\n",
+            k.box_lo[0],
+            k.box_lo[1],
+            k.box_lo[2],
+            1.0f / k.box_scale[0],
+            1.0f / k.box_scale[1],
+            1.0f / k.box_scale[2]);
+  }
+}
+
+void PathTraceNRC::begin_pass()
+{
+  if (!allocated_) {
+    return;
+  }
+  /* Every path of the previous pass has ended (or the pass was cancelled): free every slot. */
+  queue_->zero_to_device(slots_);
+  NRCControlHost *c = ctrl();
+  c->query_count = 0;
+  c->done_count = 0;
+  c->record_count = 0;
+  c->train = (train_frac_ > 0.0f) ? 1 : 0;
+  queue_->copy_to_device(ctrl_);
+}
+
+void PathTraceNRC::enqueue_readback()
+{
+  if (allocated_) {
+    queue_->copy_from_device(ctrl_);
+  }
+}
+
+void PathTraceNRC::poll(const device_ptr render_buffer)
+{
+  if (!allocated_) {
+    return;
+  }
+  if (ctrl()->done_count >= uint(train_slots_)) {
+    train();
+  }
+  if (ctrl()->query_count >= uint(flush_at_)) {
+    infer(render_buffer);
+  }
+}
+
+void PathTraceNRC::end_pass(const device_ptr render_buffer)
+{
+  if (!allocated_) {
+    return;
+  }
+  queue_->copy_from_device(ctrl_);
+  queue_->synchronize();
+  if (ctrl()->done_count > 0) {
+    train();
+  }
+  if (ctrl()->query_count > 0) {
+    infer(render_buffer);
+  }
+  if (stats_) {
+    fprintf(stderr,
+            "NRC pass: tagged %u, train calls %lld, steps %lld, records %lld, infer calls %lld, "
+            "queries %lld, dropped %u, terminate %d\n",
+            ctrl()->tagged,
+            (long long)n_train_calls_,
+            (long long)n_steps_,
+            (long long)n_records_,
+            (long long)n_infer_calls_,
+            (long long)n_queries_,
+            ctrl()->dropped_queries,
+            ctrl()->terminate);
+  }
+  n_tagged_ += ctrl()->tagged;
+  n_dropped_ += ctrl()->dropped_queries;
+  ctrl()->tagged = 0;
+  ctrl()->dropped_queries = 0;
+  queue_->copy_to_device(ctrl_);
+}
+
+void PathTraceNRC::train()
+{
+  NRCControlHost *c = ctrl();
+  int n_done = int(c->done_count);
+  queue_->enqueue_named("kernel_gpu_nrc_collect", n_done, DeviceKernelArguments(&n_done));
+  queue_->copy_from_device(ctrl_);
+  queue_->synchronize();
+  int n = int(min(c->record_count, uint(record_cap_)));
+  if (c->T_count > 0) {
+    /* Running mean throughput for the next collect's record weighting. */
+    const float mean_T = c->T_sum / float(c->T_count);
+    c->tau = (c->tau > 0.0f) ? 0.8f * c->tau + 0.2f * mean_T : mean_T;
+  }
+  c->T_sum = 0.0f;
+  c->T_count = 0;
+  const int steps = (n_steps_ < warmup_) ? warmup_steps_ : train_steps_;
+  if (n > 0) {
+    device_ptr in = rec_in_.device_pointer, target = rec_target_.device_pointer;
+    if (stub_mode_ == 1) {
+      queue_->enqueue_named(
+          "kernel_gpu_nrc_stub_train", n, DeviceKernelArguments(&in, &target, &n));
+    }
+    else if (stub_mode_ == -1) {
+      int rc = 0;
+      void *stream = queue_->nrc_stream();
+      queue_->run_in_context([&]() {
+        rc = api_.train(engine_, n, (const void *)in, (const float *)target, steps, stream);
+      });
+      if (rc != 0) {
+        LOG_ERROR << "NRC: nrc_train returned " << rc;
+      }
+    }
+    n_train_calls_++;
+    n_steps_ += steps;
+    n_records_ += n;
+  }
+  c->done_count = 0;
+  c->record_count = 0;
+  if (!c->terminate && terminate_enabled_ && n_steps_ >= warmup_) {
+    c->terminate = 1;
+  }
+  queue_->copy_to_device(ctrl_);
+}
+
+void PathTraceNRC::infer(const device_ptr render_buffer)
+{
+  NRCControlHost *c = ctrl();
+  int n = int(min(c->query_count, uint(query_cap_)));
+  if (n > 0) {
+    int n_pad = (n + 255) & ~255;
+    int n_extra = n_pad - n;
+    if (n_extra > 0) {
+      queue_->enqueue_named("kernel_gpu_nrc_pad", n_extra, DeviceKernelArguments(&n, &n_extra));
+    }
+    device_ptr in = query_in_.device_pointer, out = query_out_.device_pointer;
+    if (stub_mode_ == 1) {
+      queue_->enqueue_named("kernel_gpu_nrc_stub_infer", n_pad, DeviceKernelArguments(&in, &out, &n_pad));
+    }
+    else if (stub_mode_ == 0) {
+      queue_->zero_to_device(query_out_);
+    }
+    else {
+      int rc = 0;
+      void *stream = queue_->nrc_stream();
+      queue_->run_in_context([&]() {
+        for (int off = 0; off < n_pad && rc == 0; off += infer_chunk_) {
+          const int m = min(infer_chunk_, n_pad - off);
+          rc = api_.infer(engine_,
+                          m,
+                          (const void *)(in + size_t(off) * NRC_IN_FEATURES * sizeof(uint16_t)),
+                          (float *)(out + size_t(off) * 3 * sizeof(float)),
+                          stream);
+        }
+      });
+      if (rc != 0) {
+        LOG_ERROR << "NRC: nrc_infer returned " << rc;
+      }
+    }
+    device_ptr rb = render_buffer;
+    queue_->enqueue_named("kernel_gpu_nrc_resolve", n, DeviceKernelArguments(&rb, &n));
+    n_infer_calls_++;
+    n_queries_ += n;
+  }
+  c->query_count = 0;
+  queue_->copy_to_device(ctrl_);
+}
+
+CCL_NAMESPACE_END
