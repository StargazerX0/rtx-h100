+            (long long)n_train_calls_,
+            (long long)n_records_,
+            (long long)n_infer_calls_,
+            (long long)n_queries_,
+            (long long)n_dropped_);
+  }
+  if (engine_ && api_.destroy) {
+    queue_->run_in_context([&]() { api_.destroy(engine_); });
+  }
+  if (engine_lib_) {
+    dlclose(engine_lib_);
+  }
+}
