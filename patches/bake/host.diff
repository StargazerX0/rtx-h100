+PathTraceNRC::PathTraceNRC(Device *device, DeviceQueue *queue)
+    : device_(device),
+      queue_(queue),
+      ctrl_(device, "nrc_ctrl", MEM_READ_WRITE),
+      main_slot_(device, "nrc_main_slot"),
+      main_spread_(device, "nrc_main_spread"),
+      shadow_slot_(device, "nrc_shadow_slot"),
+      query_in_(device, "nrc_query_in"),
+      query_meta_(device, "nrc_query_meta"),
+      query_out_(device, "nrc_query_out"),
+      slots_(device, "nrc_slots"),
+      slot_feat_(device, "nrc_slot_feat"),
+      slot_T_(device, "nrc_slot_T"),
+      slot_bins_(device, "nrc_slot_bins"),
+      done_list_(device, "nrc_done_list"),
+      rec_in_(device, "nrc_rec_in"),
+      rec_target_(device, "nrc_rec_target"),
+      rec_T_(device, "nrc_rec_T"),
+      stub_table_(device, "nrc_stub_table")
+{
+  c_ = env_float("CYCLES_NRC_C", 0.01f);
+  min_bounce_ = max(env_int("CYCLES_NRC_MIN_BOUNCE", 1), 1);
+  terminate_enabled_ = env_int("CYCLES_NRC_TERM", 1);
+  skip_singular_ = env_int("CYCLES_NRC_SKIP_SINGULAR", 1);
+  train_frac_ = env_float("CYCLES_NRC_TRAIN_FRAC", 0.01f);
+  train_steps_ = max(env_int("CYCLES_NRC_TRAIN_STEPS", 4), 1);
+  train_slots_ = max(env_int("CYCLES_NRC_TRAIN_SLOTS", 65536), 1);
+  warmup_ = max(env_int("CYCLES_NRC_WARMUP", 256), 0); /* Adam steps before paths may end in the cache */
+  warmup_steps_ = max(env_int("CYCLES_NRC_WARMUP_STEPS", 16), 1); /* steps per train call during warm-up */
+  num_slots_ = max(env_int("CYCLES_NRC_SLOTS", 1 << 18), 1024);
+  record_cap_ = max(env_int("CYCLES_NRC_RECORDS", 1 << 18), 1024);
+  infer_chunk_ = max(env_int("CYCLES_NRC_INFER_CHUNK", 1 << 21), 256) & ~255;
+  stats_ = env_int("CYCLES_NRC_STATS", 0);
+  const char *e = getenv("CYCLES_NRC_ENGINE");
+  engine_name_ = (e && *e) ? e : "stub";
+  /* nrc-bake (analysis/nrc_bake.md): CYCLES_NRC_FREEZE=1 = inference only. No training paths are tagged, so
+   * nrc_collect and nrc_train never run; paths may end in the cache from the first sample (no warm-up); the
+   * training buffers shrink to the minimum. The engine reads the same variable (and CYCLES_NRC_LOAD, which must
+   * then name a baked file; it is loaded in nrc_create, inside alloc_work_memory, before the render timer). */
+  if (env_int("CYCLES_NRC_FREEZE", 0)) {
+    train_frac_ = 0.0f;
+    warmup_ = 0;
+    num_slots_ = 1024;
+    record_cap_ = 1024;
+  }
+  /* The train trigger must leave free slots for new training paths. */
+  train_slots_ = min(train_slots_, num_slots_ / 2);
+}
