@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+/* Ours: SVM specialization (port of the 4.5.0 final4 selective specialization to 5.3.0). Unset env = stock. */
+
+#pragma once
+
+#include "util/vector.h"
+
+CCL_NAMESPACE_BEGIN
+
+class DeviceScene;
+
+/* CYCLES_SVM_SPECIALIZE=1. */
+bool svm_specialization_enabled();
+
+/* Hash the scene's SVM program into dscene->data.image.pad1..3 (the key the generated kernel checks) and, with
+ * CYCLES_SVM_DUMP=<dir>, write <dir>/svm_specialized.h, manifest.txt and program_costs.csv. CYCLES_SVM_SELECTIVE=1
+ * leaves image-texture programs with at most one BSDF to the interpreter (the 4.5.0 policy). */
+void svm_specialize(DeviceScene *dscene, int num_shaders, const vector<int> &instructions);
