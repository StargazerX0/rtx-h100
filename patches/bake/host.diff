+    th.f = fopen(name, "wb");
+  }
+  if (th.f && th.n > 0) {
+    fwrite(th.buf, sizeof(SSSLogRec), th.n, th.f);
+    fflush(th.f);
+  }
+  th.nsampled++;
+}
