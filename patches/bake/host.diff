+    fwrite(v, sizeof(float), 9, f);
+  }
+  fclose(f);
+}
+static void sss_log_walk_begin(KernelGlobals kg, const int object)
+{
+  SSSLogThread &th = sss_log_thread();
+  th.n = 0;
+  th.cur = (th.nwalk++ % sss_log_k()) == 0;
+  if (th.cur) {
+    sss_log_dump_object(kg, object);
+  }
+}
+static void sss_log_step(const float3 P, const float3 D, const float t, const float tmax,
+                         const float thit, const int object, const int bounce, const int flags,
+                         const unsigned int cycles)
+{
+  SSSLogThread &th = sss_log_thread();
+  if (!th.cur || th.n >= BSSRDF_MAX_BOUNCES) {
+    return;
+  }
+  SSSLogRec &r = th.buf[th.n++];
+  r.P[0] = P.x; r.P[1] = P.y; r.P[2] = P.z;
+  r.D[0] = D.x; r.D[1] = D.y; r.D[2] = D.z;
+  r.t = t; r.tmax = tmax; r.thit = thit; r.object = object; r.walk = th.nsampled; r.cycles = cycles;
+  r.bounce = (short)bounce; r.flags = (short)flags;
+}
+static bool sss_log_cur()
+{
+  return sss_log_thread().cur;
+}
+static unsigned long long sss_log_ticks()
+{
+#  if defined(__x86_64__)
+  return __rdtsc();
+#  else
+  return 0;
+#  endif
+}
+static void sss_log_walk_end()
+{
+  SSSLogThread &th = sss_log_thread();
+  if (!th.cur) {
+    return;
+  }
+  th.cur = false;
+  if (!th.f) {
+    char name[1024];
+    snprintf(name, sizeof(name), "%s/steps_%ld_%p.bin", sss_log_dir(), (long)syscall(SYS_gettid),
