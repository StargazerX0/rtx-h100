diff --git a/intern/cycles/kernel/integrator/subsurface_walk_steps.h b/intern/cycles/kernel/integrator/subsurface_walk_steps.h
new file mode 100644
index 0000000..0c34544
--- /dev/null
+++ b/intern/cycles/kernel/integrator/subsurface_walk_steps.h
@@ -0,0 +1,311 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* subsurface_random_walk (kernel/integrator/subsurface_random_walk.h, Blender 5.3.0) split into
+ * begin / one bounce / end, so that a dynamic-fetch loop can advance many walks one bounce at a
+ * time (CYCLES_SSSDF). The code of each part is the stock function's own, in the same order, with
+ * the same random numbers; only the variables the bounce loop carries live in SSSWalk instead of
+ * locals. The stock function is left as it is. Each walk runs to its end inside one launch (no
+ * split walk on 5.3.0).
+ *
+ *   sss_walk_begin  the function up to the bounce loop; false = it returns false before the loop
+ *   sss_walk_step   one iteration of the bounce loop; true = the loop ended (exit hit, small
+ *                   throughput or BSSRDF_MAX_BOUNCES)
+ *   sss_walk_end    the function after the loop; returns its result (true: exit hit)
+ */
+
+#ifdef __SUBSURFACE__
+
+#  ifndef SUBSURFACE_RANDOM_WALK_SIMILARITY_LEVEL
+#    error "subsurface_walk_steps.h mirrors 5.3.0 with SUBSURFACE_RANDOM_WALK_SIMILARITY_LEVEL set"
+#  endif
+
+CCL_NAMESPACE_BEGIN
+
+struct SSSWalk {
+  Ray ray;
+  /* subsurface_scatter's ss_isect, as stock carries it through the walk. A local per bounce
+   * instead (only hits[0] kept) gives the same results but spills more (dfsss10: 384 vs 82 B). */
+  LocalIntersection ss_isect;
+  RNGState rng_state;
+  /* The walk's constants (stock locals P, D, N, object, albedo, alpha, diffusion_length,
+   * phase_log; sigma_t, sigma_s, anisotropy, guided_fraction are the stock *_org values). */
+  float3 P, D, N;
+  int object;
+  Spectrum albedo, alpha, sigma_t, sigma_s, sigma_t_star, sigma_s_star;
+  float anisotropy, guided_fraction, diffusion_length, phase_log;
+  /* Loop-carried. */
+  Spectrum throughput;
+  float opposite_distance;
+  int bounce;
+  bool hit, have_opposite_interface;
+};
+
+/* rng_state must hold path_state_rng_load(state) on entry, as subsurface_scatter passes it. */
+ccl_device_forceinline bool sss_walk_begin(KernelGlobals kg, IntegratorState state, SSSWalk &w)
+{
+  Ray &ray = w.ray;
+  RNGState &rng_state = w.rng_state;
+
+  w.P = INTEGRATOR_STATE(state, ray, P);
+  w.D = INTEGRATOR_STATE(state, ray, D);
+  const float ray_dP = INTEGRATOR_STATE(state, ray, dP);
+  const float time = INTEGRATOR_STATE(state, ray, time);
+  w.N = INTEGRATOR_STATE(state, subsurface, N);
+  w.object = INTEGRATOR_STATE(state, isect, object);
+  const int prim = INTEGRATOR_STATE(state, isect, prim);
+
+  /* Setup ray. */
+  ray.P = w.P;
+  ray.D = w.D;
+  ray.tmin = 0.0f;
+  ray.tmax = FLT_MAX;
+  ray.time = time;
+  ray.dP = ray_dP;
+  ray.dD = differential_zero_compact();
+  ray.self.object = w.object;
+  ray.self.prim = prim;
+  ray.self.light_object = OBJECT_NONE;
+  ray.self.light_prim = PRIM_NONE;
+
+  /* Convert subsurface to volume coefficients. */
+  w.albedo = INTEGRATOR_STATE(state, subsurface, albedo);
+  const Spectrum radius = INTEGRATOR_STATE(state, subsurface, radius);
+  float anisotropy = INTEGRATOR_STATE(state, subsurface, anisotropy);
+
+  bool van_de_hulst;
+  if (anisotropy >= 1.0f) {
+    /* Legacy random walk was mapped from (-1, 1) to (1, 3) when stored in integrator state. */
+    anisotropy -= 2.0f;
+    van_de_hulst = anisotropy < 0.0f;
+  }
+  else {
+    van_de_hulst = true;
+  }
+
+  Spectrum sigma_t;
+  Spectrum alpha;
+  Spectrum throughput = INTEGRATOR_STATE(state, path, throughput);
+  subsurface_random_walk_coefficients(
+      w.albedo, radius, anisotropy, van_de_hulst, &sigma_t, &alpha, &throughput);
+  const Spectrum sigma_s = sigma_t * alpha;
+
+  const float diffusion_length = diffusion_length_dwivedi(reduce_max(alpha));
+
+  if (diffusion_length == 1.0f) {
+    return false;
+  }
+
+  /* Precompute term for phase sampling. */
+  w.phase_log = logf((diffusion_length + 1.0f) / (diffusion_length - 1.0f));
+
+  /* Modify state for RNGs, decorrelated from other paths. */
+  path_state_rng_scramble(&rng_state, 0xdeadbeef);
+
+  /* Random walk until we hit the surface again. */
+  w.hit = false;
+  w.have_opposite_interface = false;
+  w.opposite_distance = 0.0f;
+
+  const float guided_fraction = 1.0f - fmaxf(0.5f, powf(fabsf(anisotropy), 0.125f));
+
+  w.sigma_s_star = sigma_s * (1.0f - anisotropy);
+  w.sigma_t_star = sigma_t - sigma_s + w.sigma_s_star;
+  w.sigma_t = sigma_t;
+  w.sigma_s = sigma_s;
+  w.anisotropy = anisotropy;
+  w.guided_fraction = guided_fraction;
+
+  w.alpha = alpha;
+  w.throughput = throughput;
+  w.diffusion_length = diffusion_length;
+  w.bounce = 0;
+  return true;
+}
+
+/* One iteration of the bounce loop, for bounce w.bounce; true when the loop has ended. */
+ccl_device_forceinline bool sss_walk_step(KernelGlobals kg, IntegratorState state, SSSWalk &w)
+{
+  Ray &ray = w.ray;
+  RNGState &rng_state = w.rng_state;
+  const int bounce = w.bounce;
+  const float3 P = w.P;
+  const float3 N = w.N;
+  const float diffusion_length = w.diffusion_length;
+  const float phase_log = w.phase_log;
+  LocalIntersection &ss_isect = w.ss_isect;
+  bool hit;
+
+  /* Advance random number offset. */
+  rng_state.rng_offset += PRNG_BOUNCE_NUM;
+
+  float anisotropy;
+  float guided_fraction;
+  Spectrum sigma_s;
+  Spectrum sigma_t;
+  if (bounce <= SUBSURFACE_RANDOM_WALK_SIMILARITY_LEVEL) {
+    anisotropy = w.anisotropy;
+    guided_fraction = w.guided_fraction;
+    sigma_t = w.sigma_t;
+    sigma_s = w.sigma_s;
+  }
+  else {
+    anisotropy = 0.0f;
+    guided_fraction = 0.75f;  // back to isotropic heuristic from Blender
+    sigma_t = w.sigma_t_star;
+    sigma_s = w.sigma_s_star;
+  }
+
+  /* Sample color channel, use MIS with balance heuristic. */
+  float rchannel = path_state_rng_1D(kg, &rng_state, PRNG_SUBSURFACE_COLOR_CHANNEL);
+  Spectrum channel_pdf;
+  const int channel = volume_sample_channel(w.alpha, w.throughput, &rchannel, &channel_pdf);
+  float sample_sigma_t = volume_channel_get(sigma_t, channel);
+  const float randt = path_state_rng_1D(kg, &rng_state, PRNG_SUBSURFACE_SCATTER_DISTANCE);
+
+  float backward_fraction = 0.0f;
+  float forward_pdf_factor = 0.0f;
+  float forward_stretching = 1.0f;
+  float backward_pdf_factor = 0.0f;
+  float backward_stretching = 1.0f;
+
+  /* For the initial ray, we already know the direction, so just do classic distance sampling. */
+  if (bounce > 0) {
+    /* Decide whether we should use guided or classic sampling. */
+    const bool guided = (path_state_rng_1D(kg, &rng_state, PRNG_SUBSURFACE_GUIDE_STRATEGY) <
+                         guided_fraction);
+
+    bool guide_backward = false;
+    if (w.have_opposite_interface) {
+      const float x = clamp(dot(ray.P - P, -N), 0.0f, w.opposite_distance);
+      backward_fraction = 1.0f /
+                          (1.0f + expf((w.opposite_distance - 2.0f * x) / diffusion_length));
+      guide_backward = path_state_rng_1D(kg, &rng_state, PRNG_SUBSURFACE_GUIDE_DIRECTION) <
+                       backward_fraction;
+    }
+
+    /* Sample scattering direction. */
+    const float2 rand_scatter = path_state_rng_2D(kg, &rng_state, PRNG_SUBSURFACE_BSDF);
+    float cos_theta;
+    float hg_pdf;
+    if (guided) {
+      cos_theta = sample_phase_dwivedi(diffusion_length, phase_log, rand_scatter.x);
+      if (guide_backward) {
+        cos_theta = -cos_theta;
+      }
+      const float3 newD = direction_from_cosine(N, cos_theta, rand_scatter.y);
+      hg_pdf = phase_henyey_greenstein(dot(ray.D, newD), anisotropy);
+      ray.D = newD;
+    }
+    else {
+      const float3 newD = phase_henyey_greenstein_sample(ray.D, anisotropy, rand_scatter, &hg_pdf);
+      cos_theta = dot(newD, N);
+      ray.D = newD;
+    }
+
+    forward_pdf_factor = M_1_2PI_F * eval_phase_dwivedi(diffusion_length, phase_log, cos_theta) /
+                         hg_pdf;
+    backward_pdf_factor = M_1_2PI_F *
+                          eval_phase_dwivedi(diffusion_length, phase_log, -cos_theta) / hg_pdf;
+
+    forward_stretching = (1.0f - cos_theta / diffusion_length);
+    backward_stretching = (1.0f + cos_theta / diffusion_length);
+    if (guided) {
+      sample_sigma_t *= guide_backward ? backward_stretching : forward_stretching;
+    }
+  }
+
+  /* Sample distance along ray. */
+  float t = -logf(1.0f - randt) / sample_sigma_t;
+
+  if (bounce == 0) {
+    ray.tmax = max(t, 10.0f / (reduce_min(sigma_t)));
+  }
+  else {
+    ray.tmax = t;
+    /* After the first bounce the object can intersect the same surface again */
+    ray.self.object = OBJECT_NONE;
+    ray.self.prim = PRIM_NONE;
+  }
+  scene_intersect_local<true>(kg, &ray, &ss_isect, w.object, nullptr, 1);
+  hit = (ss_isect.num_hits > 0);
+
+  if (hit) {
+    ray.tmax = ss_isect.hits[0].t;
+  }
+
+  if (bounce == 0) {
+    /* Check if we hit the opposite side. */
+    if (hit) {
+      w.have_opposite_interface = true;
+      w.opposite_distance = dot(ray.P + ray.tmax * ray.D - P, -N);
+    }
+    hit = ray.tmax < t;
+  }
+
+  /* Use the distance to the exit point for the throughput update if we found one. */
+  if (hit) {
+    t = ray.tmax;
+  }
+
+  /* Advance to new scatter location. */
+  ray.P += t * ray.D;
+
+  Spectrum transmittance;
+  Spectrum pdf = subsurface_random_walk_pdf(sigma_t, t, hit, &transmittance);
+  if (bounce > 0) {
+    Spectrum guided_pdf = subsurface_random_walk_pdf(
+        forward_stretching * sigma_t, t, hit, nullptr);
+
+    if (w.have_opposite_interface) {
+      const Spectrum back_pdf = subsurface_random_walk_pdf(
+          backward_stretching * sigma_t, t, hit, nullptr);
+      guided_pdf = mix(
+          guided_pdf * forward_pdf_factor, back_pdf * backward_pdf_factor, backward_fraction);
+    }
+    else {
+      guided_pdf *= forward_pdf_factor;
+    }
+
+    pdf = mix(pdf, guided_pdf, guided_fraction);
+  }
+
+  w.throughput *= (hit ? transmittance : sigma_s * transmittance) / dot(channel_pdf, pdf);
+  w.hit = hit;
+
+  if (hit) {
+    /* If we hit the surface, we are done. */
+    return true;
+  }
+  if (reduce_max(w.throughput) < VOLUME_THROUGHPUT_EPSILON) {
+    return true;
+  }
+  w.bounce = bounce + 1;
+  return w.bounce >= BSSRDF_MAX_BOUNCES;
+}
+
+/* The function after its bounce loop; returns its result. */
+ccl_device_forceinline bool sss_walk_end(KernelGlobals kg, IntegratorState state, SSSWalk &w)
+{
+  if (w.hit) {
+    kernel_assert(isfinite_safe(w.throughput));
+
+    guiding_record_bssrdf_bounce(
+        kg,
+        state,
+        1.0f,
+        w.N,
+        w.D,
+        safe_divide_color(w.throughput, INTEGRATOR_STATE(state, path, throughput)),
+        w.albedo);
+
+    INTEGRATOR_STATE_WRITE(state, path, throughput) = w.throughput;
+  }
+
+  return w.hit;
+}
+
+CCL_NAMESPACE_END
+
+#endif /* __SUBSURFACE__ */
