diff --git a/intern/cycles/kernel/integrator/intersect_dynamic.h b/intern/cycles/kernel/integrator/intersect_dynamic.h
new file mode 100644
index 0000000..5aeb6df
--- /dev/null
+++ b/intern/cycles/kernel/integrator/intersect_dynamic.h
@@ -0,0 +1,278 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Dynamic-fetch (persistent-thread) versions of the intersect_closest and intersect_shadow
+ * kernels, on kernel/bvh/bvh2_dynamic.h. Begin and finish are the code of
+ * integrator_intersect_closest and integrator_intersect_shadow before and after their
+ * scene_intersect* call, unchanged; only the traversal between them runs through the
+ * dynamic-fetch loop, which visits each ray's nodes and primitives in the stock order.
+ *
+ * Launch: the host's normal grid (one thread per path, no host change). Every block runs the
+ * fetch loop, blocks that start after the paths are all taken exit at once, and the last block to
+ * finish zeroes the kernel's counter for its next launch (launches on a queue's stream run one
+ * after another).
+ *
+ * Blender 5.3.0 port: begin and finish copy 5.3.0 integrator_intersect_closest,
+ * integrator_intersect_shadow, integrate_intersect_shadow_opaque/_transparent and the setup of
+ * scene_intersect_shadow_all (BVHShadowAllPayload). */
+
+#include "kernel/bvh/bvh2_dynamic.h"
+
+CCL_NAMESPACE_BEGIN
+
+struct IntersectClosestDFWork {
+  const ccl_global int *path_index_array;
+  ccl_global float *render_buffer;
+
+  ccl_device_forceinline int state(const int index)
+  {
+    return path_index_array ? path_index_array[index] : index;
+  }
+
+  ccl_device_forceinline bool begin(const int state, BVH2DFRay &s, BVH2DFStackEntry *stack)
+  {
+    KernelGlobals kg = nullptr;
+    Ray &ray = s.ray;
+    integrator_state_read_ray(state, &ray);
+    kernel_assert(ray.tmax != 0.0f);
+
+    const uint visibility = path_state_ray_visibility(state);
+    const int last_isect_prim = INTEGRATOR_STATE(state, isect, prim);
+    const int last_isect_object = INTEGRATOR_STATE(state, isect, object);
+
+    /* Trick to use short AO rays to approximate indirect light at the end of the path. */
+    if (path_state_ao_bounce(kg, state)) {
+      ray.tmax = kernel_data.integrator.ao_bounces_distance;
+
+      if (last_isect_object != OBJECT_NONE) {
+        const float object_ao_distance = kernel_data_fetch(objects, last_isect_object).ao_distance;
+        if (object_ao_distance != 0.0f) {
+          ray.tmax = object_ao_distance;
+        }
+      }
+    }
+
+    s.isect.object = OBJECT_NONE;
+    s.isect.prim = PRIM_NONE;
+    ray.self.object = last_isect_object;
+    ray.self.prim = last_isect_prim;
+    ray.self.light_object = OBJECT_NONE;
+    ray.self.light_prim = PRIM_NONE;
+    s.visibility = visibility;
+    s.mode = 0;
+    s.hit = false;
+    /* scene_intersect returns false for an invalid ray without touching isect. */
+    if (!intersection_ray_valid(&ray)) {
+      return false;
+    }
+    bvh2df_begin(kg, s, stack);
+    return true;
+  }
+
+  ccl_device_forceinline void finish(const int state, BVH2DFRay &s)
+  {
+    KernelGlobals kg = nullptr;
+    Ray &ray = s.ray;
+    Intersection &isect = s.isect;
+    bool hit = s.hit;
+    const int last_isect_prim = INTEGRATOR_STATE(state, isect, prim);
+    const int last_isect_object = INTEGRATOR_STATE(state, isect, object);
+
+    /* TODO: remove this and do it in the various intersection functions instead. */
+    if (!hit) {
+      isect.prim = PRIM_NONE;
+    }
+
+    /* Setup mnee flag to signal last intersection with a caster */
+    const PathRayVisibility path_visibility = INTEGRATOR_STATE(state, path, visibility);
+    const uint32_t path_flag = INTEGRATOR_STATE(state, path, flag);
+
+#ifdef __MNEE__
+    /* Path culling logic for MNEE (removes fireflies at the cost of bias) */
+    if (kernel_data.integrator.use_caustics) {
+      bool from_caustic_caster = false;
+      bool from_caustic_receiver = false;
+      if (!(path_visibility & PATH_RAY_VISIBILITY_CAMERA) && last_isect_object != OBJECT_NONE) {
+        const uint object_flags = kernel_data_fetch(object_flag, last_isect_object);
+        from_caustic_receiver = (object_flags & SD_OBJECT_CAUSTICS_RECEIVER);
+        from_caustic_caster = (object_flags & SD_OBJECT_CAUSTICS_CASTER);
+      }
+
+      const bool has_receiver_ancestor = INTEGRATOR_STATE(state, path, mnee) &
+                                         PATH_MNEE_RECEIVER_ANCESTOR;
+      INTEGRATOR_STATE_WRITE(state, path, mnee) &= ~PATH_MNEE_CULL_LIGHT_CONNECTION;
+      if (from_caustic_caster && has_receiver_ancestor) {
+        INTEGRATOR_STATE_WRITE(state, path, mnee) |= PATH_MNEE_CULL_LIGHT_CONNECTION;
+      }
+      if (from_caustic_receiver) {
+        INTEGRATOR_STATE_WRITE(state, path, mnee) |= PATH_MNEE_RECEIVER_ANCESTOR;
+      }
+    }
+#endif /* __MNEE__ */
+
+    /* Light intersection for MIS. */
+    if (kernel_data.integrator.use_light_mis && !integrator_intersect_skip_lights(kg, state)) {
+      const int last_type = INTEGRATOR_STATE(state, isect, type);
+      hit = lights_intersect(kg,
+                             state,
+                             &ray,
+                             &isect,
+                             last_isect_prim,
+                             last_isect_object,
+                             last_type,
+                             path_visibility,
+                             path_flag) ||
+            hit;
+    }
+
+    /* Write intersection result into global integrator state memory. */
+    integrator_state_write_isect(state, &isect);
+
+    /* Setup up next kernel to be executed. */
+    integrator_intersect_next_kernel<DEVICE_KERNEL_INTEGRATOR_INTERSECT_CLOSEST>(
+        kg, state, &isect, render_buffer, hit);
+  }
+};
+
+struct IntersectShadowDFWork {
+  const ccl_global int *path_index_array;
+
+  ccl_device_forceinline int state(const int index)
+  {
+    return path_index_array ? path_index_array[index] : index;
+  }
+
+  ccl_device_forceinline bool begin(const int state, BVH2DFRay &s, BVH2DFStackEntry *stack)
+  {
+    KernelGlobals kg = nullptr;
+    integrator_state_read_shadow_ray(state, &s.ray);
+    integrator_state_read_shadow_ray_self(state, &s.ray);
+    s.visibility = integrate_intersect_shadow_visibility(state);
+    s.hit = false;
+#ifdef __TRANSPARENT_SHADOWS__
+    s.mode = kernel_data.integrator.transparent_shadows ? 1 : 0;
+    if (s.mode) {
+      /* integrate_intersect_shadow_transparent and scene_intersect_shadow_all. The payload is set
+       * before the validity test: an invalid ray leaves it as initialized, with no recorded hits
+       * and throughput one, which is what scene_intersect_shadow_all returns for it. */
+      const uint max_transparent_hits = integrate_shadow_max_transparent_hits(kg, state);
+      s.payload = BVHShadowAllPayload();
+      BVH_PAYLOAD_BASE(s.payload).ray_self = s.ray.self;
+      BVH_PAYLOAD_BASE(s.payload).ray_visibility = s.visibility;
+      s.payload.state = state;
+      s.payload.max_transparent_hits = max_transparent_hits;
+      s.payload.max_record_isect_t = s.ray.tmax;
+    }
+    else
+#else
+    s.mode = 0;
+#endif
+    {
+      /* integrate_intersect_shadow_opaque */
+      constexpr const uint opaque_mask = SHADOW_CATCHER_VISIBILITY_SHIFT(
+                                             PATH_RAY_VISIBILITY_SHADOW_OPAQUE) |
+                                         PATH_RAY_VISIBILITY_SHADOW_OPAQUE;
+      s.visibility &= opaque_mask;
+    }
+    /* scene_intersect_shadow / scene_intersect_shadow_all: an invalid ray hits nothing, with no
+     * recorded hits and throughput one. */
+    if (!intersection_ray_valid(&s.ray)) {
+      return false;
+    }
+    bvh2df_begin(kg, s, stack);
+    return true;
+  }
+
+  ccl_device_forceinline void finish(const int state, BVH2DFRay &s)
+  {
+    bool opaque_hit = s.hit;
+#ifdef __TRANSPARENT_SHADOWS__
+    if (s.mode) {
+      /* Rest of integrate_intersect_shadow_transparent. */
+      const uint num_hits = s.payload.num_recorded_hits;
+      const float3 throughput = s.payload.throughput;
+
+      opaque_hit = is_zero(throughput);
+
+      if (!isequal(throughput, one_float3())) {
+        INTEGRATOR_STATE_WRITE(state, shadow_path, throughput) *= throughput;
+      }
+
+      if (!opaque_hit) {
+        const uint num_recorded_hits = min(num_hits, (uint)INTEGRATOR_SHADOW_ISECT_SIZE);
+
+        if (num_recorded_hits > 0) {
+          sort_shadow_intersections(state, num_recorded_hits);
+        }
+
+        INTEGRATOR_STATE_WRITE(state, shadow_path, packed_num_hits) = num_hits;
+      }
+      else {
+        INTEGRATOR_STATE_WRITE(state, shadow_path, packed_num_hits) = 0;
+      }
+    }
+    else
+#endif
+        if (!opaque_hit)
+    {
+      /* Rest of integrate_intersect_shadow_opaque. */
+      INTEGRATOR_STATE_WRITE(state, shadow_path, packed_num_hits) = 0;
+    }
+
+    if (opaque_hit) {
+      /* Hit an opaque surface, shadow path ends here. */
+      integrator_shadow_path_terminate(state, DEVICE_KERNEL_INTEGRATOR_INTERSECT_SHADOW);
+      return;
+    }
+    integrator_shadow_path_next(
+        state, DEVICE_KERNEL_INTEGRATOR_INTERSECT_SHADOW, DEVICE_KERNEL_INTEGRATOR_SHADE_SHADOW);
+  }
+};
+
+/* Per kernel: [0] the fetch counter, [1] blocks finished in the current launch. */
+extern "C" __device__ uint bvh2df_closest_counters[2];
+extern "C" __device__ uint bvh2df_shadow_counters[2];
+__device__ uint bvh2df_closest_counters[2] = {0, 0};
+__device__ uint bvh2df_shadow_counters[2] = {0, 0};
+
+ccl_device_forceinline void bvh2df_block_done(uint *counters)
+{
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    __threadfence();
+    if (atomicAdd(&counters[1], 1u) == gridDim.x - 1) {
+      counters[0] = 0;
+      counters[1] = 0;
+      __threadfence();
+    }
+  }
+}
+
+ccl_device_forceinline void integrator_intersect_closest_df(const ccl_global int *path_index_array,
+                                                            ccl_global float *render_buffer,
+                                                            const int work_size)
+{
+  IntersectClosestDFWork work{path_index_array, render_buffer};
+  bvh2df_run<0>(work, &bvh2df_closest_counters[0], work_size);
+  bvh2df_block_done(bvh2df_closest_counters);
+}
+
+ccl_device_forceinline void integrator_intersect_shadow_df(const ccl_global int *path_index_array,
+                                                           const int work_size)
+{
+  IntersectShadowDFWork work{path_index_array};
+#ifdef __TRANSPARENT_SHADOWS__
+  /* Uniform for the launch: one loop per leaf type. */
+  if (kernel_data.integrator.transparent_shadows) {
+    bvh2df_run<1>(work, &bvh2df_shadow_counters[0], work_size);
+  }
+  else
+#endif
+  {
+    bvh2df_run<0>(work, &bvh2df_shadow_counters[0], work_size);
+  }
+  bvh2df_block_done(bvh2df_shadow_counters);
+}
+
+CCL_NAMESPACE_END
diff --git a/intern/cycles/kernel/integrator/intersect_subsurface_dynamic.h b/intern/cycles/kernel/integrator/intersect_subsurface_dynamic.h
new file mode 100644
index 0000000..0649495
--- /dev/null
+++ b/intern/cycles/kernel/integrator/intersect_subsurface_dynamic.h
@@ -0,0 +1,153 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Dynamic-fetch version of the intersect_subsurface kernel (CYCLES_SSSDF), Blender 5.3.0: random
+ * walks advance one bounce per step through bvh2df_run_work, and a lane whose walk ends takes the
+ * next path, so warps stay full. Begin, step and end are subsurface_random_walk's own code
+ * (subsurface_walk_steps.h); the rest is subsurface_scatter / integrator_intersect_subsurface,
+ * unchanged. Every walk runs to its end inside the launch. Paths that do not take a random walk
+ * (disk BSSRDF) run the stock kernel body.
+ *
+ * Launch: the host's normal grid, no host change; the last block to finish resets the counter. */
+
+#include "kernel/bvh/bvh2_dynamic.h"
+#include "kernel/integrator/subsurface_walk_steps.h"
+
+CCL_NAMESPACE_BEGIN
+
+#ifdef __SUBSURFACE__
+
+/* subsurface_scatter after subsurface_random_walk returned true. */
+ccl_device_forceinline void subsurface_scatter_exit(KernelGlobals kg,
+                                                    IntegratorState state,
+                                                    ccl_private Ray &ray,
+                                                    const ccl_private Intersection &exit_isect)
+{
+#  ifdef __VOLUME__
+  /* Update volume stack if needed. */
+  if (kernel_data.integrator.use_volumes) {
+    const int object = exit_isect.object;
+    const uint object_flag = kernel_data_fetch(object_flag, object);
+
+    if (object_flag & SD_OBJECT_INTERSECTS_VOLUME) {
+      const float3 P = INTEGRATOR_STATE(state, ray, P);
+
+      integrator_volume_stack_update_for_subsurface(kg, state, P, ray.P);
+    }
+  }
+#  endif /* __VOLUME__ */
+
+  /* Pretend ray is coming from the outside towards the exit point. This ensures
+   * correct front/back facing normals.
+   * TODO: find a more elegant solution? */
+  ray.P += ray.D * ray.tmax * 2.0f;
+  ray.D = -ray.D;
+
+  integrator_state_write_isect(state, &exit_isect);
+  integrator_state_write_ray(state, &ray);
+
+  /* Advance random number offset for bounce. */
+  INTEGRATOR_STATE_WRITE(state, path, rng_offset) += PRNG_BOUNCE_NUM;
+
+  const int shader = intersection_get_shader(kg, &exit_isect);
+  const int shader_flags = kernel_data_fetch(shaders, shader).flags;
+  const uint object_flags = intersection_get_object_flags(kg, &exit_isect);
+  const bool use_caustics = kernel_data.integrator.use_caustics &&
+                            (object_flags & SD_OBJECT_CAUSTICS_RECEIVER);
+  const bool use_raytrace_kernel = (shader_flags & SD_HAS_RAYTRACE);
+
+  if (use_caustics) {
+    integrator_path_next(state,
+                         DEVICE_KERNEL_INTEGRATOR_INTERSECT_SUBSURFACE,
+                         DEVICE_KERNEL_INTEGRATOR_INTERSECT_MNEE);
+  }
+  else if (use_raytrace_kernel) {
+    integrator_path_next_sorted(kg,
+                                state,
+                                DEVICE_KERNEL_INTEGRATOR_INTERSECT_SUBSURFACE,
+                                DEVICE_KERNEL_INTEGRATOR_SHADE_SURFACE_RAYTRACE,
+                                shader);
+  }
+  else {
+    integrator_path_next_sorted(kg,
+                                state,
+                                DEVICE_KERNEL_INTEGRATOR_INTERSECT_SUBSURFACE,
+                                DEVICE_KERNEL_INTEGRATOR_SHADE_SURFACE,
+                                shader);
+  }
+}
+
+struct IntersectSubsurfaceDFWork {
+  const ccl_global int *path_index_array;
+  SSSWalk w;
+  /* 0: walk returned false before its loop, 1: walk loop ended, 2: not a random walk (stock
+   * kernel body). */
+  int status;
+
+  ccl_device_forceinline int state(const int index)
+  {
+    return path_index_array ? path_index_array[index] : index;
+  }
+
+  ccl_device_forceinline bool begin(const int state)
+  {
+    if (!(INTEGRATOR_STATE(state, path, flag) & PATH_RAY_SUBSURFACE_RANDOM_WALK)) {
+      status = 2;
+      return false;
+    }
+    /* subsurface_scatter: rng_state is loaded before the walk, which takes a copy. */
+    path_state_rng_load(state, &w.rng_state);
+    if (!sss_walk_begin(nullptr, state, w)) {
+      status = 0;
+      return false;
+    }
+    status = 1;
+    return true;
+  }
+
+  ccl_device_forceinline bool step(const int state)
+  {
+    return sss_walk_step(nullptr, state, w);
+  }
+
+  ccl_device_forceinline void finish(const int state)
+  {
+    KernelGlobals kg = nullptr;
+    if (status == 2) {
+      integrator_intersect_subsurface(kg, state);
+      return;
+    }
+    if (status == 1 && sss_walk_end(kg, state, w)) {
+      subsurface_scatter_exit(kg, state, w.ray, w.ss_isect.hits[0]);
+      return;
+    }
+    /* integrator_intersect_subsurface after subsurface_scatter returned false. */
+    integrator_path_terminate(kg, state, nullptr, DEVICE_KERNEL_INTEGRATOR_INTERSECT_SUBSURFACE);
+  }
+};
+
+/* [0] the fetch counter, [1] blocks finished in the current launch. */
+extern "C" __device__ uint sssdf_counters[2];
+__device__ uint sssdf_counters[2] = {0, 0};
+
+ccl_device_forceinline void integrator_intersect_subsurface_df(
+    const ccl_global int *path_index_array, const int work_size)
+{
+  IntersectSubsurfaceDFWork work;
+  work.path_index_array = path_index_array;
+  bvh2df_run_work(work, &sssdf_counters[0], work_size);
+  __syncthreads();
+  if (threadIdx.x == 0) {
+    __threadfence();
+    if (atomicAdd(&sssdf_counters[1], 1u) == gridDim.x - 1) {
+      sssdf_counters[0] = 0;
+      sssdf_counters[1] = 0;
+      __threadfence();
+    }
+  }
+}
+
+#endif /* __SUBSURFACE__ */
+
+CCL_NAMESPACE_END
diff --git a/intern/cycles/kernel/integrator/nrc.h b/intern/cycles/kernel/integrator/nrc.h
new file mode 100644
index 0000000..ac2e72d
--- /dev/null
+++ b/intern/cycles/kernel/integrator/nrc.h
@@ -0,0 +1,300 @@
+/* SPDX-FileCopyrightText: 2026 cycles-h100
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* Ours: neural radiance cache (NRC), CUDA only, compiled only with -DCYCLES_NRC.
+ *
+ * Path bookkeeping (this file, included from state_flow.h):
+ * - init_from_camera tags a path as a training path with probability train_threshold / 2^32 and gives it a
+ *   slot. A slot holds per-vertex features and throughputs, and radiance bins by bounce.
+ * - Every film write of a training path (emission, background, direct light through its shadow paths) also
+ *   goes into bin min(bounce, NV - 1) of its slot.
+ * - A slot is done when its main path and all its shadow paths have ended (reference count). Done slots go
+ *   into done_list; nrc_collect turns them into (input, target) records.
+ * The query side (features, termination, resolve) is below, guarded by NRC_SHADE (shade_surface.h). */
+
+#pragma once
+
+#ifdef CYCLES_NRC
+
+#  include "kernel/globals.h"
+#  include "kernel/types.h"
+#  include "util/atomic.h"
+#  include "util/hash.h"
+
+CCL_NAMESPACE_BEGIN
+
+ccl_device_forceinline ccl_global float *nrc_bin(const int slot, const int k)
+{
+  return kernel_nrc.slot_bins + ((size_t)slot * CYCLES_NRC_NV + k) * 3;
+}
+
+ccl_device_inline void nrc_slot_release(const int slot)
+{
+  if (atomicSub((unsigned int *)&kernel_nrc.slots[slot].ref, 1u) == 1u) {
+    kernel_nrc.slots[slot].status = NRC_SLOT_DONE;
+    const unsigned int i = atomicAdd(&kernel_nrc.ctrl->done_count, 1u);
+    kernel_nrc.done_list[i] = slot;
+  }
+}
+
+/* init_from_camera, after the path is set up and queued. */
+ccl_device_inline void nrc_path_begin(const int state, const uint pixel, const uint sample)
+{
+  if (!kernel_nrc.enabled) {
+    return;
+  }
+  kernel_nrc.main_spread[2 * state + 0] = 0.0f;
+  kernel_nrc.main_spread[2 * state + 1] = 0.0f;
+  int slot = -1;
+  if (kernel_nrc.ctrl->train && hash_uint2(pixel, sample) < kernel_nrc.train_threshold) {
+    const int h = int(atomicAdd(&kernel_nrc.ctrl->slot_head, 1u) % uint(kernel_nrc.num_slots));
+    if (atomicCAS(&kernel_nrc.slots[h].status, NRC_SLOT_FREE, NRC_SLOT_ACTIVE) == NRC_SLOT_FREE) {
+      kernel_nrc.slots[h].ref = 1;
+      kernel_nrc.slots[h].mask = 0;
+      for (int i = 0; i < CYCLES_NRC_NV * 3; i++) {
+        kernel_nrc.slot_bins[(size_t)h * CYCLES_NRC_NV * 3 + i] = 0.0f;
+      }
+      slot = h;
+      atomicAdd(&kernel_nrc.ctrl->tagged, 1u);
+    }
+  }
+  kernel_nrc.main_slot[state] = slot;
+}
+
+/* integrator_path_terminate. */
+ccl_device_forceinline void nrc_path_end(const int state)
+{
+  if (!kernel_nrc.enabled) {
+    return;
+  }
+  const int slot = kernel_nrc.main_slot[state];
+  if (slot >= 0) {
+    kernel_nrc.main_slot[state] = -1;
+    nrc_slot_release(slot);
+  }
+}
+
+/* integrator_shadow_path_init. */
+ccl_device_forceinline void nrc_shadow_begin(const int state, const int shadow_state)
+{
+  if (!kernel_nrc.enabled) {
+    return;
+  }
+  const int slot = kernel_nrc.main_slot[state];
+  kernel_nrc.shadow_slot[shadow_state] = slot;
+  if (slot >= 0) {
+    atomicAdd((unsigned int *)&kernel_nrc.slots[slot].ref, 1u);
+  }
+}
+
+/* integrator_shadow_path_terminate. */
+ccl_device_forceinline void nrc_shadow_end(const int shadow_state)
+{
+  if (!kernel_nrc.enabled) {
+    return;
+  }
+  const int slot = kernel_nrc.shadow_slot[shadow_state];
+  if (slot >= 0) {
+    kernel_nrc.shadow_slot[shadow_state] = -1;
+    nrc_slot_release(slot);
+  }
+}
+
+/* State compaction. */
+ccl_device_forceinline void nrc_state_move(const int to_state, const int from_state)
+{
+  if (!kernel_nrc.enabled) {
+    return;
+  }
+  kernel_nrc.main_slot[to_state] = kernel_nrc.main_slot[from_state];
+  kernel_nrc.main_slot[from_state] = -1;
+  kernel_nrc.main_spread[2 * to_state + 0] = kernel_nrc.main_spread[2 * from_state + 0];
+  kernel_nrc.main_spread[2 * to_state + 1] = kernel_nrc.main_spread[2 * from_state + 1];
+}
+
+ccl_device_forceinline void nrc_shadow_state_move(const int to_state, const int from_state)
+{
+  if (!kernel_nrc.enabled) {
+    return;
+  }
+  kernel_nrc.shadow_slot[to_state] = kernel_nrc.shadow_slot[from_state];
+  kernel_nrc.shadow_slot[from_state] = -1;
+}
+
+/* Film writes (after clamping), main path and shadow path. */
+ccl_device_inline void nrc_add_bin(const int slot, const int bounce, const float3 L)
+{
+  if (bounce < 1) {
+    return;
+  }
+  ccl_global float *bin = nrc_bin(slot, min(bounce, CYCLES_NRC_NV - 1));
+  atomicAdd(bin + 0, L.x);
+  atomicAdd(bin + 1, L.y);
+  atomicAdd(bin + 2, L.z);
+}
+
+ccl_device_forceinline void nrc_record_main(const int state, const int bounce, const float3 L)
+{
+  if (!kernel_nrc.enabled) {
+    return;
+  }
+  const int slot = kernel_nrc.main_slot[state];
+  if (slot >= 0) {
+    nrc_add_bin(slot, bounce, L);
+  }
+}
+
+ccl_device_forceinline void nrc_record_shadow(const int shadow_state, const int bounce, const float3 L)
+{
+  if (!kernel_nrc.enabled) {
+    return;
+  }
+  const int slot = kernel_nrc.shadow_slot[shadow_state];
+  if (slot >= 0) {
+    nrc_add_bin(slot, bounce, L);
+  }
+}
+
+/* nrc_collect: one thread per done slot. Target at vertex k = (sum of bins k .. NV-1) / T_k: the radiance the
+ * path brought back from the bounce at vertex k on, per unit throughput after that bounce. */
+ccl_device void nrc_collect(const int i)
+{
+  const int slot = kernel_nrc.done_list[i];
+  const unsigned int mask = kernel_nrc.slots[slot].mask;
+  float3 suffix = zero_float3();
+  for (int k = CYCLES_NRC_NV - 1; k >= 1; k--) {
+    const ccl_global float *bin = nrc_bin(slot, k);
+    suffix += make_float3(bin[0], bin[1], bin[2]);
+    if (!(mask & (1u << k))) {
+      continue;
+    }
+    const ccl_global float *T = kernel_nrc.slot_T + ((size_t)slot * CYCLES_NRC_NV + k) * 3;
+    const float3 t = make_float3(
+        (T[0] > 1e-8f) ? suffix.x / T[0] : 0.0f,
+        (T[1] > 1e-8f) ? suffix.y / T[1] : 0.0f,
+        (T[2] > 1e-8f) ? suffix.z / T[2] : 0.0f);
+    /* Throughput-weighted regression without per-record weights in the engine interface: a record of
+     * throughput T is written floor(mean(T) / tau + u) times, tau = mean throughput of earlier records. The
+     * network then learns sum(T * target) / sum(T), which times a query's T is the cell's expected tail even when
+     * T and radiance correlate (clamping, glossy lobes). */
+    int copies = 1;
+    const float Tm = (T[0] + T[1] + T[2]) * (1.0f / 3.0f);
+    if (kernel_nrc.train_weight) {
+      atomicAdd(&kernel_nrc.ctrl->T_sum, Tm);
+      atomicAdd(&kernel_nrc.ctrl->T_count, 1u);
+      const float tau = kernel_nrc.ctrl->tau;
+      if (tau > 0.0f) {
+        const float u = float(hash_uint3(uint(slot), uint(k), kernel_nrc.ctrl->T_count) >> 8) *
+                        (1.0f / 16777216.0f);
+        copies = min(int(Tm / tau + u), 16);
+      }
+    }
+    const float3 tf = ensure_finite(t);
+    const ccl_global uint4 *src = (const ccl_global uint4 *)(kernel_nrc.slot_feat +
+                                                             ((size_t)slot * CYCLES_NRC_NV + k) *
+                                                                 NRC_IN_FEATURES);
+    for (int j = 0; j < copies; j++) {
+      const unsigned int r = atomicAdd(&kernel_nrc.ctrl->record_count, 1u);
+      if (r >= (unsigned int)kernel_nrc.record_cap) {
+        break;
+      }
+      ccl_global uint4 *dst = (ccl_global uint4 *)(kernel_nrc.rec_in + (size_t)r * NRC_IN_FEATURES);
+      dst[0] = src[0];
+      dst[1] = src[1];
+      kernel_nrc.rec_T[(size_t)r * 3 + 0] = T[0];
+      kernel_nrc.rec_T[(size_t)r * 3 + 1] = T[1];
+      kernel_nrc.rec_T[(size_t)r * 3 + 2] = T[2];
+      kernel_nrc.rec_target[(size_t)r * 3 + 0] = tf.x;
+      kernel_nrc.rec_target[(size_t)r * 3 + 1] = tf.y;
+      kernel_nrc.rec_target[(size_t)r * 3 + 2] = tf.z;
+    }
+  }
+  kernel_nrc.slots[slot].status = NRC_SLOT_FREE;
+}
+
+/* nrc_resolve: one thread per query; adds throughput x prediction to the Combined pass. */
+ccl_device void nrc_resolve(ccl_global float *render_buffer, const int i)
+{
+  const NRCQueryMeta m = kernel_nrc.query_meta[i];
+  const ccl_global float *o = kernel_nrc.query_out + (size_t)i * 3;
+  float3 L = make_float3(m.r * fmaxf(o[0], 0.0f), m.g * fmaxf(o[1], 0.0f), m.b * fmaxf(o[2], 0.0f));
+  L = ensure_finite(L);
+  if (is_zero(L)) {
+    return;
+  }
+  if (kernel_data.film.light_pass_flag & PASSMASK(COMBINED)) {
+    ccl_global float *buffer = render_buffer +
+                               (uint64_t)m.pixel * kernel_data.film.pass_stride +
+                               kernel_data.film.pass_combined;
+    atomicAdd(buffer + 0, L.x);
+    atomicAdd(buffer + 1, L.y);
+    atomicAdd(buffer + 2, L.z);
+  }
+}
+
+/* Zero the inputs of rows [n0, n1) (the engine may run on a padded batch). */
+ccl_device void nrc_pad(const int n0, const int i)
+{
+  ccl_global uint4 *dst = (ccl_global uint4 *)(kernel_nrc.query_in +
+                                               (size_t)(n0 + i) * NRC_IN_FEATURES);
+  dst[0] = make_uint4(0, 0, 0, 0);
+  dst[1] = make_uint4(0, 0, 0, 0);
+}
+
+/* Stub cache (until the engine lands): per hash cell of (position grid, normal bin, bounce budgets), the
+ * throughput-weighted mean target sum(T * target) / sum(T) per channel. Training and query vertices come from the
+ * same path distribution, so sum over queries of T_q * mean = the expected tail of the cell's queries; a plain mean
+ * would miss the covariance of T and radiance inside a cell. */
+ccl_device_inline uint nrc_stub_cell(const ccl_global unsigned short *in)
+{
+  const int res = kernel_nrc.stub_res;
+  const int ix = clamp(int(half_to_float(in[0]) * res), 0, res - 1);
+  const int iy = clamp(int(half_to_float(in[1]) * res), 0, res - 1);
+  const int iz = clamp(int(half_to_float(in[2]) * res), 0, res - 1);
+  const int nt = clamp(int(half_to_float(in[5]) * 4.0f), 0, 3);
+  const int np = clamp(int(half_to_float(in[6]) * 4.0f), 0, 3);
+  uint key = uint(nt * 4 + np);
+  if (kernel_nrc.budget_feature) {
+    const int bd = clamp(int(half_to_float(in[14]) * 8.0f + 0.5f), 0, 8);
+    const int bg = clamp(int(half_to_float(in[15]) * 8.0f + 0.5f), 0, 8);
+    key += 16u * uint(1 + bd * 9 + bg);
+  }
+  if (kernel_nrc.stub_dir) {
+    const int dt = clamp(int(half_to_float(in[3]) * 4.0f), 0, 3);
+    const int dp = clamp(int(half_to_float(in[4]) * 8.0f), 0, 7);
+    key = key * 32u + uint(dt * 8 + dp) + 1u;
+  }
+  key = hash_uint2(key, 0x9e3779b9u);
+  return hash_uint3(uint(ix) ^ key, uint(iy), uint(iz) + 977u * key) &
+         ((1u << kernel_nrc.stub_log2) - 1u);
+}
+
+ccl_device void nrc_stub_train(const ccl_global unsigned short *in,
+                               const ccl_global float *target,
+                               const int i)
+{
+  const uint c = nrc_stub_cell(in + (size_t)i * NRC_IN_FEATURES);
+  ccl_global float *t = kernel_nrc.stub_table + (size_t)c * 8;
+  const ccl_global float *T = kernel_nrc.rec_T + (size_t)i * 3;
+  atomicAdd(t + 0, T[0] * target[(size_t)i * 3 + 0]);
+  atomicAdd(t + 1, T[1] * target[(size_t)i * 3 + 1]);
+  atomicAdd(t + 2, T[2] * target[(size_t)i * 3 + 2]);
+  atomicAdd(t + 3, T[0]);
+  atomicAdd(t + 4, T[1]);
+  atomicAdd(t + 5, T[2]);
+  atomicAdd(t + 6, 1.0f);
+}
+
+ccl_device void nrc_stub_infer(const ccl_global unsigned short *in, ccl_global float *out, const int i)
+{
+  const uint c = nrc_stub_cell(in + (size_t)i * NRC_IN_FEATURES);
+  const ccl_global float *t = kernel_nrc.stub_table + (size_t)c * 8;
+  out[(size_t)i * 3 + 0] = (t[3] > 0.0f) ? t[0] / t[3] : 0.0f;
+  out[(size_t)i * 3 + 1] = (t[4] > 0.0f) ? t[1] / t[4] : 0.0f;
+  out[(size_t)i * 3 + 2] = (t[5] > 0.0f) ? t[2] / t[5] : 0.0f;
+}
+
+CCL_NAMESPACE_END
+
+#endif /* CYCLES_NRC */
diff --git a/intern/cycles/kernel/integrator/nrc_types.h b/intern/cycles/kernel/integrator/nrc_types.h
new file mode 100644
index 0000000..ff7065b
--- /dev/null
+++ b/intern/cycles/kernel/integrator/nrc_types.h
@@ -0,0 +1,96 @@
+/* SPDX-FileCopyrightText: 2026 cycles-h100
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* Ours: neural radiance cache (NRC) shared layout. Included by the kernel (only with -DCYCLES_NRC) and by the
+ * host (integrator/nrc.cpp); the two copies of this file (tree53-nrc and blender-src-v5.3.0-svm) must stay
+ * identical. Every pointer is a device pointer; the host fills the struct and copies it to the cubin's
+ * __constant__ kernel_nrc symbol. */
+
+#pragma once
+
+#ifndef CYCLES_NRC_NV
+/* Vertices per training path: bins 1 .. NV-1 hold radiance by bounce, contributions at bounce >= NV-1 go to the
+ * last bin, vertices 1 .. NV-1 are stashed. */
+#  define CYCLES_NRC_NV 8
+#endif
+
+#define NRC_IN_FEATURES 16 /* = NRC_IN of nrc/include/cycles_nrc.h */
+#define NRC_SLOT_FREE 0
+#define NRC_SLOT_ACTIVE 1
+#define NRC_SLOT_DONE 2
+
+CCL_NAMESPACE_BEGIN
+
+/* Dynamic counters and flags, in device memory (written by kernels, read and reset by the host between
+ * kernel launches, stream-ordered). */
+struct NRCControl {
+  unsigned int query_count;  /* queries written (may exceed query_cap: extra ones are not written) */
+  unsigned int done_count;   /* entries in done_list */
+  unsigned int record_count; /* training records written by nrc_collect */
+  unsigned int slot_head;    /* ring allocator for training slots */
+  int terminate;             /* 1: non-training paths may end in the cache (0 during warm-up) */
+  int train;                 /* 1: tag training paths */
+  unsigned int dropped_queries;
+  unsigned int tagged;       /* training paths tagged (stats) */
+  float tau;                 /* record weighting: mean throughput of earlier records (0: no weighting yet) */
+  float T_sum;               /* sum of mean(T) over the records of this collect */
+  unsigned int T_count;
+  unsigned int pad;
+};
+
+/* Per training path (slot). */
+struct NRCSlot {
+  int status;    /* NRC_SLOT_* */
+  int ref;       /* main path + live shadow paths */
+  unsigned int mask; /* bit k: vertex k stashed */
+  int pad;
+};
+
+/* Query record metadata (inputs are a separate n x 16 fp16 array, outputs n x 3 fp32). */
+struct NRCQueryMeta {
+  unsigned int pixel; /* render_pixel_index */
+  float r, g, b;      /* path throughput after the bounce at the query vertex */
+};
+
+struct KernelNRC {
+  /* Static parameters. */
+  int enabled;
+  int min_bounce;           /* smallest bounce index (after the bounce) where a path may end */
+  float c;                  /* area-spread constant: end when spread^2 >= c * a0 */
+  int skip_singular;        /* never end after a singular (mirror/glass) bounce */
+  unsigned int train_threshold; /* tag when hash(pixel, sample) < threshold */
+  int num_slots;
+  int query_cap;
+  int record_cap;
+  float box_lo[4];
+  float box_scale[4]; /* 1 / extent */
+  int stub_log2;      /* stub hash table size log2 */
+  int stub_res;       /* stub grid resolution per axis */
+  int stub_dir;       /* stub: also key cells on the scattered direction (4 x 8 bins) */
+  int budget_feature; /* 1: features 14, 15 = remaining diffuse / glossy bounces (min with total) / 8 */
+  int train_match;    /* 1: a training path stashes only the vertex where a normal path would have ended */
+  int train_weight;   /* 1: write each record floor(mean(T) / tau + u) times (throughput-weighted regression) */
+  int diffuse_only;   /* nrc-bake: 1 = a path may end only after a diffuse bounce (label & LABEL_DIFFUSE) */
+  int pad[1];
+
+  /* Device arrays. */
+  ccl_global NRCControl *ctrl;
+  ccl_global int *main_slot;          /* [max_num_paths], -1 = not a training path */
+  ccl_global float *main_spread;      /* [max_num_paths * 2]: sqrt-sum S, a0 */
+  ccl_global int *shadow_slot;        /* [max_num_paths] */
+  ccl_global unsigned short *query_in; /* [query_cap * 16] fp16 */
+  ccl_global NRCQueryMeta *query_meta; /* [query_cap] */
+  ccl_global float *query_out;        /* [query_cap * 3] */
+  ccl_global NRCSlot *slots;          /* [num_slots] */
+  ccl_global unsigned short *slot_feat; /* [num_slots * NV * 16] fp16 */
+  ccl_global float *slot_T;           /* [num_slots * NV * 3] throughput after the bounce at vertex k */
+  ccl_global float *slot_bins;        /* [num_slots * NV * 3] radiance written with bounce k */
+  ccl_global int *done_list;          /* [num_slots] */
+  ccl_global unsigned short *rec_in;  /* [record_cap * 16] fp16 */
+  ccl_global float *rec_target;       /* [record_cap * 3] */
+  ccl_global float *rec_T;            /* [record_cap * 3] throughput of the record (stub weights) */
+  ccl_global float *stub_table;       /* [2^stub_log2 * 8]: sum T*target rgb, sum T rgb, count, 0 */
+};
+
+CCL_NAMESPACE_END
diff --git a/intern/cycles/kernel/integrator/shade_surface.h b/intern/cycles/kernel/integrator/shade_surface.h
index f260790..9916791 100644
--- a/intern/cycles/kernel/integrator/shade_surface.h
+++ b/intern/cycles/kernel/integrator/shade_surface.h
@@ -763,6 +763,143 @@ ccl_device_forceinline void integrate_surface_ao(KernelGlobals kg,
 }
 #endif /* defined(__AO__) */
 
+#ifdef CYCLES_NRC
+/* Ours (NRC): the 16 cache inputs of NRC_IN (nrc/include/cycles_nrc.h) at this vertex, as fp16: position in
+ * the scene box [0,1]^3, scattered direction and shading normal (theta/pi, phi/2pi + 0.5), roughness
+ * 1 - exp(-r), diffuse albedo, specular albedo (closure weights), and (budget_feature) the remaining diffuse and
+ * glossy bounces (each min with the remaining total) / 8: stock paths stop at the bounce limits, so the radiance
+ * a path brings back depends on its budget (classroom: 2 diffuse bounces). */
+ccl_device_forceinline float2 nrc_sph(const float3 d)
+{
+  return make_float2(acosf(clamp(d.z, -1.0f, 1.0f)) * M_1_PI_F,
+                     atan2f(d.y, d.x) * (0.5f * M_1_PI_F) + 0.5f);
+}
+
+ccl_device_forceinline uint nrc_h2(const float a, const float b)
+{
+  return uint(float_to_half(a)) | (uint(float_to_half(b)) << 16);
+}
+
+ccl_device_noinline void nrc_write_features(ConstIntegratorState state,
+                                            const ccl_private ShaderData *sd,
+                                            const float3 wo,
+                                            ccl_global unsigned short *out)
+{
+  float bd = 0.0f, bg = 0.0f;
+  if (kernel_nrc.budget_feature) {
+    const int rt = kernel_data.integrator.max_bounce - INTEGRATOR_STATE(state, path, bounce);
+    const int rd = kernel_data.integrator.max_diffuse_bounce -
+                   INTEGRATOR_STATE(state, path, diffuse_bounce);
+    const int rg = kernel_data.integrator.max_glossy_bounce -
+                   INTEGRATOR_STATE(state, path, glossy_bounce);
+    bd = float(clamp(min(rt, rd), 0, 8)) * 0.125f;
+    bg = float(clamp(min(rt, rg), 0, 8)) * 0.125f;
+  }
+  float3 diff = zero_float3();
+  float3 spec = zero_float3();
+  for (int i = 0; i < sd->num_closure; i++) {
+    const ccl_private ShaderClosure *sc = &sd->closure[i];
+    if (CLOSURE_IS_BSDF_DIFFUSE(sc->type) || CLOSURE_IS_BSSRDF(sc->type)) {
+      diff += sc->weight;
+    }
+    else if (CLOSURE_IS_BSDF_GLOSSY(sc->type) || CLOSURE_IS_BSDF_TRANSMISSION(sc->type) ||
+             CLOSURE_IS_GLASS(sc->type))
+    {
+      spec += sc->weight;
+    }
+  }
+  diff = saturate(diff);
+  spec = saturate(spec);
+  const float r = 1.0f - expf(-surface_shader_average_roughness(sd));
+  const float px = saturatef((sd->P.x - kernel_nrc.box_lo[0]) * kernel_nrc.box_scale[0]);
+  const float py = saturatef((sd->P.y - kernel_nrc.box_lo[1]) * kernel_nrc.box_scale[1]);
+  const float pz = saturatef((sd->P.z - kernel_nrc.box_lo[2]) * kernel_nrc.box_scale[2]);
+  const float2 dw = nrc_sph(wo);
+  const float2 dn = nrc_sph(sd->N);
+  ccl_global uint4 *dst = (ccl_global uint4 *)out;
+  dst[0] = make_uint4(nrc_h2(px, py), nrc_h2(pz, dw.x), nrc_h2(dw.y, dn.x), nrc_h2(dn.y, r));
+  dst[1] = make_uint4(
+      nrc_h2(diff.x, diff.y), nrc_h2(diff.z, spec.x), nrc_h2(spec.y, spec.z), nrc_h2(bd, bg));
+}
+
+/* Before the bounce at this vertex: grow the path's area spread (Mueller et al. 2021, eq. 3),
+ * a0 = d0^2 / (4 pi |cos|) at x1, S += sqrt(d^2 / (pdf |cos|)) at x2 and later. */
+ccl_device_forceinline float2 nrc_spread_update(ConstIntegratorState state,
+                                                const ccl_private ShaderData *sd)
+{
+  ccl_global float *sp = kernel_nrc.main_spread + 2 * state;
+  float S = sp[0], a0 = sp[1];
+  const float cosv = fmaxf(fabsf(dot(sd->N, sd->wi)), 1e-4f);
+  const float d2 = sqr(sd->ray_length);
+  if (INTEGRATOR_STATE(state, path, bounce) == 0) {
+    a0 = d2 * (0.25f * M_1_PI_F) / cosv;
+  }
+  else {
+    const float pdf = INTEGRATOR_STATE(state, path, mis_ray_pdf);
+    S += sqrtf(d2 / fmaxf(pdf * cosv, 1e-12f));
+  }
+  sp[0] = S;
+  sp[1] = a0;
+  return make_float2(S, a0);
+}
+
+/* After the bounce: a training path stashes the vertex; another path may end here, writing a query whose
+ * answer (incident radiance along the sampled direction) the resolve kernel adds to the Combined pass times the
+ * throughput after the bounce. Returns true when the path ends. */
+ccl_device_noinline bool nrc_after_bounce(ConstIntegratorState state,
+                                          const ccl_private ShaderData *sd,
+                                          const int label,
+                                          const float2 spread)
+{
+  if (!(label & (LABEL_REFLECT | LABEL_TRANSMIT)) ||
+      (label & (LABEL_TRANSPARENT | LABEL_SUBSURFACE_SCATTER | LABEL_RAY_PORTAL)))
+  {
+    return false;
+  }
+  const int k = INTEGRATOR_STATE(state, path, bounce);
+  /* Would a normal path end here (warm-up flag and buffer space aside)? */
+  const bool end_here = k >= kernel_nrc.min_bounce &&
+                        !(kernel_nrc.skip_singular && (label & LABEL_SINGULAR)) &&
+                        !(kernel_nrc.diffuse_only && !(label & LABEL_DIFFUSE)) &&
+                        spread.x * spread.x >= kernel_nrc.c * spread.y &&
+                        !(INTEGRATOR_STATE(state, path, flag) & PATH_RAY_SHADOW_CATCHER_PASS);
+  const int slot = kernel_nrc.main_slot[state];
+  if (slot >= 0) {
+    if (k >= 1 && k < CYCLES_NRC_NV &&
+        (!kernel_nrc.train_match || (end_here && kernel_nrc.slots[slot].mask == 0)))
+    {
+      const size_t v = (size_t)slot * CYCLES_NRC_NV + k;
+      nrc_write_features(
+          state, sd, INTEGRATOR_STATE(state, ray, D), kernel_nrc.slot_feat + v * NRC_IN_FEATURES);
+      const Spectrum T = INTEGRATOR_STATE(state, path, throughput);
+      kernel_nrc.slot_T[v * 3 + 0] = T.x;
+      kernel_nrc.slot_T[v * 3 + 1] = T.y;
+      kernel_nrc.slot_T[v * 3 + 2] = T.z;
+      kernel_nrc.slots[slot].mask |= (1u << k);
+    }
+    return false;
+  }
+  if (!end_here || !kernel_nrc.ctrl->terminate) {
+    return false;
+  }
+  const unsigned int q = atomicAdd(&kernel_nrc.ctrl->query_count, 1u);
+  if (q >= (unsigned int)kernel_nrc.query_cap) {
+    atomicAdd(&kernel_nrc.ctrl->dropped_queries, 1u);
+    return false;
+  }
+  nrc_write_features(
+      state, sd, INTEGRATOR_STATE(state, ray, D), kernel_nrc.query_in + (size_t)q * NRC_IN_FEATURES);
+  const Spectrum T = INTEGRATOR_STATE(state, path, throughput);
+  NRCQueryMeta m;
+  m.pixel = INTEGRATOR_STATE(state, path, render_pixel_index);
+  m.r = T.x;
+  m.g = T.y;
+  m.b = T.z;
+  kernel_nrc.query_meta[q] = m;
+  return true;
+}
+#endif /* CYCLES_NRC */
