+/* Ours: CYCLES_BVH4=1 builds the BVH4 side structure that cubins built with CYCLES_BVH4_CLOSEST or
+ * CYCLES_BVH4_SHADOW traverse in the DF closest/shadow kernels (kernel/bvh/bvh_wide_dynamic.h),
+ * collapsed from the packed BVH2 (bvh/bvh4_collapse.h) and uploaded as bvh4_nodes /
+ * bvh4_object_root / bvh4_root. The BVH2 arrays stay for every other kernel. The CUDA device
+ * refuses a mismatch between this env and the cubin (device/cuda/device_impl.cpp).
+ * CYCLES_BVH4_MODE=clip opens every BVH2 node and clips the children's boxes (bvh4_collapse.h);
+ * default exact. Motion blur is refused. Unset: nothing changes. */
+static bool bvh4_enabled()
+{
+  const char *env = getenv("CYCLES_BVH4");
+  return env != nullptr && atoi(env) == 1;
+}
+
+static void device_update_bvh4(Device *device, DeviceScene *dscene, Scene *scene)
+{
+  static_assert(PATH_RAY_VISIBILITY_NODE_UNALIGNED == bvh4int::NODE_UNALIGNED, "unaligned flag");
+  static_assert(sizeof(int4) == sizeof(bvh4int::Word4), "node word size");
+  const auto refuse = [](const string &why) {
+    fprintf(stderr, "CYCLES_BVH4: %s\n", why.c_str());
+    fflush(stderr);
+    abort();
+  };
+  bool motion = dscene->data.bvh.have_motion;
+  for (const Geometry *geom : scene->geometry) {
+    motion = motion || geom->has_motion_blur();
+  }
+  if (motion) {
+    refuse("the scene has motion blur; BVH4 is not built for motion (unset CYCLES_BVH4)");
+  }
+  const char *mode_env = getenv("CYCLES_BVH4_MODE");
+  const bool clip = mode_env != nullptr && string(mode_env) == "clip";
+  const double t0 = time_dt();
+  bvh4int::Result r;
+  const bool ok = bvh4int::collapse(reinterpret_cast<const bvh4int::Word4 *>(dscene->bvh_nodes.data()),
+                                    dscene->bvh_nodes.size(),
+                                    dscene->data.bvh.root,
+                                    dscene->object_node.data(),
+                                    dscene->object_node.size(),
+                                    r,
+                                    clip ? bvh4int::CLIP : bvh4int::EXACT);
+  if (!ok) {
+    refuse("collapse failed: " + r.error);
+  }
