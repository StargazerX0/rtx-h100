+/* Ours: CYCLES_AUTOCONFIG=1. The CUDA kernel's compile flags, derived from the scene's content only, by fixed
+ * rules (the measurement behind each: analysis/v53_autoconfig.md):
+ * - always: the scene's feature mask (-D__KERNEL_FEATURES__, as upstream adaptive compilation), intersect launch
+ *   bounds 64 x 16, the FMA slab test, forced inlining of the hot BSDF / shader-setup functions
+ *   (CYCLES_INLINE_HOT=2), depth-first closest and shadow traversal with the 4.5.0 knobs, SVM node pruning to the
+ *   node types the shaders use (generated svm_nodes_used.h) and the closure array cut to the scene's count;
+ * - subsurface scattering in the scene (KERNEL_FEATURE_SUBSURFACE): shade kernels 512 x 2, the depth-first
+ *   subsurface walk at 80 registers (64 x 12), depth-first shadow at 80 registers (minimum 12 blocks);
+ *   no subsurface: shade kernels 1024 x 1;
+ * - hair or curves in the scene (KERNEL_FEATURE_HAIR): depth-first closest and shadow at 96 registers (minimum
+ *   10 blocks); this takes precedence over the subsurface rule for the shadow kernel.
+ * Approximate mode (CYCLES_AUTOCONFIG_APPROX=1; analysis/v53_autoconfig_approx.md), on top of the above:
+ * - always: the merged exact macros (book fill, scan K 8, shadow move, sh2 x4) and the DF grid tag;
+ * - Russian roulette p = max(throughput)^e: e = 0.75 if the scene clamps indirect light below 5
+ *   (0 < sample_clamp_indirect < 5), else e = 1 (E64: e = 1 moved classroom, clamp 3.0, by -0.64%; monster, clamp
+ *   10, and junkshop, no clamp, pass);
+ * - a random-walk BSSRDF (random walk, legacy or skin) in a used shader: walk roulette q 0.97 after 32 steps (E63).
+ * The feature mask and SVM pruning need no rule: they read the scene after the settings script ran. */
+static void kernel_autoconfig_approx_scan(Scene *scene, bool &random_walk, float &clamp_indirect)
+{
+  random_walk = false;
+  clamp_indirect = scene->integrator->get_sample_clamp_indirect();
+  for (Shader *shader : scene->shaders) {
+    if (!shader->reference_count() || !shader->graph) {
+      continue;
+    }
+    for (ShaderNode *node : shader->graph->nodes) {
+      if (!node->has_surface_bssrdf()) {
+        continue;
+      }
+      ClosureType method = CLOSURE_NONE_ID;
+      if (node->type == PrincipledBsdfNode::get_node_type()) {
+        method = static_cast<PrincipledBsdfNode *>(node)->get_subsurface_method();
+      }
+      else if (node->type == SubsurfaceScatteringNode::get_node_type()) {
+        method = static_cast<SubsurfaceScatteringNode *>(node)->get_method();
+      }
+      if (method == CLOSURE_BSSRDF_RANDOM_WALK_ID || method == CLOSURE_BSSRDF_RANDOM_WALK_LEGACY_ID ||
