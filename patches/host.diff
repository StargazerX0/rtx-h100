+                               {"kernel/light/distribution.h", "CYCLES_SH2_LIGHTDIST"},
+                               {"kernel/integrator/path_state.h", "CYCLES_RR_EXP100"},
+                               {"kernel/integrator/subsurface_walk_steps.h", "CYCLES_SSS_WALK_RR_Q"}};
+    for (const auto &n : needed) {
+      string text;
+      if (!path_read_text(path_join(source, n[0]), text) || text.find(n[1]) == string::npos) {
+        error = string("CYCLES_AUTOCONFIG_APPROX: kernel source ") + source + " lacks " + n[1] + " in " + n[0] +
+                " (set CYCLES_AUTOCONFIG_SOURCE to tree53-merge2/intern/cycles)";
+        return string();
+      }
+    }
+  }
+
+  /* The flags of the CUDA kernel target for one arch (kernel/device/cuda/CMakeLists.txt; our offline cubins,
+   * jobs/stock_cubin53.sh, use the same), then the scene's flags. */
+  string base_flags =
+      "-D CCL_NAMESPACE_BEGIN= -D CCL_NAMESPACE_END= -D NVCC -m 64 -I \"" + source + "\" -I \"" + source +
+      "/kernel/device/cuda\" --use_fast_math -std=c++17";
+#ifdef WITH_NANOVDB
+  base_flags += " -D WITH_NANOVDB";
+#endif
+  base_flags += " -Wno-deprecated-gpu-targets --ptxas-options=-v";
+
+  /* Cache key: every input of the compile. */
+  const double key_start = time_dt();
+  const string source_md5 = path_files_md5_hash(source);
+  const string nvcc_version = command_output("\"" + nvcc + "\" --version 2>&1");
+  if (nvcc_version.find("release") == string::npos) {
+    error = "CYCLES_AUTOCONFIG: nvcc not usable: " + nvcc;
+    return string();
+  }
+  const string header_md5 = util_md5_string(config.svm_nodes_header);
+  const string key = util_md5_string("autoconfig-v1\n" + source_md5 + "\n" + nvcc_version + "\n" + arch +
+                                     "\n" + base_flags + "\n" + config.cflags + "\n" + header_md5);
+  const double key_time = time_dt() - key_start;
+
+  const string header_dir = path_join(cache, "svm_nodes_" + header_md5);
+  const string cubin = path_join(cache, "cycles_kernel_" + arch + "_" + key + ".cubin");
+
+  string cflags = config.cflags;
+  const string placeholder = "@SVM_NODES_DIR@";
+  const size_t at = cflags.find(placeholder);
+  if (at != string::npos) {
+    cflags.replace(at, placeholder.size(), "\"" + header_dir + "\"");
+  }
+
+  if (path_exists(cubin)) {
+    printf("CYCLES_AUTOCONFIG %s | flags: %s | cache hit %s (key %.2f s)\n",
+           config.summary.c_str(),
+           config.cflags.c_str(),
+           cubin.c_str(),
+           key_time);
+    fflush(stdout);
+    return cubin;
+  }
+
+  path_create_directories(path_join(header_dir, "svm_nodes_used.h"));
+  const string header_path = path_join(header_dir, "svm_nodes_used.h");
+  if (!path_exists(header_path) && !write_text_atomic(header_path, config.svm_nodes_header)) {
+    error = "CYCLES_AUTOCONFIG: cannot write " + header_path;
+    return string();
+  }
+
+  const string tmp_cubin = cubin + string_printf(".tmp.%d", int(getpid()));
+  const string log_path = cubin + ".ptxas.log";
+  const string command = "\"" + nvcc + "\" -arch=" + arch + " --cubin \"" + source +
+                         "/kernel/device/cuda/kernel.cu\" " + base_flags + " " + cflags + " -o \"" +
+                         tmp_cubin + "\"";
+  write_text_atomic(cubin + ".cmd.txt", command + "\n");
+
+  printf("CYCLES_AUTOCONFIG compiling %s kernel (cache miss %s)\n", arch.c_str(), cubin.c_str());
+  fflush(stdout);
+  const double start = time_dt();
+  const int rc = system((command + " > \"" + log_path + ".tmp\" 2>&1").c_str());
+  const double compile_time = time_dt() - start;
+  rename((log_path + ".tmp").c_str(), log_path.c_str());
+  if (rc != 0 || !path_exists(tmp_cubin)) {
+    path_remove(tmp_cubin);
+    error = string_printf("CYCLES_AUTOCONFIG: nvcc failed (rc %d), see %s", rc, log_path.c_str());
+    return string();
+  }
+  if (rename(tmp_cubin.c_str(), cubin.c_str()) != 0) {
+    error = "CYCLES_AUTOCONFIG: cannot move the cubin into " + cubin;
+    return string();
+  }
+
+  printf("CYCLES_AUTOCONFIG %s | flags: %s | cache miss, compiled %s in %.1f s\n",
+         config.summary.c_str(),
+         config.cflags.c_str(),
+         cubin.c_str(),
+         compile_time);
+  fflush(stdout);
+  return cubin;
+}
+
+CCL_NAMESPACE_END
diff --git a/intern/cycles/device/kernel_autoconfig.h b/intern/cycles/device/kernel_autoconfig.h
new file mode 100644
index 0000000..26d85b3
--- /dev/null
+++ b/intern/cycles/device/kernel_autoconfig.h
@@ -0,0 +1,61 @@
+/* SPDX-FileCopyrightText: 2011-2022 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* Ours: kernel autoconfiguration (env CYCLES_AUTOCONFIG=1; unset = stock).
+ *
+ * The scene derives the CUDA kernel's compile flags from its own content (feature mask, the SVM node types its
+ * shaders use, its closure count) by fixed rules (scene/scene.cpp kernel_autoconfig_derive), and the CUDA device
+ * compiles that kernel at load time, as upstream adaptive compilation does, from the kernel tree given by
+ * CYCLES_AUTOCONFIG_SOURCE with the nvcc given by CYCLES_AUTOCONFIG_NVCC, and caches the cubin in
+ * CYCLES_AUTOCONFIG_CACHE under a key over every flag, the generated header, the kernel sources and nvcc. */
+
+#pragma once
+
+#include <cstdlib>
+
+#include "util/string.h"
+
+CCL_NAMESPACE_BEGIN
+
+struct KernelAutoconfig {
+  /* Kernel compile flags derived from the scene (without the SVM header include path). */
+  string cflags;
+  /* Content of the generated svm_nodes_used.h (-DCYCLES_SVM_NODES_USED). */
+  string svm_nodes_header;
+  /* What the rules saw, for the log line. */
+  string summary;
+};
+
+/* Inline, so that the BVH and queue code can test it without a link dependency. */
+inline bool kernel_autoconfig_enabled()
+{
+  const char *value = getenv("CYCLES_AUTOCONFIG");
+  return value != nullptr && atoi(value) != 0;
+}
+
+/* Ours: approximate mode (env CYCLES_AUTOCONFIG_APPROX=1 on top of CYCLES_AUTOCONFIG=1; analysis/
+ * v53_autoconfig_approx.md). The kernel also gets the merged exact macros and the approximate ones (Russian
+ * roulette exponent from the scene's indirect clamp, random-walk subsurface roulette where the scene has a
+ * random-walk BSSRDF), and the host gets one set of defaults for every scene (kernel_autoconfig_host_defaults).
+ * It needs a kernel tree with these macros (tree53-merge2) in CYCLES_AUTOCONFIG_SOURCE. */
+inline bool kernel_autoconfig_approx_enabled()
+{
+  const char *value = getenv("CYCLES_AUTOCONFIG_APPROX");
+  return kernel_autoconfig_enabled() && value != nullptr && atoi(value) != 0;
+}
+
+/* Approximate mode: set the host defaults (CYCLES_BOOK_SCAN=1, CYCLES_SHADOW_COMPACT_FACTOR=4; with
+ * CYCLES_AUTOCONFIG_APPROX_HOSTFIX=1 also CYCLES_DF_GRID=resident and CYCLES_SHADOW_POOL_FACTOR=2) for every env the
+ * user did not set. Idempotent; called by the CUDA device constructor, before any of them is read. */
+void kernel_autoconfig_host_defaults();
+
+/* Set by the scene before the kernels are loaded; read by the device. */
+void kernel_autoconfig_set(const KernelAutoconfig &config);
+const KernelAutoconfig &kernel_autoconfig_get();
+
+/* Path of the cubin for sm_<major><minor> built with the scene's flags: from the cache, or compiled with nvcc into
+ * the cache. Logs one line (flags, cache hit or miss, compile time). Empty string and `error` set on failure. */
+string kernel_autoconfig_cubin(int major, int minor, string &error);
+
+CCL_NAMESPACE_END
