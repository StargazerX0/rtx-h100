+  if (opt_passes > 0) {
+    double opt_f = 0.002;
+    if (const char *f = getenv("CYCLES_BVH2_OPTIMIZE_F")) {
+      opt_f = atof(f);
+    }
+    if (const char *f = getenv(params.top_level ? "CYCLES_BVH2_OPTIMIZE_F_TOP" :
+                                                  "CYCLES_BVH2_OPTIMIZE_F_OBJ"))
+    {
+      opt_f = atof(f);
+    }
+    const char *ov = getenv("CYCLES_BVH2_OPTIMIZE_OVERLAP");
+    const char *ord = getenv("CYCLES_BVH2_OPTIMIZE_ORDER");
+    const char *tn = getenv("CYCLES_BVH2_OPTIMIZE_N");
+    bvh2_optimize_topology(bvh2_root.get(),
+                           opt_passes,
+                           opt_f,
+                           ov ? atof(ov) : 0.0,
+                           ord ? atoi(ord) : 1,
+                           tn ? atoi(tn) : 7);
+  }
+
   /* BVH builder returns tree in a binary mode (with two children per inner
    * node. Need to adopt that for a wider BVH implementations. */
   const unique_ptr<BVHNode> root = widen_children_nodes(std::move(bvh2_root));
diff --git a/intern/cycles/bvh/bvh2_treelet.h b/intern/cycles/bvh/bvh2_treelet.h
new file mode 100644
index 0000000..d983a33
--- /dev/null
+++ b/intern/cycles/bvh/bvh2_treelet.h
@@ -0,0 +1,346 @@
+/* Ours (cycles-h100, CYCLES_BVH2_OPTIMIZE; copy of bvhopt/treelet.h). Post-build BVH2 topology optimizer with fixed leaves.
+ *
+ * Treelet restructuring after Karras & Aila 2013 ("Fast parallel construction of high-quality bounding volume
+ * hierarchies"): for every inner node r (children before parents), grow a treelet of up to N leaves by repeatedly
+ * opening the treelet leaf with the largest surface area that is an inner node, then find by dynamic programming over
+ * leaf subsets the binary tree over those leaves with the smallest sum of inner-node surface areas, and rebuild the
+ * treelet if it is cheaper. With the BVH leaves fixed, the leaf term of the SAH is constant, so the sum of inner-node
+ * areas is the whole objective.
+ *
+ * Boxes: every rebuilt inner box is the float min/max union of its children's boxes (the builder's BoundBox::grow), so
+ * no box shrinks below its contents; the treelet root's box is the union of the same leaves, hence unchanged bit for
+ * bit, and nothing above the treelet changes. Visibility is the OR of the children.
+ *
+ * Header-only, no Cycles types. Entities: inner node i >= 0, BVH leaf l encoded as ~l (< 0). Node 0 is the root.
+ * The parallel driver cuts the tree at depth `cut_depth`; the subtrees below the cut are disjoint, so their nodes are
+ * processed in parallel, then the nodes above the cut sequentially. The result does not depend on the thread count.
+ */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace bvhopt {
+
+struct Box {
+  float lo[3], hi[3];
+};
+
+static inline double overlap_half_area(const Box &a, const Box &b)
+{
+  double e[3];
+  for (int k = 0; k < 3; k++) {
+    e[k] = double(std::min(a.hi[k], b.hi[k])) - double(std::max(a.lo[k], b.lo[k]));
+    if (e[k] <= 0.0) {
+      return 0.0;
+    }
+  }
+  return e[0] * e[1] + e[1] * e[2] + e[2] * e[0];
+}
+
+static inline Box box_union(const Box &a, const Box &b)
+{
+  Box r;
+  for (int k = 0; k < 3; k++) {
+    r.lo[k] = std::min(a.lo[k], b.lo[k]);
+    r.hi[k] = std::max(a.hi[k], b.hi[k]);
+  }
+  return r;
+}
+
+static inline double half_area(const Box &b)
+{
+  const double x = std::max(0.0, double(b.hi[0]) - double(b.lo[0]));
+  const double y = std::max(0.0, double(b.hi[1]) - double(b.lo[1]));
+  const double z = std::max(0.0, double(b.hi[2]) - double(b.lo[2]));
+  return x * y + y * z + z * x;
+}
+
+static inline double volume(const Box &b)
+{
+  const double x = std::max(0.0, double(b.hi[0]) - double(b.lo[0]));
+  const double y = std::max(0.0, double(b.hi[1]) - double(b.lo[1]));
+  const double z = std::max(0.0, double(b.hi[2]) - double(b.lo[2]));
+  return x * y * z;
+}
+
+struct Tree {
+  /* Node cost = half area + vol_weight * volume. 0: SAH. For segments of length L in random directions, the measure
+   * of segments that meet a convex box is proportional to V + L*A/4 = V + L*H/2, so vol_weight = 2/L. */
+  double vol_weight = 0.0;
+  /* Extra cost per inner node = overlap_weight * half area of the intersection of its two child boxes. Sibling overlap
+   * makes nearest-first traversal of terminating rays (occluded shadow rays) open both children. 0: off. */
+  double overlap_weight = 0.0;
+  /* Child order of rebuilt nodes. Traversal visits the nearer child first and child 0 on ties (a ray starting inside
+   * both boxes), so the order matters for rays that stop at their first hit. 1: as the builder's splits, the child
+   * with the lower box center on the axis where the centers differ most comes first. 0: DP order. -1: reversed. */
+  int order = 1;
+  double cost(const Box &b) const
+  {
+    return vol_weight > 0.0 ? half_area(b) + vol_weight * volume(b) : half_area(b);
+  }
+  /* inner nodes */
+  std::vector<int> c0, c1;
+  std::vector<Box> box;
+  std::vector<uint32_t> vis;
+  std::vector<uint8_t> fixed; /* 1: never restructure through this node (e.g. unaligned or motion node) */
+  /* leaves */
+  std::vector<Box> lbox;
+  std::vector<uint32_t> lvis;
+
+  int num_inner() const
+  {
+    return int(c0.size());
+  }
+  const Box &ebox(int e) const
+  {
+    return e >= 0 ? box[e] : lbox[~e];
+  }
+  uint32_t evis(int e) const
+  {
+    return e >= 0 ? vis[e] : lvis[~e];
+  }
+};
+
+/* Sum of inner-node half areas (root included). */
+static inline double inner_area_sum(const Tree &t)
+{
+  double s = 0;
+  for (int i = 0; i < t.num_inner(); i++) {
+    s += half_area(t.box[i]);
+  }
+  return s;
+}
+
+/* Recompute every inner box and visibility from the leaves (same topology). Children-first order via post-order. */
+static inline void refit(Tree &t)
+{
+  if (t.num_inner() == 0) {
+    return;
+  }
+  std::vector<int> order;
+  order.reserve(t.num_inner());
+  std::vector<std::pair<int, int>> st;
+  st.push_back({0, 0});
+  while (!st.empty()) {
+    auto &f = st.back();
+    if (f.second < 2) {
+      const int c = f.second++ == 0 ? t.c0[f.first] : t.c1[f.first];
+      if (c >= 0) {
+        st.push_back({c, 0});
+      }
+    }
+    else {
+      order.push_back(f.first);
+      st.pop_back();
+    }
+  }
+  for (int i : order) {
+    t.box[i] = box_union(t.ebox(t.c0[i]), t.ebox(t.c1[i]));
+    t.vis[i] = t.evis(t.c0[i]) | t.evis(t.c1[i]);
+  }
+}
+
+struct Scratch {
+  Box sbox[256];
+  double area[256];
+  double cost[256];
+  uint8_t split[256];
+  int leaves[8];
+  int inner[8];
+  int next_inner;
+};
+
+template<int N> static int treelet_rebuild(Tree &t, Scratch &s, int mask, int full, int r)
+{
+  if ((mask & (mask - 1)) == 0) {
+    int b = 0;
+    while (!(mask >> b & 1)) {
+      b++;
+    }
+    return s.leaves[b];
+  }
+  const int id = (mask == full) ? r : s.inner[s.next_inner++];
+  const int p = s.split[mask];
+  const int a = treelet_rebuild<N>(t, s, p, full, r);
+  const int b = treelet_rebuild<N>(t, s, mask ^ p, full, r);
+  bool swap = false;
+  if (t.order != 0) {
+    const Box &ba = t.ebox(a), &bb = t.ebox(b);
+    int axis = 0;
+    double best = -1.0;
+    for (int k = 0; k < 3; k++) {
+      const double d = std::abs((double(ba.lo[k]) + double(ba.hi[k])) - (double(bb.lo[k]) + double(bb.hi[k])));
+      if (d > best) {
+        best = d;
+        axis = k;
+      }
+    }
+    const double ca = double(ba.lo[axis]) + double(ba.hi[axis]), cb = double(bb.lo[axis]) + double(bb.hi[axis]);
+    swap = (t.order > 0) ? (cb < ca) : (ca < cb);
+  }
+  t.c0[id] = swap ? b : a;
+  t.c1[id] = swap ? a : b;
+  t.box[id] = box_union(t.ebox(a), t.ebox(b));
+  t.vis[id] = t.evis(a) | t.evis(b);
+  return id;
+}
+
+/* Restructure the treelet rooted at r. Returns 1 if it was rebuilt. */
+template<int N> static int treelet_optimize(Tree &t, Scratch &s, int r, double rel_eps)
+{
+  if (t.fixed[r]) {
+    return 0;
+  }
+  int n = 2, ni = 1;
+  s.leaves[0] = t.c0[r];
+  s.leaves[1] = t.c1[r];
+  s.inner[0] = r;
+  double old_cost = t.cost(t.box[r]);
+  while (n < N) {
+    int best = -1;
+    double best_a = -1;
+    for (int i = 0; i < n; i++) {
+      const int e = s.leaves[i];
+      if (e >= 0 && !t.fixed[e]) {
+        const double a = t.cost(t.box[e]);
+        if (a > best_a) {
+          best_a = a;
+          best = i;
+        }
+      }
+    }
+    if (best < 0) {
+      break;
+    }
+    const int e = s.leaves[best];
+    s.inner[ni++] = e;
+    old_cost += best_a;
+    s.leaves[best] = t.c0[e];
+    s.leaves[n++] = t.c1[e];
+  }
+  if (n < 3) {
+    return 0;
+  }
+  if (t.overlap_weight > 0.0) {
+    for (int i = 0; i < ni; i++) {
+      old_cost += t.overlap_weight * overlap_half_area(t.ebox(t.c0[s.inner[i]]), t.ebox(t.c1[s.inner[i]]));
+    }
+  }
+  const int full = (1 << n) - 1;
+  for (int i = 0; i < n; i++) {
+    s.sbox[1 << i] = t.ebox(s.leaves[i]);
+    s.cost[1 << i] = 0;
+  }
+  for (int m = 1; m <= full; m++) {
+    if ((m & (m - 1)) == 0) {
+      continue;
+    }
+    const int low = m & -m;
+    s.sbox[m] = box_union(s.sbox[m ^ low], s.sbox[low]);
+    s.area[m] = t.cost(s.sbox[m]);
+  }
+  /* masks in increasing order: every proper subset is smaller than its superset */
+  for (int m = 1; m <= full; m++) {
+    if ((m & (m - 1)) == 0) {
+      continue;
+    }
+    const int low = m & -m;
+    double best = INFINITY;
+    int bp = 0;
+    /* partitions {p, m^p} with the lowest bit in p, p != m */
+    const int rest = m ^ low;
+    for (int q = (rest - 1) & rest;; q = (q - 1) & rest) {
+      const int p = q | low;
+      double c = s.cost[p] + s.cost[m ^ p];
+      if (t.overlap_weight > 0.0) {
+        c += t.overlap_weight * overlap_half_area(s.sbox[p], s.sbox[m ^ p]);
+      }
+      if (c < best) {
+        best = c;
+        bp = p;
+      }
+      if (q == 0) {
+        break;
+      }
+    }
+    s.cost[m] = s.area[m] + best;
+    s.split[m] = uint8_t(bp);
+  }
+  if (!(s.cost[full] < old_cost * (1.0 - rel_eps))) {
+    return 0;
+  }
+  s.next_inner = 1;
+  treelet_rebuild<N>(t, s, full, full, r);
+  return 1;
+}
+
+static inline void post_order(const Tree &t, int root, int depth0, int cut_depth, std::vector<int> &out,
+                              std::vector<int> *cut_roots)
+{
+  std::vector<std::pair<int, int>> st; /* node, state; depth tracked in a parallel stack */
+  std::vector<int> dep;
+  st.push_back({root, 0});
+  dep.push_back(depth0);
+  while (!st.empty()) {
+    const int node = st.back().first;
+    const int d = dep.back();
+    if (cut_roots && d == cut_depth) {
+      cut_roots->push_back(node);
+      st.pop_back();
+      dep.pop_back();
+      continue;
+    }
+    int &state = st.back().second;
+    if (state < 2) {
+      const int c = state++ == 0 ? t.c0[node] : t.c1[node];
+      if (c >= 0) {
+        st.push_back({c, 0});
+        dep.push_back(d + 1);
+      }
+    }
+    else {
+      out.push_back(node);
+      st.pop_back();
+      dep.pop_back();
+    }
+  }
+}
+
+/* passes: number of sweeps; N: treelet leaves (5..8). ParallelFor(n, fn(i)) runs fn for i in [0, n). */
+template<int N, class ParallelFor>
+static long long optimize(Tree &t, int passes, ParallelFor &&pfor, int cut_depth = 12, double rel_eps = 1e-6)
+{
+  static_assert(N >= 3 && N <= 8, "treelet size");
+  if (t.num_inner() < 2) {
+    return 0;
+  }
+  long long rebuilt = 0;
+  for (int pass = 0; pass < passes; pass++) {
+    std::vector<int> top, cuts;
+    post_order(t, 0, 0, cut_depth, top, &cuts);
+    std::vector<long long> per(cuts.size(), 0);
+    pfor(int(cuts.size()), [&](int i) {
+      std::vector<int> order;
+      post_order(t, cuts[i], 0, -1, order, nullptr);
+      Scratch s;
+      long long k = 0;
+      for (int node : order) {
+        k += treelet_optimize<N>(t, s, node, rel_eps);
+      }
+      per[i] = k;
+    });
+    Scratch s;
+    for (int node : top) {
+      rebuilt += treelet_optimize<N>(t, s, node, rel_eps);
+    }
+    for (long long k : per) {
+      rebuilt += k;
+    }
+  }
+  return rebuilt;
+}
+
+}  // namespace bvhopt
diff --git a/intern/cycles/bvh/bvh4_collapse.h b/intern/cycles/bvh/bvh4_collapse.h
new file mode 100644
index 0000000..c5d0850
--- /dev/null
+++ b/intern/cycles/bvh/bvh4_collapse.h
@@ -0,0 +1,381 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+/* BVH2 -> BVH4 collapse for the DF BVH4 kernels (kernel/bvh/bvh_wide_dynamic.h), on the packed
+ * BVH2 arrays the device gets (bvh_nodes, object_node, kernel_data.bvh.root). Self-contained (no
+ * Cycles headers): a float4 is 4 x 32-bit words.
+ *
+ * Rule (bvh4/bvhcount.cpp build_wide at W=4, replay53-bvh4/replayer.cu W4Build): top-down; the
+ * inner child with the largest surface area is opened first (the first one on ties) and replaced
+ * in place by its two children, until 4 children or no inner child is left. The top-level tree
+ * and every object tree are collapsed separately; a BVH2 node shared by several objects (one
+ * instanced mesh) becomes one BVH4 node (memo). Leaves keep their BVH2 addresses (negative refs
+ * into bvh_leaf_nodes).
+ *
+ * Node i: 8 float4 at [8i, 8i+8): [0..5] lo_x hi_x lo_y hi_y lo_z hi_z of the 4 children, [6]
+ * child refs, [7] child visibility. Empty slots: lo = +inf, hi = -inf, ref 0, visibility 0.
+ *
+ * Exactness: BVH2 tests a node's box before its children's; BVH4 tests the children's boxes only.
+ * The FMA slab test is monotone in the plane values, so when both children's boxes lie inside the
+ * node's box (per axis) and their visibility bits inside the node's, a child box passes only if the
+ * node's box passes: the leaves reached are the BVH2 ones. Mode:
+ *   EXACT  (default) a node whose children are not contained in its box (junkshop: 30% of the
+ *          nodes, spatial-split/curve bounds) is not opened; it stays a child slot and gets its own
+ *          BVH4 node, so its box is still tested first. Leaves reached = BVH2's.
+ *   CLIP   every node is opened, and the children's boxes are clipped to it (intersection): a child
+ *          passes only if the clipped box does, which implies both the child and the node pass.
+ *          Leaves reached are a subset of BVH2's: equal hits if each box bounds its primitives.
+ *   REPLAY every node is opened, boxes as stored (the replay's collapse): a superset of BVH2's.
+ * Every stored box is sorted per axis (min, max): the BVH2 test is symmetric in lo/hi, the BVH4
+ * octant test is not.
+ *
+ * Unaligned (hair) BVH2 nodes: their child boxes are oriented, so they are never opened. A child
+ * whose BVH2 node is unaligned keeps its parent's axis-aligned box and gets the ref
+ * BVH4_BVH2_TAG + its BVH2 address: the kernel traverses that subtree as BVH2. A root that is
+ * itself unaligned becomes such a ref too. */
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace bvh4int {
+
+static const int BVH4_BVH2_TAG = 0x40000000;
+static const int ENTRYPOINT_SENTINEL_ = 0x76543210;
+static const uint32_t NODE_UNALIGNED = 1u << 15; /* PATH_RAY_VISIBILITY_NODE_UNALIGNED */
+
+struct Word4 {
+  uint32_t w[4];
+};
+
+enum Mode { EXACT = 0, CLIP = 1, REPLAY = 2 };
+
+struct Result {
+  std::vector<Word4> nodes; /* 8 per BVH4 node */
+  int root = 0;
+  std::vector<int> object_root;
+  long long num_nodes = 0, filled = 0, handoff_children = 0, handoff_roots = 0;
+  long long kept_closed = 0; /* EXACT: inner children not opened (not contained) */
+  long long clipped = 0;     /* CLIP: opened nodes whose children needed clipping */
+  /* Upper bound of the kernel's stack entries: base sentinel + top-level pushes + instance
+   * sentinel + object pushes (a BVH4 node pushes at most children - 1, a BVH2 node 1). The kernel
+   * stack has BVH_STACK_SIZE (192) entries; the host refuses a larger bound. */
+  int max_stack = 0;
+  std::string error;
+};
+
+namespace detail {
+
+inline float as_float(uint32_t u)
+{
+  float f;
+  std::memcpy(&f, &u, 4);
+  return f;
+}
+inline uint32_t as_uint(float f)
+{
+  uint32_t u;
+  std::memcpy(&u, &f, 4);
+  return u;
+}
+
+struct Child {
+  int ref;     /* >= 0 BVH2 inner address (openable), < 0 leaf, or TAG + address (handoff) */
+  bool inner;  /* aligned BVH2 inner node: gets a BVH4 node if not opened */
+  bool open;   /* may be opened (EXACT: children contained) */
+  float lo[3], hi[3];
+  uint32_t vis;
+  float area;
+};
+
+struct Builder {
+  const Word4 *n2;
+  size_t n2_size;
+  std::vector<int> memo;
+  std::vector<int> need4;                 /* per BVH4 node: stack pushes below it */
+  std::unordered_map<int, int> need2;     /* per handoff BVH2 node */
+  Result &out;
+  Mode mode;
+  bool ok = true;
+
+  uint32_t unaligned_flag;
+
+  Builder(const Word4 *n, size_t size, Result &r, Mode m, uint32_t uflag)
+      : n2(n), n2_size(size), memo(size, -1), out(r), mode(m), unaligned_flag(uflag)
+  {
+  }
+
+  bool valid_inner(int a) const
+  {
+    return a >= 0 && size_t(a) + 4 <= n2_size;
+  }
+  bool unaligned(int a) const
+  {
+    return (n2[a].w[0] & unaligned_flag) != 0;
+  }
+
+  /* Child `which` of the aligned BVH2 node p2. */
+  Child child(int p2, int which)
+  {
+    Child c;
+    const Word4 &cn = n2[p2];
+    const int ref = int(which ? cn.w[3] : cn.w[2]);
+    c.vis = which ? cn.w[1] : cn.w[0];
+    const Word4 &a = n2[p2 + 1], &b = n2[p2 + 2], &d = n2[p2 + 3];
+    const int lo = which ? 1 : 0, hi = which ? 3 : 2;
+    const Word4 *rows[3] = {&a, &b, &d};
+    for (int k = 0; k < 3; k++) {
+      const float l = as_float(rows[k]->w[lo]), h = as_float(rows[k]->w[hi]);
+      c.lo[k] = (mode == REPLAY) ? l : std::min(l, h);
+      c.hi[k] = (mode == REPLAY) ? h : std::max(l, h);
+    }
+    double e[3];
+    for (int k = 0; k < 3; k++) {
+      e[k] = std::max(0.0, double(c.hi[k]) - double(c.lo[k]));
+    }
+    c.area = float(2 * (e[0] * e[1] + e[1] * e[2] + e[2] * e[0]));
+    c.ref = ref;
+    c.inner = false;
+    c.open = false;
+    if (ref >= 0) {
+      if (!valid_inner(ref)) {
+        fail("child ref out of range");
+        c.ref = 0;
+      }
+      else if (unaligned(ref)) {
+        c.ref = BVH4_BVH2_TAG + ref;
+        out.handoff_children++;
+      }
+      else {
+        c.inner = true;
+        c.open = (mode != EXACT) || contained(c, ref);
+        if (!c.open) {
+          out.kept_closed++;
+        }
+      }
+    }
+    return c;
+  }
+
+  /* Both children of the aligned node `node` inside the box and visibility of slot c. */
+  bool contained(const Child &c, int node) const
+  {
+    const Word4 &cn = n2[node];
+    for (int which = 0; which < 2; which++) {
+      if ((cn.w[which] & ~c.vis) & ~unaligned_flag) {
+        return false;
+      }
+      const int lo = which ? 1 : 0, hi = which ? 3 : 2;
+      for (int k = 0; k < 3; k++) {
+        const float l = as_float(n2[node + 1 + k].w[lo]), h = as_float(n2[node + 1 + k].w[hi]);
+        if (!(std::min(l, h) >= c.lo[k] && std::max(l, h) <= c.hi[k])) {
+          return false;
+        }
+      }
+    }
+    return true;
+  }
+
+  /* CLIP: children of an opened slot p are clipped to p's box. */
+  void clip(Child &c, const Child &p)
+  {
+    bool changed = false;
+    for (int k = 0; k < 3; k++) {
+      if (c.lo[k] < p.lo[k]) {
+        c.lo[k] = p.lo[k];
+        changed = true;
+      }
+      if (c.hi[k] > p.hi[k]) {
+        c.hi[k] = p.hi[k];
+        changed = true;
+      }
+    }
+    if (changed) {
+      double e[3];
+      for (int k = 0; k < 3; k++) {
+        e[k] = std::max(0.0, double(c.hi[k]) - double(c.lo[k]));
+      }
+      c.area = float(2 * (e[0] * e[1] + e[1] * e[2] + e[2] * e[0]));
+    }
+    clip_changed |= changed;
+  }
+  bool clip_changed = false;
+
+  void fail(const char *msg)
+  {
+    if (ok) {
+      out.error = msg;
+    }
+    ok = false;
+  }
+
+  /* BVH4 node for the aligned BVH2 inner node addr. */
+  int build(int addr)
+  {
+    if (memo[addr] >= 0) {
+      return memo[addr];
+    }
+    const int idx = int(out.nodes.size() / 8);
+    if (idx >= BVH4_BVH2_TAG) {
+      fail("too many BVH4 nodes");
+      return 0;
+    }
+    out.nodes.resize(out.nodes.size() + 8);
+    memo[addr] = idx;
+    out.num_nodes++;
+    Child list[4];
+    int n = 2;
+    list[0] = child(addr, 0);
+    list[1] = child(addr, 1);
+    while (n < 4) {
+      int best = -1;
+      for (int i = 0; i < n; i++) {
+        if (list[i].open && (best < 0 || list[i].area > list[best].area)) {
+          best = i;
+        }
+      }
+      if (best < 0) {
+        break;
+      }
+      const Child p = list[best];
+      Child c0 = child(p.ref, 0), c1 = child(p.ref, 1);
+      if (mode == CLIP) {
+        clip_changed = false;
+        clip(c0, p);
+        clip(c1, p);
+        out.clipped += clip_changed;
+      }
+      /* Replace list[best] by c0, c1 in place. */
+      for (int i = n; i > best + 1; i--) {
+        list[i] = list[i - 1];
+      }
+      list[best] = c0;
+      list[best + 1] = c1;
+      n++;
+    }
+    out.filled += n;
+    int refs[4] = {0, 0, 0, 0};
+    int below = 0;
+    for (int i = 0; i < n; i++) {
+      refs[i] = list[i].inner ? build(list[i].ref) : list[i].ref;
+      below = std::max(below, need(refs[i]));
+    }
+    if (need4.size() <= size_t(idx)) {
+      need4.resize(size_t(idx) + 1, 0);
+    }
+    need4[idx] = (n - 1) + below;
+    float v[6][4];
+    uint32_t vis[4] = {0, 0, 0, 0};
+    for (int j = 0; j < 4; j++) {
+      for (int k = 0; k < 3; k++) {
+        v[2 * k][j] = INFINITY;
+        v[2 * k + 1][j] = -INFINITY;
+      }
+    }
+    for (int j = 0; j < n; j++) {
+      for (int k = 0; k < 3; k++) {
+        v[2 * k][j] = list[j].lo[k];
+        v[2 * k + 1][j] = list[j].hi[k];
+      }
+      vis[j] = list[j].vis;
+    }
+    Word4 *o = &out.nodes[size_t(idx) * 8];
+    for (int r = 0; r < 6; r++) {
+      for (int j = 0; j < 4; j++) {
+        o[r].w[j] = as_uint(v[r][j]);
+      }
+    }
+    for (int j = 0; j < 4; j++) {
+      o[6].w[j] = uint32_t(refs[j]);
+      o[7].w[j] = vis[j];
+    }
+    return idx;
+  }
+
+  /* Stack pushes below a ref (BVH4 node, handoff BVH2 node or leaf). */
+  int need(int ref)
+  {
+    if (ref < 0 || ref == ENTRYPOINT_SENTINEL_) {
+      return 0;
+    }
+    if (ref >= BVH4_BVH2_TAG) {
+      return need_bvh2(ref - BVH4_BVH2_TAG);
+    }
+    return size_t(ref) < need4.size() ? need4[ref] : 0;
+  }
+  int need_bvh2(int a)
+  {
+    if (a < 0 || !valid_inner(a)) {
+      return 0;
+    }
+    auto it = need2.find(a);
+    if (it != need2.end()) {
+      return it->second;
+    }
+    const int v = 1 + std::max(need_bvh2(int(n2[a].w[2])), need_bvh2(int(n2[a].w[3])));
+    need2[a] = v;
+    return v;
+  }
+
+  int root(int a)
+  {
+    if (a < 0 || a == ENTRYPOINT_SENTINEL_) {
+      return a;
+    }
+    if (!valid_inner(a)) {
+      fail("root out of range");
+      return a;
+    }
+    if (unaligned(a)) {
+      out.handoff_roots++;
+      return BVH4_BVH2_TAG + a;
+    }
+    return build(a);
+  }
+};
+
+}  // namespace detail
+
+/* bvh2: the packed bvh_nodes (n2_size float4); root: kernel_data.bvh.root; object_node: one BVH2
+ * root per object. Returns false (out.error set) if the BVH cannot be represented. */
+inline bool collapse(const Word4 *bvh2,
+                     size_t n2_size,
+                     int root,
+                     const int *object_node,
+                     size_t num_objects,
+                     Result &out,
+                     Mode mode = EXACT,
+                     uint32_t unaligned_flag = NODE_UNALIGNED /* 4.5.0 dumps: 1 << 11 */)
+{
+  out = Result();
+  if (n2_size + size_t(BVH4_BVH2_TAG) >= size_t(ENTRYPOINT_SENTINEL_)) {
+    out.error = "BVH2 too large for BVH4 handoff refs";
+    return false;
+  }
+  detail::Builder B(bvh2, n2_size, out, mode, unaligned_flag);
+  out.nodes.reserve(n2_size / 2 + 8); /* BVH4 float4 <= 2x BVH2 inner nodes x 8 / 4 */
+  out.root = B.root(root);
+  out.object_root.resize(num_objects);
+  int object_need = 0;
+  for (size_t o = 0; o < num_objects; o++) {
+    out.object_root[o] = B.root(object_node[o]);
+    object_need = std::max(object_need, B.need(out.object_root[o]));
+  }
+  out.max_stack = 1 + B.need(out.root) + (num_objects ? 1 + object_need : 0);
+  if (out.nodes.empty()) {
+    out.nodes.resize(8); /* never read; keeps the device pointer valid */
+    for (int r = 0; r < 8; r++) {
+      for (int j = 0; j < 4; j++) {
+        out.nodes[r].w[j] = 0;
+      }
+    }
+  }
+  return B.ok;
+}
+
+}  // namespace bvh4int
