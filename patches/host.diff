+/* Ours: CYCLES_BVH2_OPTIMIZE=<passes> restructures the inner nodes of every BVH2 (top level and each object) after
+ * the build, with the leaves fixed: treelet restructuring (7 leaves, dynamic programming) on the node cost
+ * half area + (2 / L) * volume, L = CYCLES_BVH2_OPTIMIZE_F (default 0.002) times the tree's root diagonal; F = 0 is plain
+ * SAH. Rebuilt boxes are float unions of their children, so every box still contains its contents and the leaves and
+ * their primitives do not change. Trees with unaligned or motion nodes, or a child box outside its parent's, are left
+ * as built. Unset or 0: stock. Analysis: analysis/v53_bvhopt.md. */
+static void bvh2_optimize_topology(BVHNode *root,
+                                   const int passes,
+                                   const double fraction,
+                                   const double overlap_weight = 0.0,
+                                   const int order = 1,
+                                   const int treelet_n = 7)
+{
+  if (root == nullptr || root->is_leaf()) {
+    return;
+  }
+  const double t_start = time_dt();
+  vector<InnerNode *> inner;
+  vector<BVHNode *> leaves;
+  bvhopt::Tree t;
+  t.overlap_weight = overlap_weight;
+  t.order = order;
+  auto to_box = [](const BoundBox &b) {
+    bvhopt::Box r;
+    r.lo[0] = b.min.x;
+    r.lo[1] = b.min.y;
+    r.lo[2] = b.min.z;
+    r.hi[0] = b.max.x;
+    r.hi[1] = b.max.y;
+    r.hi[2] = b.max.z;
+    return r;
+  };
+  auto plain = [](const BVHNode *n) {
+    return !n->is_unaligned && n->time_from == 0.0f && n->time_to == 1.0f;
+  };
+  auto add = [&](BVHNode *n) -> int {
+    if (n->is_leaf()) {
+      leaves.push_back(n);
+      t.lbox.push_back(to_box(n->bounds));
+      t.lvis.push_back(n->visibility);
+      return ~int(leaves.size() - 1);
+    }
+    inner.push_back(static_cast<InnerNode *>(n));
+    t.c0.push_back(0);
+    t.c1.push_back(0);
+    t.box.push_back(to_box(n->bounds));
+    t.vis.push_back(n->visibility);
+    t.fixed.push_back(0);
+    return int(inner.size() - 1);
+  };
+  add(root);
+  for (size_t i = 0; i < inner.size(); i++) {
+    InnerNode *n = inner[i];
+    if (n->num_children() != 2 || !plain(n)) {
+      return;
+    }
+    const bvhopt::Box pb = t.box[i]; /* a copy: add() below grows t.box */
+    int e[2];
+    for (int k = 0; k < 2; k++) {
+      BVHNode *c = n->get_child(k);
+      if (!plain(c)) {
+        return;
+      }
+      const BoundBox &cb = c->bounds;
+      if (i > 0 && (cb.min.x < pb.lo[0] || cb.min.y < pb.lo[1] || cb.min.z < pb.lo[2] ||
+                    cb.max.x > pb.hi[0] || cb.max.y > pb.hi[1] || cb.max.z > pb.hi[2]))
+      {
+        return;
+      }
+      e[k] = add(c);
+    }
+    t.c0[i] = e[0];
+    t.c1[i] = e[1];
+  }
+  bvhopt::refit(t);
+  if (fraction > 0.0) {
+    const bvhopt::Box &rb = t.box[0];
+    double d2 = 0.0;
+    for (int k = 0; k < 3; k++) {
+      d2 += (double(rb.hi[k]) - double(rb.lo[k])) * (double(rb.hi[k]) - double(rb.lo[k]));
+    }
+    if (d2 > 0.0) {
+      t.vol_weight = 2.0 / (fraction * std::sqrt(d2));
+    }
+  }
+  const double area_before = bvhopt::inner_area_sum(t);
+  auto pfor = [](const int n, auto &&fn) { parallel_for(0, n, fn); };
+  long long rebuilt = 0;
+  if (treelet_n <= 5) {
+    rebuilt = bvhopt::optimize<5>(t, passes, pfor);
+  }
+  else if (treelet_n == 6) {
+    rebuilt = bvhopt::optimize<6>(t, passes, pfor);
+  }
+  else if (treelet_n >= 8) {
+    rebuilt = bvhopt::optimize<8>(t, passes, pfor);
+  }
+  else {
+    rebuilt = bvhopt::optimize<7>(t, passes, pfor);
+  }
+  /* Rewire: every entity gets exactly one new parent, so release all child pointers first. */
+  for (InnerNode *n : inner) {
+    n->children[0].release();
+    n->children[1].release();
+  }
+  auto ptr = [&](const int e) -> BVHNode * { return e >= 0 ? inner[e] : leaves[~e]; };
+  for (size_t i = 0; i < inner.size(); i++) {
+    InnerNode *n = inner[i];
+    n->children[0].reset(ptr(t.c0[i]));
+    n->children[1].reset(ptr(t.c1[i]));
+    const bvhopt::Box &b = t.box[i];
+    n->bounds = BoundBox(make_float3(b.lo[0], b.lo[1], b.lo[2]), make_float3(b.hi[0], b.hi[1], b.hi[2]));
+    n->visibility = t.vis[i];
+  }
+  if (inner.size() >= 100000) {
+    fprintf(stderr,
+            "CYCLES_BVH2_OPTIMIZE: %zu inner nodes, %d passes, F %g: %lld treelets rebuilt, inner area %.4f of "
+            "built, %.2f s\n",
+            inner.size(),
+            passes,
+            fraction,
+            rebuilt,
+            bvhopt::inner_area_sum(t) / std::max(area_before, 1e-300),
+            time_dt() - t_start);
+  }
+}
