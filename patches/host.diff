+    defines += string("#define CYCLES_SVM_USED_" #type " ") + (used ? "1" : "0") + "\n"; \
+    num_used += used; \
+    num_types++; \
+  }
+#define SHADER_NODE_TYPE_DERIVATIVE(type) SHADER_NODE_TYPE(type) SHADER_NODE_TYPE(type##_DERIVATIVE)
+#include "kernel/svm/node_types_template.h"
