+/* SPDX-FileCopyrightText: 2011-2022 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* Ours: bookkeeping options (analysis/v53_book.md). Every option needs its env; unset = stock.
+ *
+ * - CYCLES_BOOK_SCAN=1: launch the active-index scans with ceil(n / (K * block)) blocks, where K is the
+ *   kernel_book_scan_k the cubin was built with (-DCYCLES_BOOK_SCAN=K); a cubin without it keeps the stock grid.
+ * - CYCLES_MAIN_COMPACT_FACTOR=F: new camera paths fill the free main states (cubin built with -DCYCLES_BOOK_FILL)
+ *   instead of compacting first, whenever the state range after the fill is at most F times the live paths;
+ *   otherwise compact as stock. No effect with a cubin without kernel_book_fill, a shadow catcher or baking.
+ * - CYCLES_SHADOW_COMPACT_FACTOR=F: compact shadow states when their range reaches F times the active shadow
+ *   paths (stock 2), or when the next kernel's shadow paths would not fit; F <= 0: only when they would not fit. */
+
+#pragma once
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+
+CCL_NAMESPACE_BEGIN
+
+struct BookCaps {
+  /* Read from the loaded CUDA module; 1 / false for a stock cubin. */
+  int scan_k = 1;
+  bool fill = false;
+  /* Ours (analysis/v53_hostfix.md): kernel_ao_reserve (-DCYCLES_AO_RESERVE: the kernel counts camera-visible
+   * paths queued for surface shading) and kernel_df_kernels (-DCYCLES_DF_TAG: bit 0 intersect_closest, bit 1
+   * intersect_shadow, bit 2 intersect_subsurface run the dynamic-fetch loop). */
+  bool ao_reserve = false;
+  int df_kernels = 0;
+};
+
+inline BookCaps &book_caps()
+{
+  static BookCaps caps;
+  return caps;
+}
+
+inline bool book_env_set(const char *name)
+{
+  const char *value = getenv(name);
+  return value != nullptr && value[0] != '\0';
+}
+
+inline float book_env_float(const char *name, const float fallback)
+{
+  const char *value = getenv(name);
+  return (value != nullptr && value[0] != '\0') ? float(atof(value)) : fallback;
+}
+
+/* Blocks-per-launch divisor for an active-index scan kernel (1 = stock grid). */
+inline int book_scan_k()
+{
+  static const int k = (book_env_set("CYCLES_BOOK_SCAN") && atoi(getenv("CYCLES_BOOK_SCAN")) != 0) ? 1 : 0;
+  return k ? book_caps().scan_k : 1;
+}
+
+/* Ours (analysis/v53_hostfix.md), all unset = stock:
+ * - CYCLES_SHADOW_POOL_FACTOR=F (F > 1): allocate F times the main states for shadow states.
+ * - CYCLES_AO_RESERVE=1: with a cubin built with -DCYCLES_AO_RESERVE, shade_surface reserves the second (AO)
+ *   shadow state only for the queued camera-visible paths. CYCLES_AO_RESERVE_CHECK=1 also checks every launch.
+ * - CYCLES_DF_GRID=resident|<blocks>: launch the dynamic-fetch kernels (cubin built with -DCYCLES_DF_TAG) with at
+ *   most the blocks that fit on the device at once (resident) or at most <blocks> blocks. */
+inline float hostfix_shadow_pool_factor()
+{
+  static const float factor = book_env_float("CYCLES_SHADOW_POOL_FACTOR", 1.0f);
+  return factor > 1.0f ? factor : 1.0f;
+}
+
+inline bool hostfix_ao_reserve()
+{
+  static const bool on = book_env_set("CYCLES_AO_RESERVE") && atoi(getenv("CYCLES_AO_RESERVE")) != 0;
+  return on && book_caps().ao_reserve;
+}
+
+inline bool hostfix_ao_reserve_check()
+{
+  static const bool on = book_env_set("CYCLES_AO_RESERVE_CHECK") &&
+                         atoi(getenv("CYCLES_AO_RESERVE_CHECK")) != 0;
+  return on;
+}
+
+/* 0: stock grid; -1: resident blocks; N > 0: at most N blocks. */
+inline int hostfix_df_grid()
+{
+  static const int grid = []() {
+    const char *value = getenv("CYCLES_DF_GRID");
+    if (value == nullptr || value[0] == '\0') {
+      return 0;
+    }
+    if (strcmp(value, "resident") == 0) {
+      return -1;
+    }
+    return std::max(atoi(value), 0);
+  }();
+  return grid;
+}
+
+CCL_NAMESPACE_END
