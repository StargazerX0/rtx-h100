+/* SPDX-License-Identifier: Apache-2.0 */
+
+/* Ours: the host side of the subsurface random walk's empty-space skip (env CYCLES_SSS_SKIP_GRID).
+ * See scene/sss_skip_grid.h for the grid and kernel/integrator/subsurface_skip_layout.h for the
+ * table layout. */
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <vector>
+
+#include "scene/sss_skip.h"
+
+#include "scene/devicescene.h"
+#include "scene/mesh.h"
+#include "scene/object.h"
+#include "scene/scene.h"
+#include "scene/tables.h"
+
+#include "kernel/integrator/subsurface_skip_layout.h"
+
+#define SSS_SKIP_USE_TBB
+#include "util/tbb.h"
+
+#include "scene/sss_skip_grid.h"
+
+CCL_NAMESPACE_BEGIN
+
+static std::mutex sss_skip_mutex;
+static std::map<const Scene *, size_t> sss_skip_offsets;
+
+static float sss_skip_bits(const uint value)
+{
+  float f;
+  memcpy(&f, &value, sizeof(f));
+  return f;
+}
+
+void sss_skip_grid_device_free(Scene *scene)
+{
+  const std::lock_guard<std::mutex> lock(sss_skip_mutex);
+  auto it = sss_skip_offsets.find(scene);
+  if (it == sss_skip_offsets.end()) {
+    return;
+  }
+  size_t offset = it->second;
+  scene->lookup_tables->remove_table(&offset);
+  sss_skip_offsets.erase(it);
+}
+
+void sss_skip_grid_device_update(Scene *scene, DeviceScene *dscene)
+{
+  const char *env = getenv("CYCLES_SSS_SKIP_GRID");
+  if (env == nullptr) {
+    return;
+  }
+  sss_skip_grid_device_free(scene);
+  dscene->data.tables.pad2 = 0;
+
+  const int n = atoi(env);
+  if (n < 2 || n > 1024) {
+    fprintf(stderr, "CYCLES_SSS_SKIP_GRID=%s: need 2..1024 cells per axis, skip disabled\n", env);
+    return;
+  }
+  const auto t0 = std::chrono::steady_clock::now();
+
+  /* One grid per geometry: a mesh with subsurface shaders and no deformation motion, used by at
+   * least one object without object motion. Grids are in the mesh's own coordinates, which are
+   * the traversal's object space (or world space when the transform is applied). */
+  const size_t num_objects = scene->objects.size();
+  std::vector<int> object_grid(num_objects, -1);
+  std::map<const Geometry *, int> geom_grid;
+  std::vector<const Mesh *> meshes;
+  for (const Object *ob : scene->objects) {
+    const Geometry *geom = ob->get_geometry();
+    if (geom == nullptr || !geom->is_mesh() || !geom->has_surface_bssrdf || geom->has_motion_blur() ||
+        ob->use_motion())
+    {
+      continue;
+    }
+    const Mesh *mesh = static_cast<const Mesh *>(geom);
+    if (mesh->num_triangles() == 0 || mesh->attributes.find(ATTR_STD_POSITION) == nullptr) {
+      continue;
+    }
+    auto it = geom_grid.find(geom);
+    if (it == geom_grid.end()) {
+      it = geom_grid.emplace(geom, int(meshes.size())).first;
+      meshes.push_back(mesh);
+    }
+    const int index = ob->get_device_index();
+    if (index >= 0 && size_t(index) < num_objects) {
+      object_grid[index] = it->second;
+    }
+  }
+
+  std::vector<sss_skip::Grid> grids(meshes.size());
+  for (size_t i = 0; i < meshes.size(); i++) {
+    const Mesh *mesh = meshes[i];
+    const Attribute *attr_P = mesh->attributes.find(ATTR_STD_POSITION);
+    const packed_float3 *P = attr_P->data<packed_float3>();
+    std::vector<sss_skip::D3> verts(attr_P->size);
+    for (size_t v = 0; v < verts.size(); v++) {
+      verts[v] = {double(P[v].x), double(P[v].y), double(P[v].z)};
+    }
+    const array<int> &tris = mesh->get_triangles();
+    std::vector<int> tri_index(tris.data(), tris.data() + tris.size());
+    sss_skip::build(verts, tri_index, n, grids[i]);
+    const sss_skip::Grid &g = grids[i];
+    fprintf(stderr,
+            "CYCLES_SSS_SKIP_GRID: mesh '%s' %zu triangles, %d^3 cells, half diagonal %.4g, unit "
+            "%.4g, margin %.3g, occupied %zu, build %.2f s (band %.2f s, %zu distance evaluations; "
+            "edt %.2f s)\n",
+            mesh->name.c_str(),
+            mesh->num_triangles(),
+            n,
+            g.half_diag,
+            double(g.unit),
+            g.margin_abs,
+            g.occupied,
+            g.t_total,
+            g.t_band,
+            g.band_evals,
+            g.t_edt);
+  }
+
+  /* Region: header, records, cells. */
+  const size_t header = SSS_SKIP_HDR_OBJECTS + num_objects;
+  const size_t cell_floats = (size_t(n) * n * n + 3) / 4;
+  const size_t size = header + grids.size() * SSS_SKIP_REC_SIZE + grids.size() * cell_floats;
+  if (size >= (size_t(1) << 31)) {
+    fprintf(stderr, "CYCLES_SSS_SKIP_GRID: region too large, skip disabled\n");
+    return;
+  }
+  vector<float> region(size, 0.0f);
+  uint flags = 0;
+  if (const char *verify = getenv("CYCLES_SSS_SKIP_VERIFY")) {
+    if (atoi(verify) != 0) {
+      flags |= SSS_SKIP_FLAG_VERIFY;
+    }
+  }
+  region[SSS_SKIP_HDR_MAGIC] = sss_skip_bits(SSS_SKIP_MAGIC);
+  region[SSS_SKIP_HDR_NUM_OBJECTS] = sss_skip_bits(uint(num_objects));
+  region[SSS_SKIP_HDR_FLAGS] = sss_skip_bits(flags);
+  for (size_t i = 0; i < grids.size(); i++) {
+    const sss_skip::Grid &g = grids[i];
+    const size_t rec = header + i * SSS_SKIP_REC_SIZE;
+    const size_t data = header + grids.size() * SSS_SKIP_REC_SIZE + i * cell_floats;
+    for (int k = 0; k < 3; k++) {
+      region[rec + SSS_SKIP_REC_LO + k] = g.lo[k];
+      region[rec + SSS_SKIP_REC_INV_H + k] = g.inv_h[k];
+    }
+    region[rec + SSS_SKIP_REC_N] = sss_skip_bits(uint(n));
+    region[rec + SSS_SKIP_REC_UNIT] = g.unit;
+    region[rec + SSS_SKIP_REC_DATA] = sss_skip_bits(uint(data));
+    /* Little end first: byte (cell & 3) of float (cell >> 2), as the kernel reads it. */
+    uint8_t *bytes = reinterpret_cast<uint8_t *>(region.data() + data);
+    static_assert(sizeof(float) == 4, "float size");
+    const uint32_t probe = 1;
+    if (*reinterpret_cast<const uint8_t *>(&probe) == 1) {
+      memcpy(bytes, g.q.data(), g.q.size());
+    }
+    else {
+      for (size_t c = 0; c < g.q.size(); c++) {
+        uint32_t word;
+        memcpy(&word, bytes + 4 * (c >> 2), 4);
+        word |= uint32_t(g.q[c]) << (8 * (c & 3));
+        memcpy(bytes + 4 * (c >> 2), &word, 4);
+      }
+    }
+  }
+  for (size_t ob = 0; ob < num_objects; ob++) {
+    if (object_grid[ob] >= 0) {
+      region[SSS_SKIP_HDR_OBJECTS + ob] = sss_skip_bits(
+          uint(header + size_t(object_grid[ob]) * SSS_SKIP_REC_SIZE));
+    }
+  }
+
+  int objects_with_grid = 0;
+  for (const int g : object_grid) {
+    objects_with_grid += g >= 0;
+  }
+  if (objects_with_grid == 0) {
+    fprintf(stderr, "CYCLES_SSS_SKIP_GRID: no subsurface mesh, nothing uploaded\n");
+    return;
+  }
+  const size_t offset = scene->lookup_tables->add_table(dscene, region);
+  if (offset == 0 || offset >= (size_t(1) << 31)) {
+    /* 0 means "no region" to the kernel; never the case after the film's filter table. */
+    size_t remove = offset;
+    scene->lookup_tables->remove_table(&remove);
+    fprintf(stderr, "CYCLES_SSS_SKIP_GRID: table offset %zu unusable, skip disabled\n", offset);
+    return;
+  }
+  {
+    const std::lock_guard<std::mutex> lock(sss_skip_mutex);
+    sss_skip_offsets[scene] = offset;
+  }
+  dscene->data.tables.pad2 = int(offset);
+  const double seconds =
+      std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+  fprintf(stderr,
+          "CYCLES_SSS_SKIP_GRID: %d objects of %zu use %zu grids; region %.1f MB at lookup table "
+          "offset %zu (kernel_data.tables.pad2), verify %d, total %.2f s\n",
+          objects_with_grid,
+          num_objects,
+          grids.size(),
+          double(size) * 4.0 / (1024.0 * 1024.0),
+          offset,
+          int(flags & SSS_SKIP_FLAG_VERIFY),
+          seconds);
+}
+
+CCL_NAMESPACE_END
