+  config.svm_nodes_header += defines;
+  config.svm_nodes_header += string_printf(
+      "/* the scene's closure count (-D__MAX_CLOSURE__); the host check (CYCLES_SVM_NODES_CHECK) reads it */\n"
+      "#define CYCLES_SVM_PROBE_MAX_CLOSURES %d\n",
+      max_closures);
+
+  string f = "-DCYCLES_ISECT_BLOCK=64 -DCYCLES_ISECT_MINBLOCKS=16";
+  f += sss ? " -DCYCLES_SHADE_MINBLOCKS=2 -DCYCLES_SHADE_BLOCK=512" :
+             " -DCYCLES_SHADE_MINBLOCKS=1 -DCYCLES_SHADE_BLOCK=1024";
+  f += " -DCYCLES_BVH_FMA -D__KERNEL_FEATURES__=" + to_string(features);
+  f += " -DCYCLES_BVH2DF_CLOSEST";
+  if (hair) {
+    f += " -DCYCLES_CLOSEST_MINBLOCKS=10";
+  }
+  f += " -DCYCLES_BVH2DF_SHADOW";
+  if (hair) {
+    f += " -DCYCLES_SHADOW_MINBLOCKS=10";
+  }
+  else if (sss) {
+    f += " -DCYCLES_SHADOW_MINBLOCKS=12";
+  }
+  f += " -DCYCLES_BVH2DF_STACK=1 -DCYCLES_BVH2DF_STEP=1 -DCYCLES_BVH2DF_POLICY=1 -DCYCLES_BVH2DF_MINLIVE=16"
+       " -DCYCLES_BVH2DF_SPLITSTACK=1 -DCYCLES_BVH2DF_DEFER=1";
+  f += " -DCYCLES_SVM_NODES_USED -I@SVM_NODES_DIR@ -D__MAX_CLOSURE__=" + to_string(max_closures);
+  if (sss) {
+    f += " -DCYCLES_SSSDF -DCYCLES_SSS_BLOCK=64 -DCYCLES_SSS_MINBLOCKS=12";
+  }
+  f += " -DCYCLES_INLINE_HOT=2";
+  config.summary = string_printf("mask %llu subsurface %d hair %d svm nodes %d/%d closures %d",
+                                 (unsigned long long)features,
+                                 int(sss),
+                                 int(hair),
+                                 num_used,
+                                 num_types,
+                                 max_closures);
+  if (kernel_autoconfig_approx_enabled()) {
+    bool random_walk;
+    float clamp_indirect;
+    kernel_autoconfig_approx_scan(scene, random_walk, clamp_indirect);
+    const int rr_exp100 = (clamp_indirect > 0.0f && clamp_indirect < 5.0f) ? 75 : 100;
+    f += " -DCYCLES_BOOK_FILL -DCYCLES_BOOK_SCAN=8 -DCYCLES_BOOK_SHADOW_MOVE -DCYCLES_SH2_BOUNCEPREF"
+         " -DCYCLES_SH2_FRESNEL -DCYCLES_SH2_LIGHTDIST -DCYCLES_SH2_SHADOWCOPY -DCYCLES_DF_TAG";
+    f += " -DCYCLES_RR_EXP100=" + to_string(rr_exp100);
+    if (random_walk) {
+      f += " -DCYCLES_SSS_WALK_RR_Q=970 -DCYCLES_SSS_WALK_RR_K0=32";
+    }
+    config.summary += string_printf(" | approx: clamp indirect %g random-walk sss %d",
+                                    double(clamp_indirect),
+                                    int(random_walk));
+  }
+  config.cflags = f;
+  return config;
+}
+
+/* Ours: hand the derived flags to the device. CYCLES_AUTOCONFIG_PRECOMPILE=sm_<XY> also compiles that kernel into
+ * the cache now, whatever the render device (to fill the cache from a CPU render). */
+static void kernel_autoconfig_apply(Device *device,
+                                    Scene *scene,
+                                    const DeviceScene &dscene,
+                                    const bool kernels_loaded)
+{
+  kernel_autoconfig_host_defaults();
+  const KernelAutoconfig config = kernel_autoconfig_derive(scene, dscene);
+  /* The CUDA device never reloads a loaded module, and a pruned kernel cannot run node types it was not built
+   * with, so stop (as CYCLES_SVM_NODES_CHECK does) rather than render with a kernel that no longer fits. */
+  if (kernels_loaded && config.cflags != kernel_autoconfig_get().cflags) {
+    fprintf(stderr,
+            "CYCLES_AUTOCONFIG FAILED: scene content changed after the kernel load (%s | flags: %s)\n",
+            config.summary.c_str(),
+            config.cflags.c_str());
+    fflush(stderr);
+    abort();
+  }
+  kernel_autoconfig_set(config);
+
+  const char *precompile = getenv("CYCLES_AUTOCONFIG_PRECOMPILE");
+  int major = 0, minor = 0;
+  if (precompile && sscanf(precompile, "sm_%1d%1d", &major, &minor) == 2) {
+    string error;
+    if (kernel_autoconfig_cubin(major, minor, error).empty()) {
+      fprintf(stderr, "%s\n", error.c_str());
+    }
+  }
+  else if (device->info.type == DEVICE_CPU) {
+    printf("CYCLES_AUTOCONFIG %s | flags: %s | CPU device, no CUDA kernel compiled\n",
+           config.summary.c_str(),
+           config.cflags.c_str());
+  }
+  fflush(stdout);
+  fflush(stderr);
+}
