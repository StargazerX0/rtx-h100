+  const char *defaults[][2] = {{"CYCLES_BOOK_SCAN", "1"}, {"CYCLES_SHADOW_COMPACT_FACTOR", "4"}};
+  const char *hostfix[][2] = {{"CYCLES_DF_GRID", "resident"}, {"CYCLES_SHADOW_POOL_FACTOR", "2"}};
+  const char *hostfix_env = getenv("CYCLES_AUTOCONFIG_APPROX_HOSTFIX");
+  const bool use_hostfix = hostfix_env != nullptr && atoi(hostfix_env) != 0;
+  string line;
+  auto apply = [&line](const char *name, const char *value) {
+    const char *user = getenv(name);
+    if (user == nullptr || user[0] == '\0') {
+      setenv(name, value, 1);
+      line += string(" ") + name + "=" + value;
+    }
+    else {
+      line += string(" ") + name + "=" + user + " (user)";
+    }
+  };
+  for (const auto &d : defaults) {
+    apply(d[0], d[1]);
+  }
+  if (use_hostfix) {
+    for (const auto &d : hostfix) {
+      apply(d[0], d[1]);
+    }
+  }
+  printf("CYCLES_AUTOCONFIG_APPROX host:%s\n", line.c_str());
+  fflush(stdout);
