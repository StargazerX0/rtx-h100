+/* Ours: env CYCLES_SSS_SKIP_GRID=<cells per axis> builds a distance grid per subsurface mesh and
+ * appends it to the lookup table, its offset in kernel_data.tables.pad2 (see
+ * kernel/integrator/subsurface_skip_layout.h). Unset: nothing is built or uploaded. */
+
