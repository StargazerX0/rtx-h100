diff --git a/intern/cycles/scene/sss_skip_grid.h b/intern/cycles/scene/sss_skip_grid.h
new file mode 100644
index 0000000..3f7b5ce
--- /dev/null
+++ b/intern/cycles/scene/sss_skip_grid.h
@@ -0,0 +1,405 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Ours (CYCLES_SSS_SKIP_GRID): a conservative distance grid for one mesh, used by the subsurface
+ * random walk to skip the local BVH traversal of steps that cannot reach a triangle
+ * (kernel/integrator/subsurface_skip.h). Plain C++ (std only), so that an offline test can build
+ * the same grid (jobs/sss_grid_test.cpp).
+ *
+ * Grid: N cells per axis over the mesh bounds (object space). Cell value q (u8): for every point
+ * p in the cell, the distance from p to the nearest triangle is at least q * unit. Built as
+ *   1. band: for each triangle, the exact distance (double) from every cell centre within
+ *      B = band_cells * max cell size of its bounding box; min over triangles. A centre whose
+ *      value v <= B has its exact distance; v > B (or none) means the distance is > B.
+ *   2. far field: the Euclidean distance transform E from the centres of the cells whose centre
+ *      lies within half a cell diagonal of a triangle (every cell a triangle touches is one);
+ *      E - half diagonal is a lower bound of the centre distance.
+ *   3. centre bound L = max(min(v, B), E - h), cell bound L - h (h = half cell diagonal), minus
+ *      the rounding margin, rounded down to a multiple of unit. */
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+#ifdef SSS_SKIP_USE_TBB
+#  include <tbb/blocked_range.h>
+#  include <tbb/parallel_for.h>
+#endif
+
+namespace sss_skip {
+
+struct Grid {
+  float lo[3] = {0, 0, 0};     /* grid origin (object space) */
+  float inv_h[3] = {0, 0, 0};  /* cells per unit length, per axis */
+  int n = 0;                   /* cells per axis */
+  float unit = 0.0f;           /* distance of one quantization step */
+  std::vector<uint8_t> q;      /* n^3 values, x fastest */
+  /* Statistics. */
+  double half_diag = 0.0, scale = 0.0, margin_abs = 0.0;
+  double t_band = 0.0, t_edt = 0.0, t_total = 0.0;
+  size_t occupied = 0, band_evals = 0;
+};
+
+/* Rounding margin: the stored bound is (bound * (1 - margin_rel) - margin_abs * scale), scale =
+ * max(bounds diagonal, largest bounds coordinate). Covers the float error of the kernel's object
+ * space transform, its cell lookup, the triangle test's edge tolerance and t * |D|. */
+constexpr double margin_rel = 1e-4;
+constexpr double margin_abs = 1e-5;
+constexpr int band_cells = 4;
+
+struct D3 {
+  double x, y, z;
+};
+inline D3 operator-(D3 a, D3 b)
+{
+  return {a.x - b.x, a.y - b.y, a.z - b.z};
+}
+inline D3 operator+(D3 a, D3 b)
+{
+  return {a.x + b.x, a.y + b.y, a.z + b.z};
+}
+inline D3 operator*(double s, D3 a)
+{
+  return {s * a.x, s * a.y, s * a.z};
+}
+inline double dot(D3 a, D3 b)
+{
+  return a.x * b.x + a.y * b.y + a.z * b.z;
+}
+
+inline double d2_point_segment(D3 p, D3 a, D3 b)
+{
+  const D3 ab = b - a, ap = p - a;
+  const double l2 = dot(ab, ab);
+  double s = l2 > 0.0 ? dot(ap, ab) / l2 : 0.0;
+  s = std::min(1.0, std::max(0.0, s));
+  const D3 e = p - (a + s * ab);
+  return dot(e, e);
+}
+
+/* Squared distance point - triangle (Ericson, Real-Time Collision Detection 5.1.5). Degenerate
+ * triangles fall back to the three edges. */
+inline double d2_point_triangle(D3 p, D3 a, D3 b, D3 c)
+{
+  const D3 ab = b - a, ac = c - a, ap = p - a;
+  const double d1 = dot(ab, ap), d2 = dot(ac, ap);
+  if (d1 <= 0 && d2 <= 0) {
+    return dot(ap, ap);
+  }
+  const D3 bp = p - b;
+  const double d3 = dot(ab, bp), d4 = dot(ac, bp);
+  if (d3 >= 0 && d4 <= d3) {
+    return dot(bp, bp);
+  }
+  const double vc = d1 * d4 - d3 * d2;
+  if (vc <= 0 && d1 >= 0 && d3 <= 0) {
+    return d2_point_segment(p, a, b);
+  }
+  const D3 cp = p - c;
+  const double d5 = dot(ab, cp), d6 = dot(ac, cp);
+  if (d6 >= 0 && d5 <= d6) {
+    return dot(cp, cp);
+  }
+  const double vb = d5 * d2 - d1 * d6;
+  if (vb <= 0 && d2 >= 0 && d6 <= 0) {
+    return d2_point_segment(p, a, c);
+  }
+  const double va = d3 * d6 - d5 * d4;
+  if (va <= 0 && (d4 - d3) >= 0 && (d5 - d6) >= 0) {
+    return d2_point_segment(p, b, c);
+  }
+  const double sum = va + vb + vc;
+  double r = NAN;
+  if (sum != 0.0) {
+    const double v = vb / sum, w = vc / sum;
+    const D3 e = p - (a + v * ab + w * ac);
+    r = dot(e, e);
+  }
+  if (!std::isfinite(r)) {
+    r = std::min(d2_point_segment(p, a, b),
+                 std::min(d2_point_segment(p, b, c), d2_point_segment(p, a, c)));
+  }
+  return r;
+}
+
+/* Run body(i) for i in [0, count) in chunks: TBB inside Blender (honours its thread count), else
+ * std::thread on all hardware threads. */
+template<typename F> void parallel_range(const size_t count, const size_t chunk, const F &body)
+{
+#ifdef SSS_SKIP_USE_TBB
+  tbb::parallel_for(tbb::blocked_range<size_t>(0, count, chunk),
+                    [&](const tbb::blocked_range<size_t> &r) {
+                      for (size_t i = r.begin(); i != r.end(); i++) {
+                        body(i);
+                      }
+                    });
+  return;
+#endif
+  const unsigned nthreads = std::max(1u, std::thread::hardware_concurrency());
+  std::atomic<size_t> next(0);
+  auto worker = [&]() {
+    for (;;) {
+      const size_t begin = next.fetch_add(chunk);
+      if (begin >= count) {
+        return;
+      }
+      const size_t end = std::min(count, begin + chunk);
+      for (size_t i = begin; i < end; i++) {
+        body(i);
+      }
+    }
+  };
+  std::vector<std::thread> threads;
+  for (unsigned t = 1; t < nthreads; t++) {
+    threads.emplace_back(worker);
+  }
+  worker();
+  for (std::thread &t : threads) {
+    t.join();
+  }
+}
+
+/* Largest float <= d (d >= 0). */
+inline float float_down(const double d)
+{
+  float f = float(d);
+  if (double(f) > d) {
+    f = std::nextafter(f, 0.0f);
+  }
+  return f;
+}
+
+/* 1D squared distance transform (Felzenszwalb & Huttenlocher) of f at positions i * h, in place. */
+inline void edt_1d(double *f, const int n, const double h, int *v, double *z, double *out)
+{
+  const double inf = 1e300;
+  int k = 0;
+  int first = -1;
+  for (int i = 0; i < n; i++) {
+    if (f[i] < inf) {
+      first = i;
+      break;
+    }
+  }
+  if (first < 0) {
+    return; /* all infinite */
+  }
+  v[0] = first;
+  z[0] = -inf;
+  z[1] = inf;
+  for (int q = first + 1; q < n; q++) {
+    if (!(f[q] < inf)) {
+      continue;
+    }
+    const double xq = q * h;
+    for (;;) {
+      const double xv = v[k] * h;
+      const double s = ((f[q] + xq * xq) - (f[v[k]] + xv * xv)) / (2.0 * (xq - xv));
+      if (s <= z[k]) {
+        k--;
+        if (k < 0) {
+          k = 0;
+          v[0] = q;
+          z[0] = -inf;
+          z[1] = inf;
+          break;
+        }
+        continue;
+      }
+      k++;
+      v[k] = q;
+      z[k] = s;
+      z[k + 1] = inf;
+      break;
+    }
+  }
+  k = 0;
+  for (int q = 0; q < n; q++) {
+    const double xq = q * h;
+    while (z[k + 1] < xq) {
+      k++;
+    }
+    const double dx = xq - v[k] * h;
+    out[q] = dx * dx + f[v[k]];
+  }
+  memcpy(f, out, sizeof(double) * n);
+}
+
+/* verts: xyz of each vertex (double); tris: 3 vertex indices per triangle. */
+inline void build(const std::vector<D3> &verts, const std::vector<int> &tris, const int n, Grid &g)
+{
+  using clock = std::chrono::steady_clock;
+  const auto t0 = clock::now();
+  const size_t num_tris = tris.size() / 3;
+  g.n = n;
+
+  double lo[3] = {1e300, 1e300, 1e300}, hi[3] = {-1e300, -1e300, -1e300};
+  for (size_t i = 0; i < tris.size(); i++) {
+    const D3 &p = verts[tris[i]];
+    const double c[3] = {p.x, p.y, p.z};
+    for (int k = 0; k < 3; k++) {
+      lo[k] = std::min(lo[k], c[k]);
+      hi[k] = std::max(hi[k], c[k]);
+    }
+  }
+  double diag2 = 0.0, maxc = 0.0;
+  for (int k = 0; k < 3; k++) {
+    diag2 += (hi[k] - lo[k]) * (hi[k] - lo[k]);
+    maxc = std::max(maxc, std::max(std::fabs(lo[k]), std::fabs(hi[k])));
+  }
+  g.scale = std::max(std::sqrt(diag2), maxc);
+  g.margin_abs = margin_abs * g.scale;
+
+  /* Pad by 1e-6 scale so that every triangle lies inside the float grid; the cell boundaries
+   * used here are the ones the kernel computes from the float lo and inv_h. */
+  double h[3];
+  for (int k = 0; k < 3; k++) {
+    const double pad = 1e-6 * g.scale;
+    g.lo[k] = float(lo[k] - 2.0 * pad);
+    const double extent = (hi[k] + 2.0 * pad) - double(g.lo[k]);
+    g.inv_h[k] = float(double(n) / extent);
+    /* The kernel's cell is floor((P - lo) * inv_h); the float inv_h may be a little larger than
+     * n / extent, which only shrinks the covered region. */
+    h[k] = 1.0 / double(g.inv_h[k]);
+  }
+  g.half_diag = 0.5 * std::sqrt(h[0] * h[0] + h[1] * h[1] + h[2] * h[2]);
+  const double hmax = std::max(h[0], std::max(h[1], h[2]));
+  const double band = band_cells * hmax;
+  const size_t nn = size_t(n) * n * n;
+  const double glo[3] = {g.lo[0], g.lo[1], g.lo[2]};
+
+  /* 1. Band: exact centre distances, as float rounded down, atomic min on the bit pattern. */
+  std::vector<std::atomic<uint32_t>> vbits(nn);
+  const float inf_f = INFINITY;
+  uint32_t inf_bits;
+  memcpy(&inf_bits, &inf_f, 4);
+  parallel_range(nn, 1 << 16, [&](size_t i) { vbits[i].store(inf_bits, std::memory_order_relaxed); });
+  std::atomic<size_t> evals(0);
+  parallel_range(num_tris, 256, [&](size_t t) {
+    const D3 a = verts[tris[3 * t]], b = verts[tris[3 * t + 1]], c = verts[tris[3 * t + 2]];
+    const double tlo[3] = {std::min(a.x, std::min(b.x, c.x)),
+                           std::min(a.y, std::min(b.y, c.y)),
+                           std::min(a.z, std::min(b.z, c.z))};
+    const double thi[3] = {std::max(a.x, std::max(b.x, c.x)),
+                           std::max(a.y, std::max(b.y, c.y)),
+                           std::max(a.z, std::max(b.z, c.z))};
+    int i0[3], i1[3];
+    for (int k = 0; k < 3; k++) {
+      /* Centres (i + 0.5) h within [tlo - band, thi + band]. */
+      i0[k] = std::max(0, int(std::ceil((tlo[k] - band - glo[k]) / h[k] - 0.5)) - 1);
+      i1[k] = std::min(n - 1, int(std::floor((thi[k] + band - glo[k]) / h[k] - 0.5)) + 1);
+    }
+    size_t local = 0;
+    for (int z = i0[2]; z <= i1[2]; z++) {
+      for (int y = i0[1]; y <= i1[1]; y++) {
+        for (int x = i0[0]; x <= i1[0]; x++) {
+          const D3 p = {glo[0] + (x + 0.5) * h[0], glo[1] + (y + 0.5) * h[1], glo[2] + (z + 0.5) * h[2]};
+          const float d = float_down(std::sqrt(d2_point_triangle(p, a, b, c)));
+          uint32_t bits;
+          memcpy(&bits, &d, 4);
+          std::atomic<uint32_t> &cell = vbits[(size_t(z) * n + y) * n + x];
+          uint32_t old = cell.load(std::memory_order_relaxed);
+          while (bits < old && !cell.compare_exchange_weak(old, bits, std::memory_order_relaxed)) {
+          }
+          local++;
+        }
+      }
+    }
+    evals.fetch_add(local, std::memory_order_relaxed);
+  });
+  g.band_evals = evals.load();
+  const auto t1 = clock::now();
+
+  /* 2. EDT from the centres within half a diagonal of a triangle. */
+  std::vector<double> e(nn);
+  std::atomic<size_t> occupied(0);
+  parallel_range(nn, 1 << 16, [&](size_t i) {
+    uint32_t bits = vbits[i].load(std::memory_order_relaxed);
+    float v;
+    memcpy(&v, &bits, 4);
+    const bool occ = double(v) <= g.half_diag;
+    e[i] = occ ? 0.0 : 1e300;
+    if (occ) {
+      occupied.fetch_add(1, std::memory_order_relaxed);
+    }
+  });
+  g.occupied = occupied.load();
+  for (int axis = 0; axis < 3; axis++) {
+    const size_t stride = axis == 0 ? 1 : (axis == 1 ? size_t(n) : size_t(n) * n);
+    parallel_range(size_t(n) * n, 16, [&](size_t line) {
+      thread_local std::vector<double> f, z, out;
+      thread_local std::vector<int> v;
+      f.resize(n);
+      out.resize(n);
+      z.resize(n + 1);
+      v.resize(n);
+      const size_t a = line % n, b = line / n;
+      size_t base;
+      if (axis == 0) {
+        base = (b * n + a) * n;
+      }
+      else if (axis == 1) {
+        base = b * n * n + a;
+      }
+      else {
+        base = b * n + a;
+      }
+      for (int i = 0; i < n; i++) {
+        f[i] = e[base + i * stride];
+      }
+      edt_1d(f.data(), n, h[axis], v.data(), z.data(), out.data());
+      for (int i = 0; i < n; i++) {
+        e[base + i * stride] = f[i];
+      }
+    });
+  }
+  const auto t2 = clock::now();
+
+  /* 3. Cell bounds, margin, quantization. */
+  std::vector<float> lb(nn);
+  std::vector<float> chunk_max((nn + (1 << 16) - 1) >> 16, 0.0f);
+  parallel_range(chunk_max.size(), 1, [&](size_t c) {
+    float m = 0.0f;
+    const size_t end = std::min(nn, (c + 1) << 16);
+    for (size_t i = c << 16; i < end; i++) {
+      uint32_t bits = vbits[i].load(std::memory_order_relaxed);
+      float v;
+      memcpy(&v, &bits, 4);
+      const double centre = std::max(std::min(double(v), band),
+                                     e[i] < 1e299 ? std::sqrt(e[i]) - g.half_diag : 0.0);
+      const double cell = (centre - g.half_diag) * (1.0 - margin_rel) - g.margin_abs;
+      lb[i] = cell > 0.0 ? float_down(cell) : 0.0f;
+      m = std::max(m, lb[i]);
+    }
+    chunk_max[c] = m;
+  });
+  const double maxlb = *std::max_element(chunk_max.begin(), chunk_max.end());
+  /* unit: fine enough that rounding loses at most half_diag / 8, coarse enough to cover the
+   * largest value when that is under 32 half diagonals (larger values saturate at 255). */
+  double unit = std::min(g.half_diag / 8.0, maxlb / 255.0);
+  if (!(unit > 0.0)) {
+    unit = g.half_diag / 8.0;
+  }
+  g.unit = float(unit);
+  /* q * unit (in float, as the kernel computes it) must not exceed lb. */
+  g.q.assign(nn, 0);
+  parallel_range(nn, 1 << 16, [&](size_t i) {
+    int qi = std::min(255, int(std::floor(double(lb[i]) / double(g.unit))));
+    while (qi > 0 && double(float(qi) * g.unit) > double(lb[i])) {
+      qi--;
+    }
+    g.q[i] = uint8_t(std::max(0, qi));
+  });
+  const auto t3 = clock::now();
+  g.t_band = std::chrono::duration<double>(t1 - t0).count();
+  g.t_edt = std::chrono::duration<double>(t2 - t1).count();
+  g.t_total = std::chrono::duration<double>(t3 - t0).count();
+}
