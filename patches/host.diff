diff --git a/intern/cycles/kernel/integrator/subsurface_skip.h b/intern/cycles/kernel/integrator/subsurface_skip.h
new file mode 100644
index 0000000..016f670
--- /dev/null
+++ b/intern/cycles/kernel/integrator/subsurface_skip.h
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Ours: exact empty-space skip for the subsurface random walk. A walk step after bounce 0 traces
+ * the segment P + s D, s in [0, t], against its own object only (scene_intersect_local, object
+ * space). If t |D_object| is below the distance grid's lower bound for the cell of P_object, no
+ * triangle can be hit, and the step continues as a traced step with no hit (num_hits = 0).
+ *
+ * Enabled for the GPU with -DCYCLES_SSS_SKIP (DF walk: -DCYCLES_SSS_SKIP_K, default 8, skipped
+ * steps a lane may take per traversal round; -DCYCLES_SSS_SKIP_VERIFY: skipped steps also trace
+ * and __trap() on a hit). Always compiled into the CPU kernel's stock walk. The test is false
+ * unless the host uploaded a grid (env CYCLES_SSS_SKIP_GRID), so without the env the walk is
+ * stock. Layout: subsurface_skip_layout.h. */
+
+#include "kernel/integrator/subsurface_skip_layout.h"
+
+#ifndef __KERNEL_GPU__
+#  include <atomic>
+#  include <cstdio>
+#  include <cstdlib>
+#endif
+
+#ifndef CYCLES_SSS_SKIP_K
+#  define CYCLES_SSS_SKIP_K 8
+#endif
+
+CCL_NAMESPACE_BEGIN
+
+/* true: the segment from P along D of parameter length t cannot hit a triangle of object. */
+ccl_device_inline bool subsurface_skip_test(KernelGlobals kg,
+                                            const int object,
+                                            const float3 P,
+                                            const float3 D,
+                                            const float t)
+{
+  const int base = kernel_data.tables.pad2;
+  if (base == 0) {
+    return false;
+  }
+  const uint rec_offset = __float_as_uint(
+      kernel_data_fetch(lookup_table, base + SSS_SKIP_HDR_OBJECTS + object));
+  if (rec_offset == 0) {
+    return false;
+  }
+  const int rec = base + int(rec_offset);
+
+  /* The traversal's object space (bvh/local.h). The host gives no grid to moving objects. */
+  float3 Po = P;
+  float3 Do = D;
+  if (!(kernel_data_fetch(object_flag, object) & SD_OBJECT_TRANSFORM_APPLIED)) {
+    const Transform itfm = object_fetch_transform(kg, object, OBJECT_INVERSE_TRANSFORM);
+    Po = transform_point(&itfm, P);
+    Do = transform_direction(&itfm, D);
+  }
+
+  const int n = __float_as_int(kernel_data_fetch(lookup_table, rec + SSS_SKIP_REC_N));
+  const float fn = float(n);
+  const float x = (Po.x - kernel_data_fetch(lookup_table, rec + SSS_SKIP_REC_LO + 0)) *
+                  kernel_data_fetch(lookup_table, rec + SSS_SKIP_REC_INV_H + 0);
+  const float y = (Po.y - kernel_data_fetch(lookup_table, rec + SSS_SKIP_REC_LO + 1)) *
+                  kernel_data_fetch(lookup_table, rec + SSS_SKIP_REC_INV_H + 1);
+  const float z = (Po.z - kernel_data_fetch(lookup_table, rec + SSS_SKIP_REC_LO + 2)) *
+                  kernel_data_fetch(lookup_table, rec + SSS_SKIP_REC_INV_H + 2);
+  /* Outside the grid (open meshes, points on the bounds): trace. */
+  if (!(x >= 0.0f && x < fn && y >= 0.0f && y < fn && z >= 0.0f && z < fn)) {
+    return false;
+  }
+  const uint ix = uint(min(int(x), n - 1));
+  const uint iy = uint(min(int(y), n - 1));
+  const uint iz = uint(min(int(z), n - 1));
+  const uint cell = (iz * uint(n) + iy) * uint(n) + ix;
+  const uint data = __float_as_uint(kernel_data_fetch(lookup_table, rec + SSS_SKIP_REC_DATA));
+  const uint word = __float_as_uint(kernel_data_fetch(lookup_table, base + int(data + (cell >> 2))));
+  const uint q = (word >> ((cell & 3u) * 8u)) & 0xffu;
+  return t * len(Do) < float(q) * kernel_data_fetch(lookup_table, rec + SSS_SKIP_REC_UNIT);
+}
+
+#ifdef __KERNEL_GPU__
+/* GPU: the test, then num_hits = 0; true when the traversal is skipped. With
+ * CYCLES_SSS_SKIP_VERIFY the skipped step also traces and traps on a hit. */
+ccl_device_inline bool subsurface_skip_gpu(KernelGlobals kg,
+                                           const int object,
+                                           const ccl_private Ray &ray,
+                                           ccl_private LocalIntersection &ss_isect)
+{
+  if (!subsurface_skip_test(kg, object, ray.P, ray.D, ray.tmax)) {
+    return false;
+  }
+#  ifdef CYCLES_SSS_SKIP_VERIFY
+  scene_intersect_local<true>(kg, &ray, &ss_isect, object, nullptr, 1);
+  if (ss_isect.num_hits > 0) {
+    printf("CYCLES_SSS_SKIP_VERIFY FAILED: object %d t %.9g hit t %.9g\n",
+           object,
+           double(ray.tmax),
+           double(ss_isect.hits[0].t));
+    __trap();
+  }
+#  endif
+  ss_isect.num_hits = 0;
+  return true;
+}
+#else
+/* CPU kernel: step counts, printed at exit when a grid was used. */
+struct SubsurfaceSkipStats {
+  std::atomic<unsigned long long> steps{0}, skipped{0}, verified{0};
+  ~SubsurfaceSkipStats()
+  {
+    if (steps.load() != 0) {
+      fprintf(stderr,
+              "CYCLES_SSS_SKIP cpu: bounce>0 steps with a grid %llu, skipped %llu (%.4f), verified "
+              "%llu\n",
+              steps.load(),
+              skipped.load(),
+              double(skipped.load()) / double(steps.load()),
+              verified.load());
+    }
+  }
+};
+static SubsurfaceSkipStats subsurface_skip_stats;
+
+ccl_device_inline bool subsurface_skip_cpu(KernelGlobals kg,
+                                           const int object,
+                                           const ccl_private Ray &ray,
+                                           ccl_private LocalIntersection &ss_isect)
+{
+  const int base = kernel_data.tables.pad2;
+  if (base == 0) {
+    return false;
+  }
+  if (!subsurface_skip_test(kg, object, ray.P, ray.D, ray.tmax)) {
+    subsurface_skip_stats.steps.fetch_add(1, std::memory_order_relaxed);
+    return false;
+  }
+  subsurface_skip_stats.steps.fetch_add(1, std::memory_order_relaxed);
+  subsurface_skip_stats.skipped.fetch_add(1, std::memory_order_relaxed);
+  if (__float_as_uint(kernel_data_fetch(lookup_table, base + SSS_SKIP_HDR_FLAGS)) &
+      SSS_SKIP_FLAG_VERIFY)
+  {
+    scene_intersect_local<true>(kg, &ray, &ss_isect, object, nullptr, 1);
+    if (ss_isect.num_hits > 0) {
+      fprintf(stderr,
+              "CYCLES_SSS_SKIP_VERIFY FAILED: object %d P %g %g %g D %g %g %g t %.9g hit t %.9g\n",
+              object,
+              double(ray.P.x),
+              double(ray.P.y),
+              double(ray.P.z),
+              double(ray.D.x),
+              double(ray.D.y),
+              double(ray.D.z),
+              double(ray.tmax),
+              double(ss_isect.hits[0].t));
+      fflush(stderr);
+      abort();
+    }
+    subsurface_skip_stats.verified.fetch_add(1, std::memory_order_relaxed);
+  }
+  ss_isect.num_hits = 0;
+  return true;
+}
+#endif
+
+CCL_NAMESPACE_END
diff --git a/intern/cycles/kernel/integrator/subsurface_skip_layout.h b/intern/cycles/kernel/integrator/subsurface_skip_layout.h
new file mode 100644
index 0000000..5d77616
--- /dev/null
+++ b/intern/cycles/kernel/integrator/subsurface_skip_layout.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Ours: layout of the subsurface skip grid region (host env CYCLES_SSS_SKIP_GRID, built by
+ * scene/sss_skip.cpp, read by kernel/integrator/subsurface_skip.h). The region is one table in
+ * the float lookup table; kernel_data.tables.pad2 holds its offset (0: no region). Integers are
+ * stored as float bit patterns. Offsets inside the region are relative to its start.
+ *
+ *   header   [MAGIC] 'SSSG', [NUM_OBJECTS], [FLAGS], [3] unused,
+ *            [OBJECTS + object] record offset of the object's grid, 0 = no grid (trace)
+ *   record   [LO] 3 floats, object-space grid origin; [INV_H] 3 floats, cells per unit length;
+ *            [N] cells per axis; [UNIT] distance per step; [DATA] offset of the cells
+ *   cells    N^3 u8 values q, x fastest, 4 per float (byte i & 3 of float i >> 2, little end
+ *            first): every point of the cell is at least q * UNIT from every triangle of the
+ *            object's geometry (object space). */
+
+#define SSS_SKIP_MAGIC 0x53535347u
+#define SSS_SKIP_HDR_MAGIC 0
+#define SSS_SKIP_HDR_NUM_OBJECTS 1
+#define SSS_SKIP_HDR_FLAGS 2
+#define SSS_SKIP_HDR_OBJECTS 4
+#define SSS_SKIP_REC_LO 0
+#define SSS_SKIP_REC_INV_H 3
+#define SSS_SKIP_REC_N 6
+#define SSS_SKIP_REC_UNIT 7
+#define SSS_SKIP_REC_DATA 8
+#define SSS_SKIP_REC_SIZE 12
+/* CPU kernel only: also trace every skipped step and abort on a hit (env CYCLES_SSS_SKIP_VERIFY). */
+#define SSS_SKIP_FLAG_VERIFY 1u
