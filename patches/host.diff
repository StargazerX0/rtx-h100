+/* Ours (NRC): kernels outside the DeviceKernel enum, looked up by name in the loaded module. */
+bool CUDADeviceQueue::has_named_kernel(const char *name)
+{
+  if (!cuda_device_->cuModule) {
+    return false;
+  }
+  auto it = named_functions_.find(name);
+  if (it != named_functions_.end()) {
+    return it->second != nullptr;
+  }
+  const CUDAContextScope scope(cuda_device_);
+  CUfunction function = nullptr;
+  if (cuModuleGetFunction(&function, cuda_device_->cuModule, name) != CUDA_SUCCESS) {
+    function = nullptr;
+  }
+  named_functions_[name] = function;
+  return function != nullptr;
+}
+
+bool CUDADeviceQueue::enqueue_named(const char *name,
+                                    const int work_size,
+                                    const DeviceKernelArguments &args)
+{
+  if (cuda_device_->have_error() || !has_named_kernel(name)) {
+    return false;
+  }
+  if (work_size <= 0) {
+    return true;
+  }
+  const CUDAContextScope scope(cuda_device_);
+  const int num_threads_per_block = 256;
+  const int num_blocks = divide_up(work_size, num_threads_per_block);
+  assert_success(cuLaunchKernel(named_functions_[name],
+                                num_blocks,
+                                1,
+                                1,
+                                num_threads_per_block,
+                                1,
+                                1,
+                                0,
+                                cuda_stream_,
+                                const_cast<void **>(args.values),
+                                nullptr),
+                 name);
+  return !(cuda_device_->have_error());
+}
